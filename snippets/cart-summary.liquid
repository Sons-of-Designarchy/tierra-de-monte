{%- comment -%}
  CartSummary — the totals of an order and the way to pay it: subtotal, discounts and the checkout button. One totals block for the cart page
  and the drawer. Ports PerfectlyRad CartSummary.

  {% render 'cart-summary', cart: cart, minimum: 500000, minimum_label: 'el mínimo de Bronce' %}

  Params
  - cart            the cart (required): total_price, item_count, total_discount, cart_level_discount_applications
  - show_checkout   false → totals only (default: true)
  - checkout_label  default: Finalizar compra
  - note            small print under the button (default: Envío e impuestos se calculan al pagar.)
  - minimum         minimum purchase in cents. Below it the button is held and says why
  - minimum_label   what the minimum is called (default: el mínimo)
  - maximum         maximum purchase in cents. Above it the button is held and says how much to remove
  - advisor         WhatsApp number (digits). With a maximum, above it the checkout button becomes «Hablar con un asesor» with the order written out
  - id              prefix for ids when the block appears twice on a page
  - class

  Checkout goes through the cart form (`name="checkout"`) so Shopify keeps the note and attributes.
  States: empty (button off), below the minimum or above the maximum (button off + reason), discounts, ready.
{%- endcomment -%}
{%- liquid
  assign cs_min = minimum | default: 0
  assign cs_missing = cs_min | minus: cart.total_price
  assign cs_blocked = false
  if cart.item_count > 0 and cs_missing > 0
    assign cs_blocked = true
  endif
  assign cs_max = maximum | default: 0
  assign cs_over = 0
  if cs_max > 0
    assign cs_over = cart.total_price | minus: cs_max
  endif
  if cart.item_count > 0 and cs_over > 0
    assign cs_blocked = true
  endif
  assign cs_off = false
  if cart.item_count == 0 or cs_blocked
    assign cs_off = true
  endif
  assign cs_label = checkout_label | default: 'Finalizar compra'
  assign cs_note = note | default: 'Envío e impuestos se calculan al pagar.'
  assign cs_goal = minimum_label | default: 'el mínimo'
-%}
<div class="pr-cart-summary{% if class != blank %} {{ class }}{% endif %}">
  <dl class="pr-cart-summary__totals" role="status">
    {%- if cart.total_discount > 0 -%}
      <div class="pr-cart-summary__row">
        {%- render 'typography', text: 'Descuentos', as: 'dt', variant: 'body-sm', color: 'secondary' -%}
        {%- capture cs_disc %}-{{ cart.total_discount | money }}{% endcapture -%}
        {%- render 'typography', text: cs_disc, as: 'dd', variant: 'body-sm', color: 'success', align: 'right' -%}
      </div>
    {%- endif -%}
    {%- for discount in cart.cart_level_discount_applications -%}
      <div class="pr-cart-summary__row">
        {%- capture cs_code %}Descuento · {{ discount.title | escape }}{% endcapture -%}
        {%- render 'typography', text: cs_code, as: 'dt', variant: 'body-sm', color: 'secondary' -%}
        {%- capture cs_amount %}-{{ discount.total_allocated_amount | money }}{% endcapture -%}
        {%- render 'typography', text: cs_amount, as: 'dd', variant: 'body-sm', color: 'success', align: 'right' -%}
      </div>
    {%- endfor -%}
    <div class="pr-cart-summary__row pr-cart-summary__row--total">
      {%- capture cs_sub %}Subtotal · {{ cart.item_count }} {% if cart.item_count == 1 %}producto{% else %}productos{% endif %}{% endcapture -%}
      {%- render 'typography', text: cs_sub, as: 'dt', variant: 'body', weight: 'semibold' -%}
      {%- capture cs_total %}{{ cart.total_price | money_without_trailing_zeros }}{% endcapture -%}
      {%- render 'typography', text: cs_total, as: 'dd', variant: 'h6', font: 'display' -%}
    </div>
  </dl>
  {%- if show_checkout != false -%}
    {%- if cs_over > 0 and advisor != blank -%}
      {%- capture cs_reason %}Los pedidos mayores a {{ cs_max | money_without_trailing_zeros }} los atiende un asesor. Mándanos tu pedido por WhatsApp y te contactamos.{% endcapture -%}
      {%- render 'typography', text: cs_reason, variant: 'body-sm', color: 'secondary', attrs: 'role="status"' -%}
    {%- elsif cs_over > 0 -%}
      {%- capture cs_reason %}El pedido máximo es de {{ cs_max | money_without_trailing_zeros }}. Quita {{ cs_over | money_without_trailing_zeros }} para finalizar tu compra.{% endcapture -%}
      {%- render 'typography', text: cs_reason, variant: 'body-sm', color: 'danger', attrs: 'role="status"' -%}
    {%- elsif cs_blocked -%}
      {%- capture cs_reason %}Agrega {{ cs_missing | money_without_trailing_zeros }} más para alcanzar {{ cs_goal }} y finalizar tu compra.{% endcapture -%}
      {%- render 'typography', text: cs_reason, variant: 'body-sm', color: 'secondary', attrs: 'role="status"' -%}
    {%- endif -%}
    {%- if cs_over > 0 and advisor != blank -%}
      {%- capture cs_text -%}
        Hola, quiero hacer un pedido de Aliado mayor a {{ cs_max | money_without_trailing_zeros }}:
        {%- for item in cart.items %}
• {{ item.quantity }} × {{ item.product.title }}{% unless item.variant.title == 'Default Title' %} · {{ item.variant.title }}{% endunless %}
        {%- endfor %}
Subtotal: {{ cart.total_price | money_without_trailing_zeros }}
      {%- endcapture -%}
      {%- capture cs_advisor_url %}https://wa.me/{{ advisor }}?text={{ cs_text | url_encode }}{% endcapture -%}
      {%- render 'button', label: 'Hablar con un asesor', href: cs_advisor_url, size: 'lg', class: 'pr-cart-summary__checkout', attrs: 'target="_blank" rel="noopener" data-track="pedido-asesor-whatsapp"' -%}
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="pr-cart-summary__form">
        {%- render 'button', label: cs_label, type: 'submit', name: 'checkout', size: 'lg', disabled: cs_off, class: 'pr-cart-summary__checkout' -%}
      </form>
    {%- endif -%}
    {%- render 'typography', text: cs_note, variant: 'xs', color: 'secondary' -%}
  {%- endif -%}
</div>
