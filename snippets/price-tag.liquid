{%- comment -%}
  PriceTag — the one way a price is written: regular, sale (with compare-at), "Desde", savings and unit price. Ports PerfectlyRad PriceTag.

  {% render 'price-tag', price: product.price, compare_at_price: product.compare_at_price, from: product.price_varies, size: 'md', show_savings: true %}
  {% render 'price-tag', product: product %}

  Params
  - product                 shortcut: reads price, compare_at_price and price_varies from a Shopify product (or card_product)
  - price                   cents (`variant.price`, `product.price`, `item.final_line_price`)
  - compare_at_price        cents. When it is above price the tag shows the sale
  - unit_price              cents per reference unit (`variant.unit_price`), with unit_price_measurement
  - unit_price_measurement  `variant.unit_price_measurement`
  - from                    true → "Desde" prefix (the product has variants with different prices)
  - show_savings            true → "-15%" beside a sale
  - savings_label           replaces the computed "-15%"
  - size                    sm | md | lg   (default: md → body-sm / body / h5 display)
  - show_zero               a price of 0 means "not published" and renders nothing, unless this is true
  - class

  States: regular, sale, from, with unit price.
{%- endcomment -%}
{%- liquid
  assign pt_price = price
  assign pt_compare = compare_at_price
  assign pt_from = from
  if product != blank
    if pt_price == nil
      assign pt_price = product.price
    endif
    if pt_compare == nil
      assign pt_compare = product.compare_at_price
    endif
    if from == nil
      assign pt_from = product.price_varies
    endif
  endif
  assign pt_size = size | default: 'md'
  assign pt_font = 'body'
  case pt_size
    when 'sm'
      assign pt_variant = 'body-sm'
      assign pt_sub = 'xs'
    when 'lg'
      assign pt_variant = 'h5'
      assign pt_font = 'display'
      assign pt_sub = 'body'
    else
      assign pt_variant = 'body'
      assign pt_sub = 'body-sm'
  endcase
  assign pt_sale = false
  assign pt_off = 0
  if pt_compare != blank and pt_compare > pt_price
    assign pt_sale = true
    assign pt_off = pt_compare | minus: pt_price | times: 100.0 | divided_by: pt_compare | round
  endif
  assign pt_show = true
  if pt_price == blank or pt_price == 0
    assign pt_show = false
  endif
  if show_zero
    assign pt_show = true
  endif
  assign pt_unit = ''
  if unit_price != blank and unit_price_measurement != blank
    if unit_price_measurement.reference_value == 1
      assign pt_unit = unit_price_measurement.reference_unit
    else
      assign pt_unit = unit_price_measurement.reference_value | append: ' ' | append: unit_price_measurement.reference_unit
    endif
  endif
-%}
{%- if pt_show -%}
  <div class="pr-price pr-price--{{ pt_size }}{% if class != blank %} {{ class }}{% endif %}">
    <div class="pr-price__row">
      {%- if pt_from -%}
        {%- render 'typography', text: 'Desde', as: 'span', variant: pt_sub, color: 'secondary' -%}
      {%- endif -%}
      {%- capture pt_now -%}<span class="visually-hidden">{% if pt_sale %}Precio de oferta{% else %}Precio{% endif %} </span>{{ pt_price | money_without_trailing_zeros }}{%- endcapture -%}
      {%- render 'typography', text: pt_now, as: 'span', variant: pt_variant, font: pt_font, weight: 'semibold' -%}
      {%- if pt_sale -%}
        {%- capture pt_was -%}<span class="visually-hidden">Precio regular </span>{{ pt_compare | money_without_trailing_zeros }}{%- endcapture -%}
        {%- render 'typography', text: pt_was, as: 's', variant: pt_sub, color: 'secondary' -%}
        {%- if show_savings -%}
          {%- if savings_label != blank -%}
            {%- render 'typography', text: savings_label, as: 'span', variant: pt_sub, weight: 'medium', color: 'success' -%}
          {%- elsif pt_off > 0 -%}
            {%- capture pt_pct -%}-{{ pt_off }}%{%- endcapture -%}
            {%- render 'typography', text: pt_pct, as: 'span', variant: pt_sub, weight: 'medium', color: 'success' -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- if pt_unit != blank -%}
      {%- capture pt_unit_text -%}{{ unit_price | money }} / {{ pt_unit }}{%- endcapture -%}
      {%- render 'typography', text: pt_unit_text, variant: 'xs', color: 'secondary' -%}
    {%- endif -%}
  </div>
{%- endif -%}
