{%- comment -%}
  VariantPicker — one product option (size, pack, format) as pills, swatches or a select. Ports PerfectlyRad VariantPicker.
  It only picks values; the <pr-buy-box> custom element (assets/pr-product.js) finds the variant and updates price and button.
  The one variant picker of the theme: it replaces Dawn's product-variant-picker, product-variant-options, swatch and swatch-input.

  {% render 'variant-picker', option: option, type: 'pills' %}
  {% for option in product.options_with_values %}{% render 'variant-picker', option: option, type: 'pills' %}{% endfor %}

  Params
  - option    one entry of `product.options_with_values` (name, position, values with .selected / .available / .swatch)
  - type      pills | swatches | select   (default: pills). Swatches fall back to a pill for values without a swatch
  - disabled  blocks it while the form is sending
  - error     message under the picker ("Elige una presentación")
  - class

  Values with no stock for the other chosen options stay pickable (so "Agotado" can show) but read struck through.
  States: default, selected, out of stock, disabled, focus-visible, error.
{%- endcomment -%}
{%- liquid
  assign vp_type = type | default: 'pills'
  assign vp_label_id = 'vp-' | append: option.position | append: '-' | append: option.name | handleize
  assign vp_selected = option.selected_value
-%}
{%- if option.values.size > 0 -%}
  {%- if vp_type == 'select' -%}
    {%- capture vp_options -%}
      {%- for value in option.values -%}
        <option value="{{ value | escape }}"{% if value.selected %} selected{% endif %}>{{ value }}{% unless value.available %} · Agotado{% endunless %}</option>
      {%- endfor -%}
    {%- endcapture -%}
    {%- capture vp_attrs -%}data-pr-option="{{ option.position }}"{%- endcapture -%}
    {%- render 'select', label: option.name, id: vp_label_id, options_html: vp_options, error: error, disabled: disabled, attrs: vp_attrs, class: class -%}
  {%- else -%}
    <div class="pr-variant{% if class != blank %} {{ class }}{% endif %}" data-pr-option="{{ option.position }}">
      <span class="pr-variant__label" id="{{ vp_label_id }}">
        {%- render 'typography', text: option.name, as: 'span', variant: 'label', weight: 'medium' -%}
        {%- capture vp_chosen %} · <span data-pr-selected-value>{{ vp_selected }}</span>{% endcapture -%}
        {%- render 'typography', text: vp_chosen, as: 'span', variant: 'label', color: 'secondary' -%}
      </span>
      <div class="pr-variant__values" role="group" aria-labelledby="{{ vp_label_id }}">
        {%- for value in option.values -%}
          {%- liquid
            assign vp_out = true
            if value.available
              assign vp_out = false
            endif
            assign vp_swatch = ''
            if vp_type == 'swatches' and value.swatch
              if value.swatch.image
                assign vp_img = value.swatch.image | image_url: width: 96
                assign vp_swatch = '--pr-swatch: url(' | append: vp_img | append: ')'
              elsif value.swatch.color
                assign vp_swatch = '--pr-swatch: rgb(' | append: value.swatch.color.rgb | append: ')'
              endif
            endif
            assign vp_name = value | escape
          -%}
          {%- capture vp_item_attrs -%}data-option-position="{{ option.position }}" data-value="{{ vp_name }}"{% if disabled %} disabled{% endif %}{%- endcapture -%}
          {%- if vp_swatch != blank -%}
            <button type="button" class="pr-swatch{% if value.selected %} is-selected{% endif %}{% if vp_out %} is-out{% endif %}" style="{{ vp_swatch }}" aria-pressed="{{ value.selected }}" aria-label="{{ vp_name }}{% if vp_out %} (agotado){% endif %}" title="{{ vp_name }}" {{ vp_item_attrs }}>
              {%- if value.selected -%}<span class="pr-swatch__check">{% render 'icon', name: 'check', size: 'xs' %}</span>{%- endif -%}
            </button>
          {%- else -%}
            {%- capture vp_chip_label -%}{{ value }}{% if vp_out %} (agotado){% endif %}{%- endcapture -%}
            {%- assign vp_chip_class = 'pr-variant__chip' -%}
            {%- if vp_out %}{% assign vp_chip_class = 'pr-variant__chip is-out' %}{% endif -%}
            {%- render 'chip', label: vp_chip_label, size: 'md', selected: value.selected, attrs: vp_item_attrs, class: vp_chip_class -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if error != blank -%}
        {%- render 'typography', text: error, variant: 'label', color: 'danger' -%}
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}
