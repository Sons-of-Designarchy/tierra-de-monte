{%- comment -%}
  Chip — filter chip, or with static a small pill that shows a value. One shape for both. Ports PerfectlyRad Chip.

  {% render 'chip', label: 'Orgánico', selected: false, icon: '', count: 12, disabled: false, size: 'sm', variant: 'outline', static: false, mono: false, href: '', class: '', attrs: '' %}

  Params
  - label     text
  - selected  pressed state for filters (aria-pressed)
  - icon      icon name
  - count     number shown after the label
  - disabled  true → aria-disabled
  - size      xs | sm | md   (default: sm → 28 / 36 / 44px; xs for values, sm filters, md touch-first)
  - variant   outline (1px border) | elevated (white, soft shadow, no border)   (default: outline)
  - static    true → not pressable, a label (span). Also automatic when there is no href, attrs and not selected
  - mono      monospace label, for codes and values
  - href      renders <a> (e.g. a facet link)
  - class, attrs   attrs carries data-/aria- hooks that make it a control (e.g. 'data-filter="x"')

  States: hover, selected, focus-visible, disabled.
{%- endcomment -%}
{%- liquid
  assign c_size = size | default: 'sm'
  assign c_variant = variant | default: 'outline'
  assign c_type = 'body-sm'
  if c_size == 'xs'
    assign c_type = 'xs'
  endif
  assign c_font = 'body'
  if mono
    assign c_font = 'mono'
  endif
  assign c_static = static
  if static == blank and href == blank and attrs == blank and selected != true
    assign c_static = true
  endif
  assign c_class = 'pr-chip pr-chip--' | append: c_size
  if c_static
    assign c_class = c_class | append: ' pr-chip--static'
  else
    assign c_class = c_class | append: ' pr-chip--' | append: c_variant
  endif
  if selected
    assign c_class = c_class | append: ' is-selected'
  endif
  if class != blank
    assign c_class = c_class | append: ' ' | append: class
  endif
  capture c_inner
    if icon != blank
      render 'icon', name: icon, size: 'sm'
    endif
    render 'typography', text: label, as: 'span', variant: c_type, weight: 'medium', font: c_font, color: 'inherit'
    if count != blank
      render 'typography', text: count, as: 'span', variant: 'xs', weight: 'medium', font: 'mono', color: 'inherit', class: 'pr-chip__count'
    endif
  endcapture
-%}
{%- if c_static -%}
  <span class="{{ c_class }}">{{ c_inner }}</span>
{%- elsif href != blank -%}
  <a href="{{ href }}" class="{{ c_class }}"{% if selected %} aria-current="true"{% endif %}{% if disabled %} aria-disabled="true" tabindex="-1"{% endif %}{% if attrs != blank %} {{ attrs }}{% endif %}>{{ c_inner }}</a>
{%- else -%}
  <button type="button" class="{{ c_class }}" aria-pressed="{{ selected | default: false }}"{% if disabled %} disabled aria-disabled="true"{% endif %}{% if attrs != blank %} {{ attrs }}{% endif %}>{{ c_inner }}</button>
{%- endif -%}
