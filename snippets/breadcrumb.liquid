{%- comment -%}
  Breadcrumb — where am I. Blog article, product sheet, anything two levels deep. Ports PerfectlyRad Breadcrumb.

  {% render 'breadcrumb', items: 'Inicio|/;Blog|/blogs/news;Artículo', label: 'Ruta', class: '' %}

  Params
  - items  path from root to the current page: 'Label|/url;Label|/url;Current'. Separate crumbs with ";" and label from url with "|".
           The last item renders as current, without a link
  - label  aria-label of the nav (default: Ruta)
  - class
{%- endcomment -%}
{%- assign bc_items = items | split: ';' -%}
<nav aria-label="{{ label | default: 'Ruta' | escape }}" class="pr-breadcrumb{% if class != blank %} {{ class }}{% endif %}">
  <ol class="pr-breadcrumb__list">
    {%- for it in bc_items -%}
      {%- assign bc_parts = it | split: '|' -%}
      {%- assign bc_last = forloop.last -%}
      <li class="pr-breadcrumb__item">
        {%- if bc_parts.size > 1 and bc_last == false -%}
          <a href="{{ bc_parts[1] }}" class="pr-breadcrumb__link">{% render 'typography', text: bc_parts[0], as: 'span', variant: 'body-sm', color: 'inherit' %}</a>
        {%- else -%}
          {%- if bc_last -%}
            {%- render 'typography', text: bc_parts[0], as: 'span', variant: 'body-sm', weight: 'medium', class: 'pr-breadcrumb__current', attrs: 'aria-current="page"' -%}
          {%- else -%}
            {%- render 'typography', text: bc_parts[0], as: 'span', variant: 'body-sm', weight: 'medium', class: 'pr-breadcrumb__current' -%}
          {%- endif -%}
        {%- endif -%}
      </li>
      {%- unless bc_last -%}<li class="pr-breadcrumb__sep" aria-hidden="true">{% render 'icon', name: 'chevron-right', size: 'sm' %}</li>{%- endunless -%}
    {%- endfor -%}
  </ol>
</nav>
