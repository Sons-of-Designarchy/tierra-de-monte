{%- comment -%}
  Radio — one choice out of a few, as a group with its label. Native radios: arrow keys move, space selects. Ports PerfectlyRad Radio.

  {% render 'radio', label: 'Entrega', name: 'delivery', options: 'home|A domicilio|En 2 a 4 días;pickup|Recoger', value: 'home', error: '', inline: false, hide_label: false, class: '' %}

  Params
  - label        accessible name of the group (a fieldset legend); rendered unless hide_label
  - name         required
  - options      'value|Label|Description;value|Label' (description optional). Prefix a value with "!" to disable it: '!x|Label'
  - value        selected value
  - error        message under the group; borders turn red
  - inline       true → side by side, stacked by default
  - hide_label, class

  States: hover, checked, focus-visible, error, disabled. 24px circle, 12px dot.
{%- endcomment -%}
{%- liquid
  assign ra_options = options | split: ';'
  assign ra_legend_class = ''
  if hide_label
    assign ra_legend_class = 'visually-hidden'
  endif
  assign ra_error_id = name | append: '-error'
-%}
<fieldset class="pr-radio{% if inline %} pr-radio--inline{% endif %}{% if error != blank %} has-error{% endif %}{% if class != blank %} {{ class }}{% endif %}"{% if error != blank %} aria-invalid="true" aria-describedby="{{ ra_error_id }}"{% endif %}>
  {%- render 'typography', text: label, as: 'legend', variant: 'label', weight: 'medium', class: ra_legend_class -%}
  <div class="pr-radio__items">
    {%- for o in ra_options -%}
      {%- assign ra_o = o | split: '|' -%}
      {%- assign ra_val = ra_o[0] -%}
      {%- assign ra_disabled = false -%}
      {%- if ra_val contains '!' -%}{%- assign ra_disabled = true -%}{%- assign ra_val = ra_val | remove: '!' -%}{%- endif -%}
      {%- assign ra_id = name | append: '-' | append: ra_val -%}
      {%- assign ra_color = 'primary' -%}
      {%- if ra_disabled -%}{%- assign ra_color = 'disabled' -%}{%- endif -%}
      <div class="pr-radio__item">
        <input type="radio" id="{{ ra_id }}" name="{{ name }}" value="{{ ra_val }}" class="pr-radio__input"{% if ra_val == value %} checked{% endif %}{% if ra_disabled %} disabled{% endif %}>
        <label for="{{ ra_id }}" class="pr-radio__label">
          {%- render 'typography', text: ra_o[1], as: 'span', variant: 'body-sm', color: ra_color -%}
          {%- if ra_o[2] != blank -%}{%- render 'typography', text: ra_o[2], as: 'span', variant: 'label', color: 'secondary' -%}{%- endif -%}
        </label>
      </div>
    {%- endfor -%}
  </div>
  {%- if error != blank -%}{%- render 'typography', text: error, variant: 'label', color: 'danger', id: ra_error_id -%}{%- endif -%}
</fieldset>
