{%- comment -%}
  QuantityStepper — minus, number, plus. Ports PerfectlyRad QuantityStepper. Behaviour: the <pr-quantity> custom element in assets/pr-cart.js
  (arrows and Home/End on the number, clamps to min/max, fires `change` when the value moves).

  {% render 'quantity-stepper', value: 1, min: 1, max: 12, name: 'quantity', label: 'Cantidad', size: 'md' %}

  Params
  - value     current quantity (default: 1)
  - min       1 on a product page; 0 in the cart, where going to 0 removes the line (default: 1)
  - max       stock left (`variant.inventory_quantity` when Shopify tracks it)
  - step      default 1
  - label     accessible name, also the input's label (default: Cantidad)
  - name      form field name ("quantity", or "updates[]")
  - id        input id (default: name)
  - form      id of the form the input belongs to
  - size      sm | md   (default: md → 36 / 44px)
  - disabled  blocks it: out of stock, or the form is sending
  - loading   a request is in flight: the number gives way to a spinner and the buttons wait
  - attrs     extra attributes on the input (data-line="..." for the cart)
  - class

  States: default, min/max reached, disabled, loading, focus-visible.
{%- endcomment -%}
{%- liquid
  assign qs_size = size | default: 'md'
  assign qs_value = value | default: 1
  assign qs_min = min
  if qs_min == nil
    assign qs_min = 1
  endif
  assign qs_step = step | default: 1
  assign qs_label = label | default: 'Cantidad'
  assign qs_id = id | default: name
  assign qs_btn = 'md'
  if qs_size == 'sm'
    assign qs_btn = 'sm'
  endif
  assign qs_blocked = false
  if disabled or loading
    assign qs_blocked = true
  endif
-%}
<pr-quantity class="pr-qty pr-qty--{{ qs_size }}{% if class != blank %} {{ class }}{% endif %}" role="group" aria-label="{{ qs_label | escape }}"{% if loading %} aria-busy="true"{% endif %}>
  {%- capture qs_minus_attrs -%}data-qty="minus"{%- endcapture -%}
  {%- capture qs_plus_attrs -%}data-qty="plus"{%- endcapture -%}
  {%- assign qs_at_min = false -%}
  {%- if qs_value <= qs_min %}{% assign qs_at_min = true %}{% endif -%}
  {%- assign qs_at_max = false -%}
  {%- if max != blank and qs_value >= max %}{% assign qs_at_max = true %}{% endif -%}
  {%- assign qs_minus_off = false -%}
  {%- if qs_blocked or qs_at_min %}{% assign qs_minus_off = true %}{% endif -%}
  {%- assign qs_plus_off = false -%}
  {%- if qs_blocked or qs_at_max %}{% assign qs_plus_off = true %}{% endif -%}
  {%- capture qs_minus_label -%}Quitar uno · {{ qs_label }}{%- endcapture -%}
  {%- capture qs_plus_label -%}Agregar uno · {{ qs_label }}{%- endcapture -%}
  {%- render 'icon-button', icon: 'minus', label: qs_minus_label, size: qs_btn, disabled: qs_minus_off, attrs: qs_minus_attrs -%}
  <input
    class="pr-qty__input"
    type="number"
    inputmode="numeric"
    id="{{ qs_id }}"
    {% if name != blank %}name="{{ name }}"{% endif %}
    {% if form != blank %}form="{{ form }}"{% endif %}
    value="{{ qs_value }}"
    min="{{ qs_min }}"
    {% if max != blank %}max="{{ max }}"{% endif %}
    step="{{ qs_step }}"
    aria-label="{{ qs_label | escape }}"
    {% if qs_blocked %}disabled{% endif %}
    {% if attrs != blank %}{{ attrs }}{% endif %}
  >
  <span class="pr-qty__spinner">{% render 'spinner', size: 'sm', label: 'Actualizando cantidad' %}</span>
  {%- render 'icon-button', icon: 'plus', label: qs_plus_label, size: qs_btn, disabled: qs_plus_off, attrs: qs_plus_attrs -%}
</pr-quantity>
