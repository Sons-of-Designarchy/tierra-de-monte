{%- comment -%}
  Checkbox — checkbox with its label. Consent, newsletter opt-in, multi-select filters in forms. Ports PerfectlyRad Checkbox.

  {% render 'checkbox', label: 'Acepto', description: '', name: 'terms', value: 'yes', checked: false, disabled: false, error: '', id: '', attrs: '', class: '' %}

  Params
  - label        required (typography body-sm)
  - description  second line (label size, secondary)
  - name, value, id (default: name), attrs, class
  - checked, disabled
  - error        message under it, in the danger colour; border turns red (aria-invalid)

  States: hover, checked, focus-visible, error, disabled. 24px box, 1px border.
{%- endcomment -%}
{%- liquid
  assign cb_id = id | default: name
  assign cb_label_color = 'primary'
  if disabled
    assign cb_label_color = 'disabled'
  endif
  assign cb_error_id = cb_id | append: '-error'
-%}
<div class="pr-check{% if class != blank %} {{ class }}{% endif %}">
  <div class="pr-check__row">
    <input type="checkbox" id="{{ cb_id }}" class="pr-check__input"{% if name != blank %} name="{{ name }}"{% endif %}{% if value != blank %} value="{{ value }}"{% endif %}{% if checked %} checked{% endif %}{% if disabled %} disabled{% endif %}{% if error != blank %} aria-invalid="true" aria-describedby="{{ cb_error_id }}"{% endif %}{% if attrs != blank %} {{ attrs }}{% endif %}>
    <label for="{{ cb_id }}" class="pr-check__label">
      {%- render 'typography', text: label, as: 'span', variant: 'body-sm', color: cb_label_color -%}
      {%- if description != blank -%}{%- render 'typography', text: description, as: 'span', variant: 'label', color: 'secondary' -%}{%- endif -%}
    </label>
  </div>
  {%- if error != blank -%}{%- render 'typography', text: error, variant: 'label', color: 'danger', id: cb_error_id -%}{%- endif -%}
</div>
