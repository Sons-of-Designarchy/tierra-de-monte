{%- comment -%}
  ProductCard — the one product card, for every place a product shows up: grids (vertical), cart lines, lists and search (horizontal).
  Photo (second photo on hover), badges nuevo / oferta / agotado, vendor, name, price (price-tag) and an optional quick add.
  Line-specific controls come in through `actions`, `quantity`, `loading` and `error`: there is no second card. Ports PerfectlyRad ProductCard.
  It is the Dawn card-product replacement: white card (card atom), no border, no shadow.

  {% render 'product-card', product: product, layout: 'vertical', show_quick_add: true, image_ratio: '4/5' %}

  Params
  - product        the Shopify product (required). Reads title, url, vendor, price, compare_at_price, price_varies, available, tags, media, variants
  - layout         vertical (photo on top, grids) | horizontal (thumbnail left, info right, flat: cart, lists)   (default: vertical)
  - href           where the card goes. Default: product.url. Pass '' for a card that is not a link (the parent brings its action)
  - tag            div | article | li   (default: li)
  - badges         extra labels over the photo after the automatic ones: 'Solo MX|Nuevo'. Vertical only
  - variant_title  "Aloe · 250 ml". In horizontal it goes on its own line under the name
  - savings_label  replaces the computed "-15%"
  - show_vendor    true → the vendor above the name (default: false)
  - show_excerpt   true → two lines of the product description under the name
  - hover_image    true → the second photo on hover (default: true). Vertical only
  - image_ratio    4/5 | 1/1 | 3/4 | 4/3   (default: 4/5)
  - image_fit      cover | contain   (default: cover)
  - quantity       units in a cart or an order: puts the count on the photo. Horizontal only
  - show_quick_add true → button at the bottom: add to cart (opens the cart drawer), or "Elegir opciones" with several variants.
                   Only works while the theme setting "Mostrar compra en el sitio" is on; otherwise the card shows no price and no buy button
                   and the whole card goes to the product page. A card that gets its own `price` (Aliados order cards) always shows it.
  - actions        html controls row under the info, above the card link (a quantity stepper, a remove button)
  - loading        this card is being updated: aria-busy
  - error          why the card can't change: "Solo quedan 3 en existencia"
  - content        html under the price, inside the card
  Overrides for rows that are not a product (a cart line): title, vendor, price, compare_at_price, image, available, from.
  - class

  States: default, hover (second photo), sold out, on sale, quick add (idle, loading, added, error), focus-visible (stretched link).
{%- endcomment -%}
{%- liquid
  assign pc_layout = layout | default: 'vertical'
  assign pc_horizontal = false
  if pc_layout == 'horizontal'
    assign pc_horizontal = true
  endif
  assign pc_tag = tag | default: 'li'
  assign pc_title = title | default: product.title
  assign pc_vendor = vendor | default: product.vendor
  assign pc_buy = settings.show_commerce
  assign pc_show_price = pc_buy
  if price != nil
    assign pc_show_price = true
  endif
  assign pc_price = price
  if pc_price == nil
    assign pc_price = product.price
  endif
  assign pc_compare = compare_at_price
  if pc_compare == nil
    assign pc_compare = product.compare_at_price
  endif
  assign pc_from = from
  if pc_from == nil
    assign pc_from = product.price_varies
  endif
  assign pc_available = available
  if pc_available == nil
    assign pc_available = product.available
  endif
  assign pc_href = href
  if pc_href == nil
    assign pc_href = product.url
  endif
  assign pc_image = image | default: product.featured_media.preview_image
  assign pc_second = nil
  if pc_horizontal == false and hover_image != false and product.media.size > 1
    assign pc_second = product.media[1].preview_image
  endif
  assign pc_ratio = image_ratio | default: '4/5'
  assign pc_sale = false
  if pc_show_price and pc_compare != blank and pc_compare > pc_price
    assign pc_sale = true
  endif
  assign pc_badges = ''
  if pc_horizontal == false
    if pc_available == false
      assign pc_badges = 'Agotado'
    elsif pc_sale
      assign pc_badges = 'Oferta'
    endif
    if product.tags contains 'nuevo' or product.tags contains 'Nuevo'
      assign pc_badges = pc_badges | append: '|Nuevo'
    endif
    if badges != blank
      assign pc_badges = pc_badges | append: '|' | append: badges
    endif
  endif
  assign pc_badge_list = pc_badges | split: '|'
  assign pc_class = 'pr-product-card pr-product-card--' | append: pc_layout
  if pc_available == false
    assign pc_class = pc_class | append: ' is-sold-out'
  endif
  if class != blank
    assign pc_class = pc_class | append: ' ' | append: class
  endif
  assign pc_attrs = ''
  if loading
    assign pc_attrs = 'aria-busy="true"'
  endif
-%}
{%- capture pc_photo -%}
  {%- if pc_image != blank or pc_horizontal -%}
    <div class="pr-product-card__photo">
      {%- render 'image', image: pc_image, alt: pc_title, ratio: pc_ratio, fit: image_fit, radius: 'none', sizes: '(min-width: 750px) 25vw, 50vw' -%}
      {%- if pc_second != blank -%}
        {%- render 'image', image: pc_second, alt: '', ratio: pc_ratio, fit: image_fit, radius: 'none', sizes: '(min-width: 750px) 25vw, 50vw', class: 'pr-product-card__alt' -%}
      {%- endif -%}
      {%- if pc_badge_list.size > 0 -%}
        <div class="pr-product-card__badges">
          {%- for b in pc_badge_list -%}
            {%- if b != blank -%}
              {%- assign pc_badge_class = 'pr-product-card__badge' -%}
              {%- if b == 'Agotado' %}{% assign pc_badge_class = 'pr-product-card__badge is-out' %}{% endif -%}
              {%- render 'chip', label: b, size: 'xs', static: true, class: pc_badge_class -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if pc_horizontal and quantity != blank -%}
        {%- render 'chip', label: quantity, size: 'xs', static: true, class: 'pr-product-card__count' -%}
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}
{%- capture pc_name -%}
  {%- if pc_href != blank -%}<a href="{{ pc_href }}" class="pr-product-card__link">{{ pc_title | escape }}</a>{%- else -%}{{ pc_title | escape }}{%- endif -%}
  {%- if variant_title != blank and pc_horizontal == false %}<span class="pr-color--secondary"> · {{ variant_title | escape }}</span>{% endif -%}
{%- endcapture -%}
{%- capture pc_info -%}
  {%- if pc_horizontal -%}
    <div class="pr-product-card__row">
      <div class="pr-product-card__text">
        {%- if show_vendor and pc_vendor != blank -%}{%- render 'typography', text: pc_vendor, variant: 'xs', color: 'secondary' -%}{%- endif -%}
        {%- render 'typography', text: pc_name, as: 'h3', variant: 'body-sm', weight: 'semibold' -%}
        {%- if variant_title != blank -%}{%- render 'typography', text: variant_title, variant: 'xs', color: 'secondary' -%}{%- endif -%}
      </div>
      {%- if pc_show_price -%}
        {%- render 'price-tag', price: pc_price, compare_at_price: pc_compare, from: pc_from, size: 'sm', class: 'pr-product-card__price' -%}
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="pr-product-card__text">
      {%- if show_vendor and pc_vendor != blank -%}{%- render 'typography', text: pc_vendor, variant: 'body', weight: 'semibold' -%}{%- endif -%}
      {%- render 'typography', text: pc_name, as: 'h3', variant: 'body' -%}
      {%- if show_excerpt and product.description != blank -%}
        {%- assign pc_excerpt = product.description | strip_html | strip | truncatewords: 18 -%}
        {%- render 'typography', text: pc_excerpt, variant: 'body-sm', color: 'secondary', class: 'pr-product-card__excerpt' -%}
      {%- endif -%}
      {%- if pc_show_price -%}
        {%- render 'price-tag', price: pc_price, compare_at_price: pc_compare, from: pc_from, size: 'md', show_savings: true, savings_label: savings_label -%}
      {%- endif -%}
    </div>
  {%- endif -%}
  {%- if content != blank -%}{{ content }}{%- endif -%}
  {%- if actions != blank -%}<div class="pr-product-card__actions">{{ actions }}</div>{%- endif -%}
  {%- if error != blank -%}{%- render 'typography', text: error, variant: 'label', color: 'danger', attrs: 'role="alert"' -%}{%- endif -%}
  {%- if show_quick_add and pc_buy -%}
    <div class="pr-product-card__quick">
      {%- if pc_available == false -%}
        {%- render 'button', label: 'Agotado', variant: 'outline', size: 'sm', disabled: true, class: 'pr-product-card__btn' -%}
      {%- elsif product.variants.size > 1 -%}
        {%- render 'button', label: 'Elegir opciones', variant: 'outline', size: 'sm', href: product.url, class: 'pr-product-card__btn' -%}
      {%- else -%}
        {%- capture pc_add_attrs -%}data-quick-add aria-label="Agregar {{ pc_title | escape }} al carrito"{%- endcapture -%}
        <pr-quick-add data-variant-id="{{ product.selected_or_first_available_variant.id }}">
          {%- render 'button', label: 'Agregar al carrito', variant: 'secondary', size: 'sm', attrs: pc_add_attrs, class: 'pr-product-card__btn' -%}
          <template data-spinner>{% render 'spinner', size: 'sm', label: 'Agregando' %}</template>
          <template data-added>{% render 'icon', name: 'check', size: 'sm' %}</template>
          {%- render 'typography', text: 'No se pudo agregar. Intenta de nuevo.', variant: 'label', color: 'danger', attrs: 'role="alert" hidden data-quick-error' -%}
        </pr-quick-add>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}
{%- if pc_horizontal -%}
  {%- capture pc_body -%}<div class="pr-product-card__line">{{ pc_photo }}<div class="pr-product-card__info">{{ pc_info }}</div></div>{%- endcapture -%}
  {%- render 'card', tag: pc_tag, content: pc_body, padding: 'none', class: pc_class, attrs: pc_attrs -%}
{%- else -%}
  {%- capture pc_body -%}<div class="pr-product-card__info">{{ pc_info }}</div>{%- endcapture -%}
  {%- render 'card', tag: pc_tag, media: pc_photo, content: pc_body, padding: 'md', class: pc_class, attrs: pc_attrs -%}
{%- endif -%}
