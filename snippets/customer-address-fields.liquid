{%- comment -%}
  Customer address fields: the fields of the "add" and "edit" address forms (same names and ids as Dawn so customer.js and Shopify.CountryProvinceSelector keep working).

  {% render 'customer-address-fields', form: form, suffix: 'New', default_id: 'address_default_address_new' %}
  {% render 'customer-address-fields', form: form, suffix: '_123', default_id: 'address_default_address_123', form_id: 123 %}

  Params
  - form        the customer_address form object
  - suffix      appended to every id: 'New' for the new address form, '_<id>' for an existing address
  - default_id  id Shopify gives the "set as default" checkbox
  - form_id     only on edit forms: enables data-address-country-select
{%- endcomment -%}
{%- assign caf_first = 'customer.addresses.first_name' | t -%}
{%- assign caf_last = 'customer.addresses.last_name' | t -%}
{%- assign caf_company = 'customer.addresses.company' | t -%}
{%- assign caf_address1 = 'customer.addresses.address1' | t -%}
{%- assign caf_address2 = 'customer.addresses.address2' | t -%}
{%- assign caf_city = 'customer.addresses.city' | t -%}
{%- assign caf_country = 'customer.addresses.country' | t -%}
{%- assign caf_province = 'customer.addresses.province' | t -%}
{%- assign caf_zip = 'customer.addresses.zip' | t -%}
{%- assign caf_phone = 'customer.addresses.phone' | t -%}
{%- assign caf_default = 'customer.addresses.set_default' | t -%}
{%- capture caf_country_attrs -%}data-default="{{ form.country }}" autocomplete="country"{% if form_id != blank %} data-address-country-select data-form-id="{{ form_id }}"{% endif %}{%- endcapture -%}
{%- capture caf_province_attrs -%}data-default="{{ form.province }}" autocomplete="address-level1"{%- endcapture -%}
{%- assign caf_id_first = 'AddressFirstName' | append: suffix -%}
{%- assign caf_id_last = 'AddressLastName' | append: suffix -%}
{%- assign caf_id_company = 'AddressCompany' | append: suffix -%}
{%- assign caf_id_address1 = 'AddressAddress1' | append: suffix -%}
{%- assign caf_id_address2 = 'AddressAddress2' | append: suffix -%}
{%- assign caf_id_city = 'AddressCity' | append: suffix -%}
{%- assign caf_id_country = 'AddressCountry' | append: suffix -%}
{%- assign caf_id_province = 'AddressProvince' | append: suffix -%}
{%- assign caf_id_province_container = 'AddressProvinceContainer' | append: suffix -%}
{%- assign caf_id_zip = 'AddressZip' | append: suffix -%}
{%- assign caf_id_phone = 'AddressPhone' | append: suffix -%}
<div class="customer__address-grid">
  {% render 'input', id: caf_id_first, name: 'address[first_name]', label: caf_first, value: form.first_name, autocomplete: 'given-name' %}
  {% render 'input', id: caf_id_last, name: 'address[last_name]', label: caf_last, value: form.last_name, autocomplete: 'family-name' %}
  {% render 'input', id: caf_id_company, name: 'address[company]', label: caf_company, value: form.company, autocomplete: 'organization', class: 'customer__span' %}
  {% render 'input', id: caf_id_address1, name: 'address[address1]', label: caf_address1, value: form.address1, autocomplete: 'address-line1', class: 'customer__span' %}
  {% render 'input', id: caf_id_address2, name: 'address[address2]', label: caf_address2, value: form.address2, autocomplete: 'address-line2', class: 'customer__span' %}
  {% render 'input', id: caf_id_city, name: 'address[city]', label: caf_city, value: form.city, autocomplete: 'address-level2' %}
  {% render 'select', id: caf_id_country, name: 'address[country]', label: caf_country, options_html: all_country_option_tags, attrs: caf_country_attrs %}
  {%- comment -%} Shopify.CountryProvinceSelector shows and hides this container with its own inline style {%- endcomment -%}
  <div id="{{ caf_id_province_container }}" style="display: none">
    {% render 'select', id: caf_id_province, name: 'address[province]', label: caf_province, attrs: caf_province_attrs %}
  </div>
  {% render 'input', id: caf_id_zip, name: 'address[zip]', label: caf_zip, value: form.zip, autocomplete: 'postal-code', attrs: 'autocapitalize="characters"' %}
  {% render 'input', id: caf_id_phone, name: 'address[phone]', type: 'tel', label: caf_phone, value: form.phone, autocomplete: 'tel' %}
  <div class="customer__span customer__check">
    {{ form.set_as_default_checkbox }}
    {% render 'typography', text: caf_default, as: 'label', variant: 'body-sm', for_id: default_id %}
  </div>
</div>
