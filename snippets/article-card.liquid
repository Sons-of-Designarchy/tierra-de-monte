{%- comment -%}
  Article card: a blog post as a card atom (image, title, excerpt; the whole card is the link).
  Used by main-blog, featured-blog and the article results of main-search.

  {% render 'article-card', article: article, show_image: true, show_excerpt: true, show_badge: false, media_height: 'medium', lazy_load: true %}

  Params
  - article        required
  - show_image     show the featured image (default: false when blank)
  - show_excerpt   excerpt under the title
  - show_badge     "Blog" badge over the image (search results)
  - media_height   adapt | small | medium | large. adapt keeps the image ratio, the rest use a fixed 4/3
  - lazy_load      false → eager image
  show_date / show_author are accepted but the card does not print them (dates were hidden by the old CSS).
{%- endcomment -%}
{%- if article and article != empty -%}
  {%- liquid
    assign ac_image = nil
    if show_image and article.image
      assign ac_image = article.image
    endif
    assign ac_ratio = '4/3'
    if media_height == 'adapt'
      assign ac_ratio = 'auto'
    endif
    assign ac_excerpt = ''
    if show_excerpt
      if article.excerpt.size > 0
        assign ac_excerpt = article.excerpt | strip_html | truncatewords: 30
      elsif article.content.size > 0
        assign ac_excerpt = article.content | strip_html | truncatewords: 30
      endif
    endif
    assign ac_badge = ''
    if show_badge
      assign ac_badge = 'blogs.article.blog' | t
    endif
    assign ac_title = article.title | truncate: 50 | escape
  -%}
  {%- render 'card',
    tag: 'article',
    href: article.url,
    title: ac_title,
    title_as: 'h3',
    description: ac_excerpt,
    image: ac_image,
    image_alt: article.image.alt,
    image_ratio: ac_ratio,
    badge: ac_badge,
    padding: 'md',
    class: 'article-card'
  -%}
{%- endif -%}
