{%- comment -%}
  ProductExtras — what a product adds under its description: datasheet buttons, three benefits with their own icons and the ingredients list.
  Reads product.metafields.custom.{hoja_de_seguridad, ficha_tecnica, beneficio_1..3, ingredientes}. Icons: icon-prod-1..3.svg (benefits), icon-prod-4.svg (ingredients) in Files.

  {% render 'product-extras' %}
{%- endcomment -%}
{%- liquid
  assign pe_hoja = product.metafields.custom.hoja_de_seguridad
  assign pe_ficha = product.metafields.custom.ficha_tecnica
  assign pe_ficha_url = pe_ficha | file_url
  assign pe_hoja_url = pe_hoja | file_url
  assign pe_benefits = ''
  for i in (1..3)
    assign pe_key = 'beneficio_' | append: i
    assign pe_val = product.metafields.custom[pe_key]
    if pe_val != blank
      if pe_benefits != blank
        assign pe_benefits = pe_benefits | append: '<!--pr-->'
      endif
      assign pe_benefits = pe_benefits | append: pe_val
    endif
  endfor
  assign pe_ingredients = ''
  if product.metafields.custom.ingredientes != blank
    assign pe_lis = product.metafields.custom.ingredientes | metafield_tag | split: '<li>'
    for pe_li in pe_lis offset: 1
      assign pe_item = pe_li | split: '</li>' | first | strip_html | strip
      unless pe_item == '' or pe_item contains '{'
        if pe_ingredients != blank
          assign pe_ingredients = pe_ingredients | append: '<!--pr-->'
        endif
        assign pe_ingredients = pe_ingredients | append: pe_item
      endunless
    endfor
  endif
-%}
{%- if pe_hoja != blank or pe_ficha != blank -%}
  <div class="pr-product__docs">
    {%- if pe_ficha != blank -%}
      {%- render 'button', label: 'Ficha técnica', variant: 'outline', size: 'lg', href: pe_ficha_url, attrs: 'target="_blank" rel="noopener"' -%}
    {%- endif -%}
    {%- if pe_hoja != blank -%}
      {%- render 'button', label: 'Hoja de seguridad', variant: 'outline', size: 'lg', href: pe_hoja_url, attrs: 'target="_blank" rel="noopener"' -%}
    {%- endif -%}
  </div>
{%- endif -%}
{%- if pe_benefits != blank -%}
  {%- render 'icon-list', items: pe_benefits, icons: 'icon-prod-1.svg|icon-prod-2.svg|icon-prod-3.svg' -%}
{%- endif -%}
{%- if pe_ingredients != blank -%}
  <div class="pr-product__group">
    {%- render 'typography', text: 'Ingredientes:', as: 'h2', variant: 'h5', weight: 'bold' -%}
    {%- render 'icon-list', items: pe_ingredients, icons: 'icon-prod-4.svg' -%}
  </div>
{%- endif -%}
