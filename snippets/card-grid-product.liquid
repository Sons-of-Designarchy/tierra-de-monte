{%- comment -%}
  CardGridProduct — the one product grid. A grid of product-cards with Shopify's storefront filtering and sort, an availability switch,
  a loading state and an empty state. Ports PerfectlyRad CardGridProduct. There is no other grid: collection pages, search, featured
  collections, tabs and related products all render this snippet (the collection page through sections/card-grid-product.liquid).
  Replaces Dawn's facets, price-facet and the collection grid markup.

  {% paginate collection.products by 16 %}
    {% render 'card-grid-product', products: collection.products, results: collection, paginate: paginate, columns: 4, show_filters: true, sort_options: true, show_quick_add: true, section_id: section.id %}
  {% endpaginate %}
  {% render 'card-grid-product', products: collection.products, columns: 4, show_quick_add: true %}

  Params
  - products         the products to list (required). Search results may also hold articles (article-card) and pages (card)
  - results          `collection` or `search`: enables filters, sort and the count (their `filters`, `sort_options`, `sort_by`)
  - paginate         the `paginate` object, to show the page links under the grid
  - limit            show only the first N products (default: all)
  - section_id       id of the section that holds the grid, so filtering can re-render it (section rendering)
  - columns          2 | 3 | 4 products per row from tablet up; phones always show two   (default: 4)
  - show_filters     true → filter groups from `results.filters` (Search & Discovery) in a disclosure under the bar
  - show_availability true → the "Solo disponibles" switch (Shopify's availability filter)
  - sort_options     true → the "Ordenar por" select from `results.sort_options`
  - search_terms     `search.terms`: carried through the filter form on the search page
  - Card options passed to product-card: show_vendor, show_quick_add, show_excerpt, image_ratio, image_fit
  - empty_title, empty_text   empty state copy
  - class

  Behaviour: <pr-product-grid> (assets/pr-grid.js) submits the form on change, fetches the section and swaps the results; the URL keeps the filters.
  States: default, filtering (grid dims + spinner), empty (button clears the filters).
{%- endcomment -%}
{%- liquid
  assign gp_cols = columns | default: 4
  assign gp_limit = limit | default: 250
  assign gp_has_bar = false
  if results != blank
    if show_filters or sort_options or show_availability
      assign gp_has_bar = true
    endif
  endif
  assign gp_active = 0
  assign gp_clear_url = results.url
  assign gp_form_action = results.url
  if search_terms != blank
    assign gp_form_action = routes.search_url
    assign gp_clear_url = routes.search_url | append: '?q=' | append: search_terms | url_encode
  endif
  assign gp_sort_by = results.sort_by | default: results.default_sort_by
  assign gp_availability = nil
  for filter in results.filters
    if filter.param_name == 'filter.v.availability'
      assign gp_availability = filter
    endif
    assign gp_active = gp_active | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != nil
        assign gp_active = gp_active | plus: 1
      elsif filter.max_value.value != nil
        assign gp_active = gp_active | plus: 1
      endif
    endif
  endfor
  assign gp_empty_title = empty_title | default: 'Ningún producto con estos filtros'
  assign gp_empty_text = empty_text | default: 'Quita algún filtro para ver más productos.'
  assign gp_toggle_label = 'Filtros'
  if gp_active > 0
    assign gp_toggle_label = gp_toggle_label | append: ' (' | append: gp_active | append: ')'
  endif
  assign gp_sort_id = 'PrSort-' | append: section_id
  assign gp_stock_id = 'PrAvailability-' | append: section_id
  assign gp_panel_id = 'PrFilters-' | append: section_id
-%}
<pr-product-grid class="pr-grid{% if class != blank %} {{ class }}{% endif %}"{% if section_id != blank %} data-section-id="{{ section_id }}"{% endif %}>
  {%- if gp_has_bar -%}
    <form class="pr-grid__form" action="{{ gp_form_action }}" method="get" data-pr-filters>
      {%- if search_terms != blank -%}
        <input type="hidden" name="q" value="{{ search_terms | escape }}">
        <input type="hidden" name="options[prefix]" value="last">
      {%- endif -%}
      <div class="pr-grid__bar">
        <div class="pr-grid__bar-start">
          {%- if show_filters and results.filters.size > 0 -%}
            {%- capture gp_toggle_attrs -%}aria-expanded="false" aria-controls="{{ gp_panel_id }}" data-pr-toggle{%- endcapture -%}
            {%- render 'button', label: gp_toggle_label, variant: 'outline', size: 'sm', icon: 'chevron-down', icon_position: 'end', attrs: gp_toggle_attrs -%}
          {%- endif -%}
          {%- if paginate != blank -%}
            {%- capture gp_count %}{{ paginate.items }} {% if paginate.items == 1 %}producto{% else %}productos{% endif %}{% endcapture -%}
            {%- render 'typography', text: gp_count, variant: 'body-sm', color: 'secondary', attrs: 'aria-live="polite" data-pr-count' -%}
          {%- endif -%}
          {%- if show_availability and gp_availability != blank -%}
            {%- assign gp_in_stock = gp_availability.values | where: 'value', '1' | first -%}
            {%- if gp_in_stock != blank -%}
              {%- render 'switch', label: 'Solo disponibles', name: gp_in_stock.param_name, id: gp_stock_id, checked: gp_in_stock.active, attrs: 'value="1"' -%}
            {%- endif -%}
          {%- endif -%}
        </div>
        {%- if sort_options and results.sort_options.size > 0 -%}
          <div class="pr-grid__bar-end">
            {%- capture gp_sort -%}
              {%- for option in results.sort_options -%}
                <option value="{{ option.value | escape }}"{% if option.value == gp_sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            {%- endcapture -%}
            {%- render 'typography', text: 'Ordenar por:', as: 'span', variant: 'body-sm', color: 'secondary', attrs: 'aria-hidden="true"' -%}
            {%- render 'select', label: 'Ordenar por', hide_label: true, name: 'sort_by', id: gp_sort_id, options_html: gp_sort, size: 'sm', class: 'pr-grid__sort' -%}
          </div>
        {%- endif -%}
      </div>
      {%- if show_filters and results.filters.size > 0 -%}
        <div class="pr-grid__panel" id="{{ gp_panel_id }}" hidden>
          {%- for filter in results.filters -%}
            {%- unless filter.param_name == 'filter.v.availability' and show_availability -%}
              <fieldset class="pr-grid__group">
                {%- render 'typography', text: filter.label, as: 'legend', variant: 'label', weight: 'semibold', color: 'secondary' -%}
                {%- case filter.type -%}
                  {%- when 'price_range' -%}
                    {%- assign gp_max = filter.range_max | money_without_currency | replace: ',', '' -%}
                    <div class="pr-grid__range">
                      {%- assign gp_min_value = '' -%}
                      {%- if filter.min_value.value != nil %}{% assign gp_min_value = filter.min_value.value | money_without_currency | replace: ',', '' %}{% endif -%}
                      {%- assign gp_max_value = '' -%}
                      {%- if filter.max_value.value != nil %}{% assign gp_max_value = filter.max_value.value | money_without_currency | replace: ',', '' %}{% endif -%}
                      {%- assign gp_min_id = 'PrPriceMin-' | append: section_id -%}
                      {%- assign gp_max_id = 'PrPriceMax-' | append: section_id -%}
                      {%- render 'input', label: 'Desde', name: filter.min_value.param_name, id: gp_min_id, type: 'number', value: gp_min_value, placeholder: '0', inputmode: 'decimal', attrs: 'min="0"' -%}
                      {%- render 'input', label: 'Hasta', name: filter.max_value.param_name, id: gp_max_id, type: 'number', value: gp_max_value, placeholder: gp_max, inputmode: 'decimal', attrs: 'min="0"' -%}
                    </div>
                  {%- when 'boolean' -%}
                    {%- for value in filter.values -%}
                      {%- capture gp_value_id %}PrFilter-{{ section_id }}-{{ filter.param_name | handleize }}-{{ forloop.index }}{% endcapture -%}
                      {%- render 'switch', label: value.label, name: value.param_name, id: gp_value_id, checked: value.active, attrs: 'value="true"' -%}
                    {%- endfor -%}
                  {%- else -%}
                    <div class="pr-grid__values">
                      {%- for value in filter.values -%}
                        {%- liquid
                          assign gp_off = false
                          if value.count == 0 and value.active == false
                            assign gp_off = true
                          endif
                        -%}
                        {%- capture gp_value_id %}PrFilter-{{ section_id }}-{{ filter.param_name | handleize }}-{{ forloop.index }}{% endcapture -%}
                        {%- render 'checkbox', label: value.label, description: value.count, name: value.param_name, value: value.value, id: gp_value_id, checked: value.active, disabled: gp_off -%}
                      {%- endfor -%}
                    </div>
                {%- endcase -%}
              </fieldset>
            {%- endunless -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </form>
  {%- endif -%}

  <div class="pr-grid__results" data-pr-results>
    {%- if gp_active > 0 -%}
      <div class="pr-grid__active">
        {%- for filter in results.filters -%}
          {%- for value in filter.active_values -%}
            {%- render 'chip', label: value.label, icon: 'close', href: filter.url_to_remove, attrs: 'data-pr-link', selected: true -%}
          {%- endfor -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
              {%- render 'chip', label: filter.label, icon: 'close', href: filter.url_to_remove, attrs: 'data-pr-link', selected: true -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- render 'link', text: 'Quitar filtros', href: gp_clear_url, attrs: 'data-pr-link', variant: 'body-sm' -%}
      </div>
    {%- endif -%}
    {%- if products.size > 0 -%}
      <ul class="pr-product-grid" role="list" style="--pr-cols: {{ gp_cols }}">
        {%- for item in products limit: gp_limit -%}
          {%- case item.object_type -%}
            {%- when 'article' -%}
              <li>{% render 'article-card', article: item, show_image: true, show_date: true, show_badge: true, media_aspect_ratio: 1 %}</li>
            {%- when 'page' -%}
              {%- assign gp_page_title = item.title | truncate: 50 -%}
              <li>{% render 'card', tag: 'div', href: item.url, title: gp_page_title, title_as: 'h3', eyebrow: 'Página' %}</li>
            {%- else -%}
              {%- render 'product-card', product: item, tag: 'li', show_vendor: show_vendor, show_quick_add: show_quick_add, show_excerpt: show_excerpt, image_ratio: image_ratio, image_fit: image_fit -%}
          {%- endcase -%}
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="pr-grid__empty">
        {%- render 'typography', text: gp_empty_title, as: 'h3', variant: 'h5', font: 'display' -%}
        {%- render 'typography', text: gp_empty_text, color: 'secondary' -%}
        {%- if gp_active > 0 -%}
          {%- render 'button', label: 'Quitar filtros', variant: 'outline', href: gp_clear_url, attrs: 'data-pr-link' -%}
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if paginate != blank -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endif -%}
  </div>
  <span class="pr-grid__spinner">{% render 'spinner', size: 'lg', label: 'Actualizando productos' %}</span>
</pr-product-grid>
