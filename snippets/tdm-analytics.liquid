{%- comment -%}
  TdmAnalytics — passes config (meta tag, safe in <head>). All logic lives in assets/tdm-analytics.js.
  Docs: docs/tracking.md. Renders nothing visible. Without a GA4 ID it still pushes to
  window.dataLayer / an existing gtag (e.g. the Google & YouTube app) and never loads anything.
{%- endcomment -%}
<meta
  name="tdm-analytics"
  data-ga-id="{{ settings.ga4_measurement_id | strip | escape }}"
  data-template="{{ template.name }}{% if template.suffix != blank %}.{{ template.suffix }}{% endif %}"
  data-currency="{{ cart.currency.iso_code }}"
>
<script src="{{ 'tdm-analytics.js' | asset_url }}" defer="defer"></script>
