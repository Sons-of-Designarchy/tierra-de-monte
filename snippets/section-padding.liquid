{%- comment -%}
  Renders Dawn's per-instance section padding rule (75% on mobile).

  {% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

  Then put `section-{{ section.id }}-padding` on the element that should carry it.
{%- endcomment -%}
{%- style -%}
  .section-{{ id }}-padding {
    padding-top: {{ top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ id }}-padding {
      padding-top: {{ top }}px;
      padding-bottom: {{ bottom }}px;
    }
  }
{%- endstyle -%}
