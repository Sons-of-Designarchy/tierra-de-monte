{%- comment -%}
  SegmentedControl — one choice among a few, always visible: Mensual/Anual, Lista/Mapa, MX/GT/VE.
  Native radios under the hood (arrow keys move, space picks). Not tabs: it changes a value, not a panel. Ports PerfectlyRad SegmentedControl.

  {% render 'segmented-control', label: 'Periodo', name: 'period', options: 'month|Mensual;year|Anual|2', value: 'month', size: 'md', full_width: false, class: '' %}

  Params
  - label        accessible name of the group (required)
  - name         required
  - options      'value|Label|count;value|Label' (count optional). Prefix a value with "!" to disable it
  - value        selected value (default: first option)
  - size         sm | md | lg   (default: md → 36 / 44 / 52px overall)
  - full_width   true → stretches and splits the width evenly
  - class

  States: hover, selected, focus-visible, disabled.
{%- endcomment -%}
{%- liquid
  assign sg_options = options | split: ';'
  assign sg_size = size | default: 'md'
  assign sg_value = value
  if sg_value == blank
    assign sg_first = sg_options[0] | split: '|'
    assign sg_value = sg_first[0]
  endif
  assign sg_type = 'body-sm'
  if sg_size == 'sm'
    assign sg_type = 'label'
  endif
-%}
<div role="radiogroup" aria-label="{{ label | escape }}" class="pr-segmented pr-segmented--{{ sg_size }}{% if full_width %} pr-segmented--full{% endif %}{% if class != blank %} {{ class }}{% endif %}">
  {%- for o in sg_options -%}
    {%- assign sg_o = o | split: '|' -%}
    {%- assign sg_val = sg_o[0] -%}
    {%- assign sg_disabled = false -%}
    {%- if sg_val contains '!' -%}{%- assign sg_disabled = true -%}{%- assign sg_val = sg_val | remove: '!' -%}{%- endif -%}
    {%- assign sg_id = name | append: '-' | append: sg_val -%}
    <input type="radio" id="{{ sg_id }}" name="{{ name }}" value="{{ sg_val }}" class="pr-segmented__input"{% if sg_val == sg_value %} checked{% endif %}{% if sg_disabled %} disabled{% endif %}>
    <label for="{{ sg_id }}" class="pr-segmented__item">
      {%- render 'typography', text: sg_o[1], as: 'span', variant: sg_type, weight: 'medium', color: 'inherit' -%}
      {%- if sg_o[2] != blank -%}{%- render 'typography', text: sg_o[2], as: 'span', variant: 'xs', font: 'mono', color: 'inherit' -%}{%- endif -%}
    </label>
  {%- endfor -%}
</div>
