{%- comment -%}
  Icon — one family (lucide paths), five sizes, 1.5px stroke, currentColor. The only way an icon enters a PerfectlyRad atom.

  {% render 'icon', name: 'check', size: 'md', label: '', class: '' %}

  Params
  - name   arrow-left | arrow-right | check | check-circle | chevron-down | chevron-right | chevron-up | close | info | alert-triangle | x-circle | plus | minus | star | search | bag | menu | user
  - size   xs | sm | md | lg | xl   (default: md → 12 / 16 / 20 / 24 / 32px)
  - label  accessible name. Omit for decorative icons next to a text label.
  - class  extra classes (layout only)
  - fill   true to fill the shape with currentColor (star)
{%- endcomment -%}
{%- liquid
  assign i_size = size | default: 'md'
-%}
<svg class="pr-icon pr-icon--{{ i_size }}{% if fill %} pr-icon--fill{% endif %}{% if class != blank %} {{ class }}{% endif %}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"{% if label != blank %} role="img" aria-label="{{ label | escape }}"{% else %} aria-hidden="true" focusable="false"{% endif %}>
  {%- case name -%}
    {%- when 'arrow-left' -%}<path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
    {%- when 'arrow-right' -%}<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
    {%- when 'check' -%}<path d="M20 6 9 17l-5-5"/>
    {%- when 'check-circle' -%}<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
    {%- when 'chevron-down' -%}<path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-right' -%}<path d="m9 18 6-6-6-6"/>
    {%- when 'chevron-up' -%}<path d="m18 15-6-6-6 6"/>
    {%- when 'close' -%}<path d="M18 6 6 18"/><path d="m6 6 12 12"/>
    {%- when 'info' -%}<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
    {%- when 'alert-triangle' -%}<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>
    {%- when 'x-circle' -%}<circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/>
    {%- when 'plus' -%}<path d="M5 12h14"/><path d="M12 5v14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'star' -%}<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
    {%- when 'menu' -%}<path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>
    {%- when 'user' -%}<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
    {%- when 'bag' -%}<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
  {%- endcase -%}
</svg>
