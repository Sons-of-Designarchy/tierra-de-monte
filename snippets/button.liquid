{%- comment -%}
  Button — every button on the site. With href it renders a link with the same shape. Ports PerfectlyRad Button + buttonVariants.ts.

  {% render 'button', label: 'Comprar', variant: 'primary', size: 'md', href: '', type: 'button', disabled: false, loading: false, icon: '', icon_position: 'start', class: '', id: '', attrs: '' %}

  Params
  - label          text (all text goes through the typography snippet)
  - content        html instead of label (e.g. text plus a badge)
  - variant        primary | secondary | outline | inverse | success | warning | error | info | text   (default: primary)
  - size           xs | sm | md | lg | xl   (default: md → 28 / 36 / 44 / 52 / 60px). Text size matches the copy next to it: xs/sm/md = body-sm, lg/xl = body-lg. Use lg beside body-lg copy.
  - href           renders <a> when given, else <button>
  - type           button | submit | reset   (button only; default: button)
  - disabled       true → aria-disabled, no pointer events, tabindex -1 on links, native disabled on buttons
  - loading        true → spinner replaces the icon, aria-busy, not pressable, keeps its colours
  - icon           icon name (see snippets/icon.liquid)
  - icon_position  start | end   (default: start)
  - name, value    form fields (button only)
  - class, id      extra classes (layout only), element id
  - attrs          extra attributes, e.g. 'data-action="x" form="f"'

  States: hover (variant colours), focus-visible (outline), disabled, loading.
{%- endcomment -%}
{%- liquid
  assign b_variant = variant | default: 'primary'
  assign b_size = size | default: 'md'
  assign b_icon_pos = icon_position | default: 'start'
  case b_size
    when 'xs'
      assign b_type = 'xs'
    when 'sm' or 'md'
      assign b_type = 'body-sm'
    else
      assign b_type = 'body-lg'
  endcase
  assign b_icon_size = 'md'
  if b_size == 'xs' or b_size == 'sm'
    assign b_icon_size = 'sm'
  endif
  capture b_inner
    if loading
      render 'spinner', size: 'sm', label: 'Cargando'
    elsif icon != blank and b_icon_pos == 'start'
      render 'icon', name: icon, size: b_icon_size
    endif
    if content != blank
      echo content
    elsif label != blank
      render 'typography', text: label, as: 'span', variant: b_type, weight: 'medium', color: 'inherit'
    endif
    if icon != blank and b_icon_pos == 'end' and loading != true
      render 'icon', name: icon, size: b_icon_size
    endif
  endcapture
  assign b_class = 'pr-btn pr-btn--' | append: b_variant | append: ' pr-btn--' | append: b_size
  if loading
    assign b_class = b_class | append: ' is-loading'
  endif
  if class != blank
    assign b_class = b_class | append: ' ' | append: class
  endif
-%}
{%- if href != blank -%}
  <a href="{{ href }}" class="{{ b_class }}"{% if id != blank %} id="{{ id }}"{% endif %}{% if disabled %} aria-disabled="true" tabindex="-1"{% endif %}{% if loading %} aria-busy="true"{% endif %}{% if attrs != blank %} {{ attrs }}{% endif %}>{{ b_inner }}</a>
{%- else -%}
  <button type="{{ type | default: 'button' }}" class="{{ b_class }}"{% if id != blank %} id="{{ id }}"{% endif %}{% if name != blank %} name="{{ name }}"{% endif %}{% if value != blank %} value="{{ value }}"{% endif %}{% if disabled %} disabled aria-disabled="true"{% endif %}{% if loading %} aria-busy="true"{% endif %}{% if attrs != blank %} {{ attrs }}{% endif %}>{{ b_inner }}</button>
{%- endif -%}
