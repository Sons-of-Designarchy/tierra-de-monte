{%- comment -%}
  Accordion — disclosure list over <details>/<summary>. Keyboard and aria are native. Also the one way to collapse a group of anything.
  Ports PerfectlyRad Accordion.

  {% capture panels %}Respuesta uno<!--pr-->Respuesta dos{% endcapture %}
  {% render 'accordion', titles: 'Pregunta uno|Pregunta dos', panels: panels, variant: 'default', multiple: false, open: 1, class: '' %}

  Params
  - titles    'Title one|Title two'
  - panels    html panels in the same order, separated by <!--pr-->
  - variant   default (bordered list: FAQ, locations) | quiet (compact header that opens a group: sidebar, filters)   (default: default)
  - multiple  true → several can be open. Default: one open at a time (details name group)
  - open      number of the item open on load, 1-based (0 or blank: none)
  - name      group name for exclusive mode (default: pr-accordion)
  - class

  States: hover, open (chevron turns), focus-visible.
{%- endcomment -%}
{%- liquid
  assign ac_titles = titles | split: '|'
  assign ac_panels = panels | split: '<!--pr-->'
  assign ac_variant = variant | default: 'default'
  assign ac_name = name | default: 'pr-accordion'
-%}
<div class="pr-accordion pr-accordion--{{ ac_variant }}{% if class != blank %} {{ class }}{% endif %}">
  {%- for t in ac_titles -%}
    {%- assign ac_n = forloop.index -%}
    {%- assign ac_idx = forloop.index0 -%}
    <details class="pr-accordion__item"{% unless multiple %} name="{{ ac_name }}"{% endunless %}{% if open == ac_n %} open{% endif %}>
      <summary class="pr-accordion__trigger">
        {%- if ac_variant == 'quiet' -%}
          {%- render 'typography', text: t, as: 'span', variant: 'label', weight: 'semibold', color: 'secondary' -%}
        {%- else -%}
          {%- render 'typography', text: t, as: 'span', variant: 'body', weight: 'medium', color: 'inherit' -%}
        {%- endif -%}
        {%- render 'icon', name: 'chevron-down', size: 'md', class: 'pr-accordion__chevron' -%}
      </summary>
      <div class="pr-accordion__panel">{{ ac_panels[ac_idx] }}</div>
    </details>
  {%- endfor -%}
</div>
