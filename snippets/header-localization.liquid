{%- comment -%}
  Header localization — country and language pickers (Dawn forms). Renders nothing when the store has one country and one language.

  {% render 'header-localization', country: true, language: true, suffix: '', uid: section.id %}
{%- endcomment -%}
{%- if country and localization.available_countries.size > 1 -%}
  {%- capture loc_pos -%}HeaderCountry{{ suffix }}{{ uid }}{%- endcapture -%}
  <localization-form data-prevent-hide>
    {%- form 'localization', id: loc_pos, class: 'localization-form' -%}
      <div>
        <h2 class="visually-hidden" id="{{ loc_pos }}Label">{{ 'localization.country_label' | t }}</h2>
        {%- render 'country-localization', localPosition: loc_pos -%}
      </div>
    {%- endform -%}
  </localization-form>
{%- endif -%}
{%- if language and localization.available_languages.size > 1 -%}
  {%- capture loc_pos -%}HeaderLanguage{{ suffix }}{{ uid }}{%- endcapture -%}
  <localization-form data-prevent-hide>
    {%- form 'localization', id: loc_pos, class: 'localization-form' -%}
      <div>
        <h2 class="visually-hidden" id="{{ loc_pos }}Label">{{ 'localization.language_label' | t }}</h2>
        {%- render 'language-localization', localPosition: loc_pos -%}
      </div>
    {%- endform -%}
  </localization-form>
{%- endif -%}
