{%- comment -%}
  Test price — preview-only stand-in for products priced $0 in Shopify, so the order calculator can be reviewed.
  Prints the fake price in cents, or nothing when the variant already has a real price (> 0). Real prices always win.
  Never touches Shopify data; the checkout still carries the real $0 line.

  {%- capture tp -%}{%- render 'test-price', index: forloop.index0, variant: variant, base: 1250 -%}{%- endcapture -%}

  Params
  - index    position of the product in its list (cycles through six price steps: 0.68, 0.88, 1, 1.16, 1.28, 1.51 × base)
  - variant  the Shopify variant (a title containing "500" is priced at 45% of the step)
  - base     MXN, default 1250 → 850, 1100, 1250, 1450, 1600, 1890
{%- endcomment -%}
{%- liquid
  if variant.price == 0
    assign tp_steps = '68,88,100,116,128,151' | split: ','
    assign tp_slot = index | modulo: 6
    assign tp_step = tp_steps[tp_slot] | times: 1
    assign tp_base = base | default: 1250
    assign tp_value = tp_base | times: tp_step | divided_by: 100.0
    if variant.title contains '500'
      assign tp_value = tp_value | times: 0.45
    endif
    assign tp_cents = tp_value | round | times: 100
    echo tp_cents
  endif
-%}
