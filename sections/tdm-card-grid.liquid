{%- comment -%}
  Card grid — a PerfectlyRad Section (heading block) + Grid of Cards. Nothing of its own: every card is the `card` atom.
  Card kinds, all the same atom with params:
    icon       card_media_style: icon       small picture above title and text (block "Imagen")
    photo_top  card_media_style: photo_top  photo edge to edge above the body (block "Foto", or "Imagen")
    photo_bg   card_media_style: photo_bg   photo fills the card, white glass panel (block "Foto", "Imagen" or "Imagen de fondo")
  A block with "Imagen de fondo" is a photo card whatever the style. On a coloured section the cards are white (never green on green).
  Styles: assets/section-tdm-card-grid.css (layout only) + the card atom in assets/pr-atoms.css and pr-atoms-extra.css.
{%- endcomment -%}
{% render 'tdm-anchor', id: section.settings.anchor_id %}
{{ 'section-tdm-card-grid.css' | asset_url | stylesheet_tag }}
{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- liquid
  assign s = section.settings

  assign cols_desktop = s.columns_desktop | default: 3
  assign rows = s.rows | default: 0
  if rows > 0
    assign visible = cols_desktop | times: rows | at_most: section.blocks.size
  else
    assign visible = section.blocks.size
  endif
  if s.auto_fit_columns and visible > 0 and visible < cols_desktop
    assign cols_desktop = visible
  endif
  assign cols_tablet = s.columns_tablet | default: 2 | at_most: cols_desktop
  assign cols_mobile = s.columns_mobile | default: 1

  case s.heading_size
    when 'h2'
      assign cg_title_size = 'h2'
    when 'h1'
      assign cg_title_size = 'h1'
    else
      assign cg_title_size = 'display'
  endcase
  assign cg_align = s.title_alignment | default: 'left'
  if cg_align != 'center'
    assign cg_align = 'left'
  endif

  assign cg_style = s.card_media_style | default: 'icon'
  case s.photo_ratio
    when 'square'
      assign cg_photo_ratio = '1/1'
    when '3_4'
      assign cg_photo_ratio = '3/4'
    when '16_9'
      assign cg_photo_ratio = '16/9'
    else
      assign cg_photo_ratio = '4/3'
  endcase
  case s.card_shape
    when 'square'
      assign cg_shape = '1/1'
    when 'rect_h' or 'rect_43'
      assign cg_shape = '4/3'
    when 'rect_v'
      assign cg_shape = '4/5'
    else
      assign cg_shape = ''
  endcase
  assign btn_href = s.button_link | default: '#'
  assign cg_list_icon = ''
  if s.list_icon != 'none'
    assign cg_list_icon = 'check-circle'
  endif

  # A section with colour behind the cards (anything but near-white) gets white cards
  assign cg_scheme = settings.color_schemes[s.color_scheme]
  assign cg_on_color = true
  if cg_scheme.settings.background.lightness > 92 and s.bg_image == blank
    assign cg_on_color = false
  endif
  if s.bg_image != blank
    assign cg_on_color = true
  endif
-%}

<div
  class="tdm-card-grid color-{{ s.color_scheme }} gradient{% if s.bg_image != blank %} tdm-has-bg{% endif %}"
  style="--cg-cols: {{ cols_desktop }}; --cg-cols-tablet: {{ cols_tablet }}; --cg-cols-mobile: {{ cols_mobile }};"
>
  {% render 'tdm-section-background', image: s.bg_image, image_mobile: s.bg_image_mobile, overlay: s.bg_overlay, position: s.bg_position %}
  <div class="tdm-card-grid__inner page-width section-{{ section.id }}-padding isolate">
    {%- render 'section-header', eyebrow: s.pretitle, title: s.title, intro: s.intro_paragraph, size: cg_title_size, align: cg_align -%}

    <ul class="tdm-card-grid__grid" role="list">
      {%- for block in section.blocks limit: visible -%}
        {%- liquid
          assign b = block.settings
          assign card_title = b.title | remove: '&nbsp;' | strip
          if card_title contains '|'
            assign card_title = card_title | split: '|' | join: '<br>'
          endif

          assign card_bg = b.bg_image
          assign card_photo = b.photo | default: b.image
          assign card_image = nil
          assign card_icon = nil
          assign card_media_ratio = nil
          assign card_alt = b.title | strip_html | remove: '&nbsp;' | strip
          if card_bg == blank and cg_style == 'photo_bg'
            assign card_bg = card_photo
          endif
          if card_bg == blank
            if cg_style == 'photo_top'
              assign card_image = card_photo
              assign card_media_ratio = cg_photo_ratio
            else
              assign card_icon = b.image
            endif
          endif
        -%}
        <li class="tdm-card-grid__item" {{ block.shopify_attributes }}>
          {%- render 'card',
            title: card_title,
            title_size: s.card_heading_size,
            text: b.text,
            list_icon: cg_list_icon,
            image: card_image,
            image_ratio: card_media_ratio,
            image_alt: card_alt,
            icon_image: card_icon,
            bg_image: card_bg,
            ratio: cg_shape,
            cta_label: b.link_label,
            cta_href: b.link,
            on_color: cg_on_color,
            padding: 'lg',
            tag: 'div',
            class: 'tdm-card-grid__card'
          -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if s.button_label != blank -%}
      <div class="tdm-card-grid__cta">
        {%- if s.button_style == 'secondary' -%}{%- assign cg_btn_variant = 'outline' -%}{%- else -%}{%- assign cg_btn_variant = 'primary' -%}{%- endif -%}
        {%- capture cg_btn_attrs -%}{% if s.button_link == blank %}role="link" aria-disabled="true"{% endif %}{% if s.button_new_tab %} target="_blank" rel="noopener"{% endif %}{% if btn_href contains '#pedido' %} data-track="quiero-ser-aliado"{% endif %}{%- endcapture -%}
        {%- render 'button', label: s.button_label, href: btn_href, variant: cg_btn_variant, size: 'lg', attrs: cg_btn_attrs -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Tarjetas",
  "class": "section",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "ID de ancla",
      "info": "Para enlazar a esta sección desde un botón. 1 o 2 palabras en español separadas por guion, ej. formulario o como-funciona. Enlace: /pages/aliados#formulario"
    },
    { "type": "header", "content": "Encabezado" },
    { "type": "text", "id": "pretitle", "label": "Eyebrow", "info": "Texto pequeño arriba del título. Sin línea.", "placeholder": "Ej. Explora", "default": "Explora" },
    { "type": "inline_richtext", "id": "title", "default": "Beneficios de ser aliado", "label": "Título de la sección" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "Título 2" },
        { "value": "h1", "label": "Título 1" },
        { "value": "h0", "label": "Display" }
      ],
      "default": "h1"
    },
    { "type": "text_alignment", "id": "title_alignment", "label": "Alineación del encabezado", "default": "left" },
    {
      "type": "richtext",
      "id": "intro_paragraph",
      "label": "Párrafo introductorio",
      "default": "<p>Agrega aquí un párrafo introductorio para esta sección.</p>"
    },

    { "type": "header", "content": "Tarjetas" },
    {
      "type": "select",
      "id": "card_media_style",
      "label": "Estilo de tarjeta",
      "info": "Ícono: imagen pequeña arriba. Foto arriba: foto a lo ancho. Foto de fondo: la foto llena la tarjeta y el texto va en un panel blanco.",
      "options": [
        { "value": "icon", "label": "Ícono" },
        { "value": "photo_top", "label": "Foto arriba" },
        { "value": "photo_bg", "label": "Foto de fondo" }
      ],
      "default": "icon"
    },
    {
      "type": "select",
      "id": "photo_ratio",
      "label": "Proporción de la foto (Foto arriba)",
      "options": [
        { "value": "square", "label": "Cuadrada" },
        { "value": "4_3", "label": "4:3" },
        { "value": "3_4", "label": "3:4" },
        { "value": "16_9", "label": "16:9" }
      ],
      "default": "4_3"
    },
    {
      "type": "select",
      "id": "card_shape",
      "label": "Forma de la tarjeta",
      "options": [
        { "value": "auto", "label": "Según el contenido" },
        { "value": "square", "label": "Cuadrada" },
        { "value": "rect_43", "label": "Horizontal 4:3" },
        { "value": "rect_h", "label": "Horizontal 4:3 (antes 3:2)" },
        { "value": "rect_v", "label": "Vertical 4:5" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "card_heading_size",
      "label": "Tamaño del título de la tarjeta",
      "options": [
        { "value": "h4", "label": "Título 4" },
        { "value": "h3", "label": "Título 3" },
        { "value": "h2", "label": "Título 2" },
        { "value": "h1", "label": "Título 1" }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "list_icon",
      "label": "Viñetas de la descripción",
      "options": [
        { "value": "none", "label": "Viñetas normales" },
        { "value": "check_circle", "label": "Palomita en círculo" }
      ],
      "default": "none"
    },
    { "type": "range", "id": "columns_desktop", "min": 1, "max": 6, "step": 1, "default": 3, "label": "Columnas en escritorio" },
    { "type": "range", "id": "columns_tablet", "min": 1, "max": 4, "step": 1, "default": 2, "label": "Columnas en tablet" },
    { "type": "select", "id": "columns_mobile", "label": "Columnas en móvil", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "1" },
    { "type": "checkbox", "id": "auto_fit_columns", "label": "Ajustar columnas si hay menos tarjetas", "default": true },
    { "type": "range", "id": "rows", "min": 0, "max": 6, "step": 1, "default": 0, "label": "Filas visibles", "info": "0 = todas las tarjetas." },

    { "type": "header", "content": "Botón de la sección" },
    { "type": "text", "id": "button_label", "label": "Texto del botón" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "checkbox", "id": "button_new_tab", "label": "Abrir en pestaña nueva", "default": false },
    {
      "type": "select",
      "id": "button_style",
      "label": "Estilo del botón",
      "options": [{ "value": "primary", "label": "Principal" }, { "value": "secondary", "label": "Secundario" }],
      "default": "primary"
    },

    { "type": "header", "content": "Color y fondo" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color de la sección",
      "info": "Si la sección tiene color, las tarjetas van en blanco automáticamente.",
      "default": "scheme-1"
    },
    { "type": "image_picker", "id": "bg_image", "label": "Imagen de fondo" },
    { "type": "image_picker", "id": "bg_image_mobile", "label": "Imagen de fondo (móvil)", "info": "Opcional. Si está vacía usa la de escritorio." },
    { "type": "range", "id": "bg_overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Oscurecer imagen", "default": 40 },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Enfoque de la imagen",
      "default": "center",
      "options": [{ "value": "top", "label": "Arriba" }, { "value": "center", "label": "Centro" }, { "value": "bottom", "label": "Abajo" }]
    },

    { "type": "header", "content": "t:sections.all.padding.section_padding_heading" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 36 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Tarjeta",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen", "info": "Estilo Ícono: la imagen pequeña de arriba. Foto arriba / Foto de fondo: la foto si no hay una en «Foto»." },
        { "type": "image_picker", "id": "photo", "label": "Foto", "info": "Estilos Foto arriba y Foto de fondo." },
        { "type": "image_picker", "id": "bg_image", "label": "Imagen de fondo", "info": "Convierte esta tarjeta en tarjeta de foto sea cual sea el estilo." },
        { "type": "inline_richtext", "id": "title", "label": "Título", "default": "Precio preferencial", "info": "«|» parte el título en dos líneas." },
        { "type": "richtext", "id": "text", "label": "Descripción", "default": "<p>Compras entre 5 y 20% abajo del precio de lista, según tu volumen.</p>" },
        { "type": "header", "content": "Enlace (opcional)" },
        { "type": "text", "id": "link_label", "label": "Texto del enlace" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [{ "name": "Tarjetas", "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }] }]
}
{% endschema %}
