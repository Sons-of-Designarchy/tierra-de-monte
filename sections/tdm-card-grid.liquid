{% render 'tdm-anchor', id: section.settings.anchor_id %}
{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'section-tdm-card-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tdm-card-grid.js' | asset_url }}" defer="defer"></script>
{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- liquid
  assign s = section.settings

  # Filas visibles: 0 = todas las cards; si no, columnas x filas
  assign cols_desktop = s.columns_desktop | default: 3
  assign rows = s.rows | default: 0
  if rows > 0
    assign visible = cols_desktop | times: rows | at_most: section.blocks.size
  else
    assign visible = section.blocks.size
  endif

  # Columnas efectivas: si hay menos cards que columnas, el grid usa el número de cards
  if s.auto_fit_columns and visible > 0 and visible < cols_desktop
    assign cols_desktop = visible
  endif
  assign cols_tablet = s.columns_tablet | default: 2 | at_most: cols_desktop

  # ¿Alguna card visible tiene imagen / título? (para reservar el espacio en las que no)
  assign any_image = false
  assign any_title = false
  for b in section.blocks limit: visible
    if b.settings.image != blank
      assign any_image = true
    endif
    if b.settings.title != blank
      assign any_title = true
    endif
  endfor
  assign unify = s.unify_layout
  assign align_titles = s.align_titles
  assign reserve_title = false
  if unify or align_titles
    assign reserve_title = any_title
  endif

  # Posición vertical del párrafo (sección)
  assign text_valign_default = s.text_valign | default: 'top'

  # Posición del grid
  case s.grid_justify
    when 'center'
      assign grid_justify = 'center'
    when 'right'
      assign grid_justify = 'flex-end'
    else
      assign grid_justify = 'flex-start'
  endcase
  assign grid_align = s.grid_align | default: 'stretch'

  # Alineación de cards (sección)
  assign img_align_default = s.image_alignment | default: 'center'

  assign columns_mobile_int = s.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if s.swipe_on_mobile and visible > columns_mobile_int
    assign show_mobile_slider = true
  endif

  # Márgenes para alinear encabezado / intro (izq, centro, der)
  assign title_align = s.title_alignment | default: 'left'
  assign intro_align = s.intro_alignment | default: 'left'
  assign card_align = s.column_alignment | default: 'left'

  case title_align
    when 'center'
      assign title_ml = 'auto'
      assign title_mr = 'auto'
      assign title_justify = 'center'
    when 'right'
      assign title_ml = 'auto'
      assign title_mr = '0'
      assign title_justify = 'flex-end'
    else
      assign title_ml = '0'
      assign title_mr = 'auto'
      assign title_justify = 'flex-start'
  endcase

  case intro_align
    when 'center'
      assign intro_ml = 'auto'
      assign intro_mr = 'auto'
    when 'right'
      assign intro_ml = 'auto'
      assign intro_mr = '0'
    else
      assign intro_ml = '0'
      assign intro_mr = 'auto'
  endcase

  case s.button_alignment
    when 'left'
      assign btn_justify = 'flex-start'
    when 'right'
      assign btn_justify = 'flex-end'
    else
      assign btn_justify = 'center'
  endcase

  # Forma de las cards (rectángulo / cuadrado) y posición del contenido
  case s.card_shape
    when 'square'
      assign shape_ratio = '1 / 1'
    when 'rect_h'
      assign shape_ratio = '3 / 2'
    when 'rect_43'
      assign shape_ratio = '4 / 3'
    when 'rect_v'
      assign shape_ratio = '4 / 5'
    else
      assign shape_ratio = ''
  endcase
  assign ccp = s.card_content_position | default: 'spread'
  assign shape_mobile = s.card_shape_mobile | default: 'auto'
  case ccp
    when 'center'
      assign content_justify = 'center'
    when 'bottom'
      assign content_justify = 'flex-end'
    when 'spread'
      assign content_justify = 'space-between'
    else
      assign content_justify = 'flex-start'
  endcase

  # Ícono de las viñetas de la descripción
  assign list_icon = s.list_icon | default: 'none'

  # Estilo de tarjeta: ícono (actual) o foto (arriba / de fondo)
  assign card_media_style = s.card_media_style | default: 'icon'
  case s.photo_ratio
    when 'square'
      assign photo_ratio_css = '1 / 1'
    when '3_4'
      assign photo_ratio_css = '3 / 4'
    when '16_9'
      assign photo_ratio_css = '16 / 9'
    else
      assign photo_ratio_css = '4 / 3'
  endcase
-%}

<div
  class="multicolumn tdm-card-grid color-{{ s.color_scheme }} gradient{% unless s.background_style == 'none' and settings.text_boxes_border_thickness > 0 or settings.text_boxes_shadow_opacity > 0 %} background-{{ s.background_style }}{% endunless %}{% if s.title == blank %} no-heading{% endif %}{% if s.card_background %} tdm-card-grid--has-bg{% endif %}{% if list_icon != 'none' %} tdm-card-grid--has-list-icon{% endif %}{% if s.image_mode == 'icon' %} tdm-card-grid--icon-mode{% endif %}{% if s.image_contain_bg %} tdm-card-grid--contain-bg{% endif %}{% if shape_ratio != '' %} tdm-card-grid--fixed-shape{% endif %}{% if shape_ratio != '' and shape_mobile == 'auto' %} tdm-card-grid--shape-mobile-auto{% endif %}{% if ccp != 'spread' %} tdm-card-grid--content-fixed{% endif %}{% if unify %} tdm-card-grid--unify{% endif %}{% if s.title_lines > 0 %} tdm-card-grid--title-lines{% endif %}{% if s.image_bleed and s.card_background and s.image_mode == 'image' %} tdm-card-grid--image-bleed{% endif %}{% if show_mobile_slider %} tdm-card-grid--mobile-slider{% endif %}{% if grid_align != 'stretch' %} tdm-card-grid--grid-align-auto{% endif %}{% if s.button_pill %} tdm-card-grid--btn-pill{% endif %}{% if card_media_style == 'photo_top' %} tdm-card-grid--photo-top{% endif %}{% if card_media_style == 'photo_bg' %} tdm-card-grid--photo-bg{% endif %}{% if s.bg_image != blank %} tdm-has-bg{% endif %}"
  style="
    --tdm-cg-photo-ratio: {{ photo_ratio_css }};
    --tdm-cg-header-max-width: {{ s.header_max_width | default: 50 }}%;
    --tdm-cg-title-ml: {{ title_ml }};
    --tdm-cg-title-mr: {{ title_mr }};
    --tdm-cg-title-justify: {{ title_justify }};
    --tdm-cg-title-align: {{ title_align }};
    --tdm-cg-intro-ml: {{ intro_ml }};
    --tdm-cg-intro-mr: {{ intro_mr }};
    --tdm-cg-intro-align: {{ intro_align }};
    --tdm-cg-grid-justify: {{ grid_justify }};
    --tdm-cg-grid-align: {{ grid_align }};
    --tdm-cg-btn-justify: {{ btn_justify }};
    --tdm-cg-content-justify: {{ content_justify }};
    --tdm-cg-card-radius: {{ s.card_radius }}px;
    --tdm-cg-card-pad-mobile: {{ s.card_padding | times: 0.75 | round: 0 }}px;
    --tdm-cg-card-pad-desktop: {{ s.card_padding }}px;
    --tdm-cg-image-gap: {{ s.image_gap | default: 16 }}px;
    --tdm-cg-image-radius: {{ s.image_radius }}px;
    --tdm-cg-image-height-mobile: {{ s.image_height | times: 0.75 | round: 0 }}px;
    --tdm-cg-image-height-desktop: {{ s.image_height }}px;
    --tdm-cg-icon-size: {{ s.icon_size }}px;
    --tdm-cg-media-max-width: {% if s.image_mode == 'icon' %}{{ s.icon_size }}px{% else %}{{ s.image_width_percent | default: 100 }}%{% endif %};
    --tdm-cg-cols-tablet: {{ cols_tablet }};
    --tdm-cg-list-icon-fill: {% if s.list_icon_color == 'text' %}rgb(var(--color-foreground)){% else %}rgb(var(--color-button)){% endif %};
    --tdm-cg-shape-ratio: {{ shape_ratio }};
    --tdm-cg-title-lines: {{ s.title_lines }};
  "
>
  {% render 'tdm-section-background', image: s.bg_image, image_mobile: s.bg_image_mobile, overlay: s.bg_overlay, position: s.bg_position %}
  <div
    class="tdm-card-grid__inner page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {% render 'tdm-section-eyebrow', text: s.pretitle, rule_color: s.rule_color, align: title_align %}

    {%- unless s.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title">
        <h2 class="title inline-richtext {{ s.heading_size }}">
          {{ s.title }}
        </h2>
      </div>
    {%- endunless -%}

    {%- if s.intro_paragraph != blank -%}
      <div class="multicolumn__intro rte">
        {{ s.intro_paragraph }}
      </div>
    {%- endif -%}

    <tdm-card-grid-titles data-active="{{ align_titles }}">
      <slider-component class="slider-mobile-gutter">
        <ul
          class="tdm-card-grid__grid multicolumn-list contains-content-container grid grid--{{ s.columns_mobile }}-col-tablet-down grid--{{ cols_desktop }}-col-desktop{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %}"
          id="Slider-{{ section.id }}"
          role="list"
          {%- unless s.use_theme_spacing %}
          style="--grid-desktop-horizontal-spacing: {{ s.gap_horizontal }}px; --grid-desktop-vertical-spacing: {{ s.gap_vertical }}px; --grid-mobile-horizontal-spacing: {{ s.gap_horizontal | divided_by: 2 }}px; --grid-mobile-vertical-spacing: {{ s.gap_vertical | divided_by: 2 }}px;"
          {%- endunless %}
        >
        {%- liquid
          assign highest_ratio = 0
          for block in section.blocks
            if block.settings.image != blank and block.settings.image.aspect_ratio
              if block.settings.image.aspect_ratio > highest_ratio
                assign highest_ratio = block.settings.image.aspect_ratio
              endif
            endif
          endfor
          if highest_ratio == 0
            assign highest_ratio = 1
          endif
        -%}
        {%- liquid
          if list_icon != 'none'
            capture list_icon_html
              render 'icon-accordion', icon: list_icon
            endcapture
          endif
        -%}
        {%- for block in section.blocks limit: visible -%}
          {%- liquid
            assign empty_column = ''
            assign img_align = block.settings.image_alignment_override | default: 'section'
            if img_align == 'section'
              assign img_align = img_align_default
            endif
            assign txt_align = block.settings.text_alignment_override | default: 'section'
            if txt_align == 'section'
              assign txt_align = card_align
            endif

            # Posición vertical del párrafo: card > sección
            assign txt_valign = block.settings.text_valign_override | default: 'section'
            if txt_valign == 'section'
              assign txt_valign = text_valign_default
            endif

            # Tamaños de texto: card > sección (0 = no forzar)
            assign t_size = block.settings.title_size | default: 0
            if t_size == 0 and s.custom_text_sizes
              assign t_size = s.card_title_size
            endif
            assign p_size = block.settings.text_size | default: 0
            if p_size == 0 and s.custom_text_sizes
              assign p_size = s.card_text_size
            endif
            assign card_style = ''
            if t_size > 0
              assign card_style = card_style | append: '--mc-ts: ' | append: t_size | append: ';'
            endif
            if p_size > 0
              assign card_style = card_style | append: '--mc-ps: ' | append: p_size | append: ';'
            endif

            # Título sin espacios duros al inicio (evita que se vea desalineado)
            assign card_title = block.settings.title | strip
            for i in (1..5)
              assign head6 = card_title | slice: 0, 6
              assign head1 = card_title | slice: 0
              if head6 == '&nbsp;'
                assign card_title = card_title | remove_first: '&nbsp;' | strip
              elsif head1 == ' '
                assign card_title = card_title | remove_first: ' ' | strip
              else
                break
              endif
            endfor

            # "|" en el título = salto de línea (el campo no admite Enter)
            if card_title contains '|'
              assign card_title_lines = card_title | split: '|'
              assign card_title = ''
              for line in card_title_lines
                assign line = line | strip | remove: '&nbsp;'
                unless forloop.first
                  assign card_title = card_title | append: '<br>'
                endunless
                assign card_title = card_title | append: line
              endfor
            endif
          -%}
          {%- if block.settings.image == blank
            and block.settings.title == blank
            and block.settings.text == blank
            and block.settings.link_label == blank
          -%}
            {%- assign empty_column = ' multicolumn-list__item--empty' -%}
          {%- endif -%}

          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="{% if s.mobile_side_line %}multicolumn-list__item{% else %}mc-list__item{% endif %} grid__item mc-img--{{ img_align }} mc-txt--{{ txt_align }}{% if s.swipe_on_mobile %} slider__slide{% endif %}{{ empty_column }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {%- liquid
              assign card_scheme = s.card_color_scheme
              if block.settings.use_custom_scheme
                assign card_scheme = block.settings.card_color_scheme
              endif

              # Imagen de fondo + overlay + texto en vidrio (por card)
              assign card_bg = block.settings.bg_image
              assign glass_on = false
              if card_bg != blank
                assign ov_alpha = block.settings.overlay_opacity | divided_by: 100.0
                assign ov_rgba = block.settings.overlay_color | color_modify: 'alpha', ov_alpha
                assign card_style = card_style | append: '--mc-ov: ' | append: ov_rgba | append: ';'
                if block.settings.glass
                  assign glass_on = true
                  assign g_alpha = block.settings.glass_opacity | divided_by: 100.0
                  assign g_rgba = block.settings.glass_color | color_modify: 'alpha', g_alpha
                  assign card_style = card_style | append: '--mc-glass-bg: ' | append: g_rgba | append: '; --mc-glass-blur: ' | append: block.settings.glass_blur | append: 'px;'
                endif
              endif

              # Foto de la card (estilos Foto arriba / Foto de fondo): la "Foto" dedicada,
              # o la Imagen de siempre si esta card no tiene foto propia.
              assign card_photo = block.settings.photo
              if card_photo == blank
                assign card_photo = block.settings.image
              endif
              assign card_photo_alt = block.settings.title | strip_html | escape
            -%}
            {%- capture sizes_photo -%}
              (min-width: 990px) calc(100vw / {{ cols_desktop }}), (min-width: 750px) calc(100vw / {{ cols_tablet }}), 100vw
            {%- endcapture -%}
            <div
              class="multicolumn-card content-container mc-tv--{{ txt_valign }}{% if t_size > 0 %} mc-card--ts{% endif %}{% if p_size > 0 %} mc-card--ps{% endif %}{% if s.card_background %} mc-card color-{{ card_scheme }}{% elsif card_bg != blank %} color-{{ card_scheme }}{% endif %}{% if card_bg != blank %} mc-card--bgimg{% endif %}{% if glass_on %} mc-card--glass{% endif %}"
              {% if card_style != '' %}
                style="{{ card_style }}"
              {% endif %}
            >
              {%- if card_bg != blank -%}
                <div class="mc-bg" aria-hidden="true">
                  {{
                    card_bg
                    | image_url: width: 1600
                    | image_tag:
                      widths: '500, 750, 1000, 1300, 1600',
                      sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                      loading: 'lazy',
                      alt: ''
                  }}
                </div>
                <div class="mc-bg__overlay" aria-hidden="true"></div>
              {%- endif -%}
              {%- if card_media_style == 'photo_bg' -%}
                {%- if card_photo != blank -%}
                  <div class="tdm-card-grid__photo-bg" aria-hidden="true">
                    {{
                      card_photo
                      | image_url: width: 1600
                      | image_tag:
                        widths: '400, 600, 800, 1200, 1600',
                        sizes: sizes_photo,
                        loading: 'lazy',
                        class: 'tdm-card-grid__photo-bg-img',
                        alt: card_photo_alt
                    }}
                  </div>
                {%- endif -%}
              {%- elsif card_media_style == 'photo_top' -%}
                {%- if card_photo != blank -%}
                  <div class="tdm-card-grid__photo">
                    {{
                      card_photo
                      | image_url: width: 1600
                      | image_tag:
                        widths: '400, 600, 800, 1200, 1600',
                        sizes: sizes_photo,
                        loading: 'lazy',
                        class: 'tdm-card-grid__photo-img',
                        alt: card_photo_alt
                    }}
                  </div>
                {%- endif -%}
              {%- elsif block.settings.image != blank -%}
                {%- liquid
                  assign number_of_columns = cols_desktop
                  assign number_of_columns_mobile = s.columns_mobile
                  if s.image_mode == 'icon'
                    assign img_px = s.icon_size | times: 2
                    capture sizes
                      echo s.icon_size | append: 'px'
                    endcapture
                  else
                    assign img_px = 1600
                    assign pct = s.image_width_percent | divided_by: 100.0
                    capture sizes
                      echo '(min-width: 990px) calc(100vw * ' | append: pct | append: ' / ' | append: number_of_columns | append: '), '
                      echo '(min-width: 750px) calc(100vw * ' | append: pct | append: ' / ' | append: cols_tablet | append: '), '
                      echo 'calc(100vw * ' | append: pct | append: ' / ' | append: number_of_columns_mobile | append: ')'
                    endcapture
                  endif
                -%}
                {%- liquid
                  # Ajuste (cubrir / contener) por card
                  assign fit = block.settings.image_fit_override | default: 'section'
                  if fit == 'section'
                    if s.image_mode == 'icon'
                      assign fit = 'contain'
                    else
                      assign fit = s.image_fit | default: 'cover'
                    endif
                  endif

                  # Posición: punto focal de Shopify o vertical elegida + alineación horizontal
                  assign pos_v = block.settings.image_position_override | default: 'section'
                  if pos_v == 'section'
                    assign pos_v = s.image_position | default: 'focal'
                  endif
                  case img_align
                    when 'left'
                      assign pos_h = 'left'
                    when 'right'
                      assign pos_h = 'right'
                    else
                      assign pos_h = 'center'
                  endcase
                  if pos_v == 'focal' and block.settings.image.presentation.focal_point != blank
                    assign pos = block.settings.image.presentation.focal_point
                  elsif pos_v == 'focal'
                    assign pos = pos_h | append: ' center'
                  else
                    assign pos = pos_h | append: ' ' | append: pos_v
                  endif

                  assign has_bg = false
                  if fit == 'contain' and s.image_mode == 'image'
                    assign has_bg = true
                  endif
                -%}
                <div class="mc-media-wrap"{% if block.settings.image_size > 0 %} style="--mc-img-size: {{ block.settings.image_size }}px;"{% endif %}>
                  <div class="mc-media mc-media--{{ s.image_ratio }}{% if has_bg %} mc-media--has-bg{% endif %}" style="--mc-fit: {{ fit }}; --mc-pos: {{ pos }};">
                    {{
                      block.settings.image
                      | image_url: width: img_px
                      | image_tag:
                        widths: '80, 160, 300, 500, 750, 1000, 1300, 1600',
                        sizes: sizes,
                        loading: 'lazy',
                        class: 'multicolumn-card__image'
                    }}
                  </div>
                </div>
              {%- elsif unify and any_image -%}
                <div class="mc-media-wrap mc-media-wrap--empty" aria-hidden="true">
                  <div class="mc-media mc-media--{{ s.image_ratio }}">&nbsp;</div>
                </div>
              {%- endif -%}
              <div class="multicolumn-card__info">
                {%- if card_title != blank -%}
                  <h3 class="inline-richtext mc-card__title {{ s.card_heading_size | default: 'h3' }}"><span class="mc-card__title-fit">{{ card_title }}</span></h3>
                {%- elsif reserve_title -%}
                  <div class="mc-card__title mc-card__title--empty {{ s.card_heading_size | default: 'h3' }}" aria-hidden="true"></div>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  {%- liquid
                    # Ícono en cada viñeta (misma lista de íconos que el desplegable de Dawn)
                    assign card_text = block.settings.text
                    if list_icon != 'none'
                      assign li_open = '<li><span class="mc-li-icon" aria-hidden="true">' | append: list_icon_html | append: '</span>'
                      assign card_text = card_text | replace: '<li>', li_open
                    endif
                  -%}
                  <div class="rte{% if block.settings.desc_font == 'mono' %} mc-desc--mono tdm-mono tdm-upper{% endif %}">
                    {{ card_text }}
                  </div>
                {%- endif -%}
                {%- if block.settings.link_label != blank -%}
                  <a
                    class="link animate-arrow"
                    {% if block.settings.link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.link }}"
                    {% endif %}
                  >
                    {{- block.settings.link_label | escape -}}
                    <span class="svg-wrapper"
                      ><span class="icon-wrap">&nbsp;{{ 'icon-arrow.svg' | inline_asset_content }}</span></span
                    >
                  </a>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider -%}
        <div class="slider-buttons large-up-hide">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ visible }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
        </div>
      {%- endif -%}
      </slider-component>
    </tdm-card-grid-titles>

    {%- if s.button_label != blank -%}
      <div class="mc-cta">
        <a
          class="button button--{{ s.button_style | default: 'primary' }} color-{{ s.button_color_scheme }}"
          {% if s.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ s.button_link }}"
          {% endif %}
          {% if s.button_new_tab %}target="_blank" rel="noopener"{% endif %}
        >
          {{ s.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Tarjetas",
  "class": "section",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "ID de ancla",
      "info": "Para enlazar a esta sección desde un botón. 1 o 2 palabras en español separadas por guion, ej. formulario o como-funciona. Enlace: /pages/aliados#formulario"
    },
    { "type": "header", "content": "Encabezado" },
    { "type": "text", "id": "pretitle", "label": "Eyebrow", "info": "Texto pequeño arriba del título. La línea aparece solo si hay texto.", "placeholder": "Ej. Explora", "default": "Explora" },
