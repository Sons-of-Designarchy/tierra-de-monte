{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  # Filas visibles: 0 = todas las cards; si no, columnas x filas
  assign cols_desktop = s.columns_desktop | default: 3
  assign rows = s.rows | default: 0
  if rows > 0
    assign visible = cols_desktop | times: rows | at_most: section.blocks.size
  else
    assign visible = section.blocks.size
  endif

  # Columnas efectivas: si hay menos cards que columnas, el grid usa el número de cards
  if s.auto_fit_columns and visible > 0 and visible < cols_desktop
    assign cols_desktop = visible
  endif
  assign cols_tablet = s.columns_tablet | default: 2 | at_most: cols_desktop

  # ¿Alguna card visible tiene imagen / título? (para reservar el espacio en las que no)
  assign any_image = false
  assign any_title = false
  for b in section.blocks limit: visible
    if b.settings.image != blank
      assign any_image = true
    endif
    if b.settings.title != blank
      assign any_title = true
    endif
  endfor
  assign unify = s.unify_layout
  assign align_titles = s.align_titles
  assign reserve_title = false
  if unify or align_titles
    assign reserve_title = any_title
  endif

  # Posición vertical del párrafo (sección)
  assign text_valign_default = s.text_valign | default: 'top'

  # Posición del grid
  case s.grid_justify
    when 'center'
      assign grid_justify = 'center'
    when 'right'
      assign grid_justify = 'flex-end'
    else
      assign grid_justify = 'flex-start'
  endcase
  assign grid_align = s.grid_align | default: 'stretch'

  # Alineación de cards (sección)
  assign img_align_default = s.image_alignment | default: 'center'

  assign columns_mobile_int = s.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if s.swipe_on_mobile and visible > columns_mobile_int
    assign show_mobile_slider = true
  endif

  # Márgenes para alinear encabezado / intro (izq, centro, der)
  assign title_align = s.title_alignment | default: 'left'
  assign intro_align = s.intro_alignment | default: 'left'
  assign card_align = s.column_alignment | default: 'left'

  case title_align
    when 'center'
      assign title_ml = 'auto'
      assign title_mr = 'auto'
      assign title_justify = 'center'
    when 'right'
      assign title_ml = 'auto'
      assign title_mr = '0'
      assign title_justify = 'flex-end'
    else
      assign title_ml = '0'
      assign title_mr = 'auto'
      assign title_justify = 'flex-start'
  endcase

  case intro_align
    when 'center'
      assign intro_ml = 'auto'
      assign intro_mr = 'auto'
    when 'right'
      assign intro_ml = 'auto'
      assign intro_mr = '0'
    else
      assign intro_ml = '0'
      assign intro_mr = 'auto'
  endcase

  case s.button_alignment
    when 'left'
      assign btn_justify = 'flex-start'
    when 'right'
      assign btn_justify = 'flex-end'
    else
      assign btn_justify = 'center'
  endcase
-%}

{%- style -%}
  /* ===== Espaciado de sección ===== */
  .section-{{ section.id }}-padding {
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }

  /* ===== Cards con fondo (esquema de color) ===== */
  {%- if s.card_background -%}
  .section-{{ section.id }} .multicolumn-card.mc-card {
    background: rgb(var(--color-background)) !important;
    color: rgb(var(--color-foreground));
    border-radius: {{ s.card_radius }}px !important;
    --mc-pad: {{ s.card_padding | times: 0.75 | round: 0 }}px;
    padding: var(--mc-pad) !important;
    border: 0 !important;
    box-shadow: none !important;
    overflow: hidden;
    height: 100%;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }} .multicolumn-card.mc-card { --mc-pad: {{ s.card_padding }}px; }
  }
  .section-{{ section.id }} .mc-card .multicolumn-card__info { padding: 0 !important; }
  .section-{{ section.id }} .mc-card h3,
  .section-{{ section.id }} .mc-card .rte,
  .section-{{ section.id }} .mc-card .rte *,
  .section-{{ section.id }} .mc-card .link { color: rgb(var(--color-foreground)); }
  {%- else -%}
  .section-{{ section.id }} .multicolumn-card.content-container {
    background: transparent !important;
    box-shadow: none !important;
    border: 0 !important;
  }
  {%- endif -%}
  .section-{{ section.id }} .mc-card__title { margin: 0 0 1.2rem; overflow-wrap: break-word; }
  .section-{{ section.id }} .mc-media-wrap { margin-bottom: {{ s.image_gap | default: 16 }}px !important; }

  /* ===== Tamaños de texto (sección o por card) =====
     Cada card es un "container": el texto se reduce solo cuando la card se hace angosta
     (tablet, laptops chicas) y nunca pasa del tamaño elegido. */
  #Slider-{{ section.id }} > .grid__item { container-type: inline-size; }
  .section-{{ section.id }} .mc-card--ts .mc-card__title {
    font-size: clamp(calc(var(--mc-ts) * 0.72px), calc(var(--mc-ts) * 0.4cqi), calc(var(--mc-ts) * 1px)) !important;
    line-height: 1.15;
  }
  .section-{{ section.id }} .mc-card--ps .multicolumn-card__info .rte,
  .section-{{ section.id }} .mc-card--ps .multicolumn-card__info .rte p,
  .section-{{ section.id }} .mc-card--ps .multicolumn-card__info .rte li,
  .section-{{ section.id }} .mc-card--ps .multicolumn-card__info .link {
    font-size: clamp(calc(var(--mc-ps) * 0.9px), calc(var(--mc-ps) * 0.42cqi), calc(var(--mc-ps) * 1px)) !important;
    line-height: 1.5;
  }

  /* ===== Forma de las cards (rectángulo / cuadrado) ===== */
  {%- liquid
    case s.card_shape
      when 'square'
        assign shape_ratio = '1 / 1'
      when 'rect_h'
        assign shape_ratio = '3 / 2'
      when 'rect_43'
        assign shape_ratio = '4 / 3'
      when 'rect_v'
        assign shape_ratio = '4 / 5'
      else
        assign shape_ratio = ''
    endcase
    assign ccp = s.card_content_position | default: 'spread'
    assign shape_mobile = s.card_shape_mobile | default: 'auto'
    case ccp
      when 'center'
        assign content_justify = 'center'
      when 'bottom'
        assign content_justify = 'flex-end'
      when 'spread'
        assign content_justify = 'space-between'
      else
        assign content_justify = 'flex-start'
    endcase
  -%}
  #Slider-{{ section.id }} > .grid__item { display: flex; flex-direction: column; }
  .section-{{ section.id }} .multicolumn-card {
    display: flex;
    flex-direction: column;
    flex: 1 0 auto;
    justify-content: {{ content_justify }};
    {%- if shape_ratio != '' -%}
    aspect-ratio: {{ shape_ratio }};
    height: auto !important;
    {%- endif -%}
  }
  {%- if shape_ratio != '' and shape_mobile == 'auto' -%}
  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .multicolumn-card { aspect-ratio: auto; }
  }
  {%- endif -%}
  {%- if ccp != 'spread' -%}
  .section-{{ section.id }} .multicolumn-card__info { flex: 0 0 auto !important; }
  .section-{{ section.id }} .multicolumn-card__info > .rte { flex: 0 0 auto !important; }
  .section-{{ section.id }} .multicolumn-card__info > .link { margin-top: 0 !important; }
  {%- endif -%}

  /* ===== Diseño unificado: mismas alturas y elementos alineados ===== */
  {%- if unify -%}
  .section-{{ section.id }} .multicolumn-card { display: flex; flex-direction: column; height: 100%; }
  .section-{{ section.id }} .multicolumn-card__info { display: flex; flex-direction: column; flex: 1 1 auto; }
  .section-{{ section.id }} .multicolumn-card__info > .rte { flex: 1 1 auto; margin-top: 0; }
  .section-{{ section.id }} .multicolumn-card__info > .link { margin-top: auto; padding-top: 1.6rem; align-self: var(--mc-link-align, flex-start); }
  .section-{{ section.id }} .mc-txt--center .multicolumn-card__info > .link { --mc-link-align: center; }
  .section-{{ section.id }} .mc-txt--right .multicolumn-card__info > .link { --mc-link-align: flex-end; }
  {%- if s.title_lines > 0 -%}
  .section-{{ section.id }} .mc-card__title { line-height: 1.15; min-height: calc({{ s.title_lines }} * 1.15em); }
  {%- endif -%}
  .section-{{ section.id }} .mc-media--adapt { aspect-ratio: {% if s.image_mode == 'icon' %}1 / 1{% else %}4 / 3{% endif %}; }
  .section-{{ section.id }} .mc-media--adapt img { height: 100%; }
  .section-{{ section.id }} .mc-media-wrap--empty { visibility: hidden; display: block !important; }
  .section-{{ section.id }} .mc-media-wrap--empty .mc-media { display: block !important; width: 100%;{% if s.image_mode == 'icon' %} height: {{ s.icon_size }}px;{% endif %} }
  {%- endif -%}

  /* ===== Posición vertical del párrafo dentro de la card (arriba / en medio / abajo) =====
     El párrafo ocupa el espacio libre entre el título y el enlace, y se acomoda ahí. */
  .section-{{ section.id }} .mc-tv--center .multicolumn-card__info,
  .section-{{ section.id }} .mc-tv--bottom .multicolumn-card__info { display: flex; flex-direction: column; flex: 1 1 auto; }
  .section-{{ section.id }} .mc-tv--center .multicolumn-card__info > .rte,
  .section-{{ section.id }} .mc-tv--bottom .multicolumn-card__info > .rte {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    margin-top: 0;
  }
  .section-{{ section.id }} .mc-tv--center .multicolumn-card__info > .rte { justify-content: center; }
  .section-{{ section.id }} .mc-tv--bottom .multicolumn-card__info > .rte { justify-content: flex-end; }
  .section-{{ section.id }} .mc-tv--center .multicolumn-card__info > .rte > *,
  .section-{{ section.id }} .mc-tv--bottom .multicolumn-card__info > .rte > * { flex: 0 0 auto; }
  .section-{{ section.id }} .mc-tv--center .multicolumn-card__info > .rte > :last-child,
  .section-{{ section.id }} .mc-tv--bottom .multicolumn-card__info > .rte > :last-child { margin-bottom: 0; }

  /* ===== Imagen / ícono de card ===== */
  .section-{{ section.id }} .mc-media-wrap {
    width: 100%;
    max-width: var(--mc-img-size, {% if s.image_mode == 'icon' %}{{ s.icon_size }}px{% else %}{{ s.image_width_percent | default: 100 }}%{% endif %});
    margin: 0 auto 1.6rem;
  }
  .section-{{ section.id }} .mc-img--left .mc-media-wrap { margin-left: 0; margin-right: auto; }
  .section-{{ section.id }} .mc-img--center .mc-media-wrap { margin-left: auto; margin-right: auto; }
  .section-{{ section.id }} .mc-img--right .mc-media-wrap { margin-left: auto; margin-right: 0; }
  .section-{{ section.id }} .mc-media { position: relative; overflow: hidden; border-radius: {{ s.image_radius }}px; }
  .section-{{ section.id }} .mc-media img { display: block; width: 100%; height: auto; }
  .section-{{ section.id }} .mc-media--square,
  .section-{{ section.id }} .mc-media--circle { aspect-ratio: 1 / 1; }
  .section-{{ section.id }} .mc-media--portrait { aspect-ratio: 4 / 5; }
  .section-{{ section.id }} .mc-media--landscape { aspect-ratio: 4 / 3; }
  .section-{{ section.id }} .mc-media--circle { border-radius: 50%; }
  .section-{{ section.id }} .mc-media--wide { aspect-ratio: 16 / 9; }
  .section-{{ section.id }} .mc-media--classic { aspect-ratio: 3 / 2; }
  .section-{{ section.id }} .mc-media--fixed { height: {{ s.image_height | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }} .mc-media--fixed { height: {{ s.image_height }}px; }
  }
  .section-{{ section.id }} .mc-media:not(.mc-media--adapt) img { height: 100%; }
  .section-{{ section.id }} .mc-media img {
    object-fit: var(--mc-fit, {% if s.image_mode == 'icon' %}contain{% else %}{{ s.image_fit | default: 'cover' }}{% endif %});
    object-position: var(--mc-pos, center center);
  }
  {%- if s.image_contain_bg -%}
  .section-{{ section.id }} .mc-media--has-bg { background: rgba(var(--color-foreground), 0.06); }
  {%- endif -%}

  /* Imagen de borde a borde dentro de la card */
  {%- if s.image_bleed and s.card_background and s.image_mode == 'image' -%}
  .section-{{ section.id }} .mc-card .mc-media-wrap {
    width: calc(100% + 2 * var(--mc-pad)) !important;
    max-width: none !important;
    margin: calc(-1 * var(--mc-pad)) calc(-1 * var(--mc-pad)) {{ s.image_gap | default: 16 }}px !important;
  }
  .section-{{ section.id }} .mc-card .mc-media { border-radius: 0; }
  {%- endif -%}

  /* ===== Fuente de descripción por card ===== */
  .section-{{ section.id }} .mc-desc--body { font-family: var(--font-body-family); font-weight: 400; }
  .section-{{ section.id }} .mc-desc--mono {
    font-family: "IBM Plex Mono", "Courier New", Courier, monospace !important;
    font-weight: 400; letter-spacing: .02em; padding-top: 1rem; line-height: 1.5rem; text-transform: uppercase;
  }
  .section-{{ section.id }} .mc-desc--mono *,
  .section-{{ section.id }} .mc-desc--body * {
    font-family: inherit !important; font-weight: inherit; letter-spacing: inherit;
  }

  /* ===== Encabezado: eyebrow + título (alineación editable) ===== */
  @media screen and (max-width: 749px) {
    /* Same side gutter as the self-padded title on mobile */
    .section-{{ section.id }} .tdm-section-eyebrow { padding: 0 1.5rem; }
  }
  #shopify-section-{{ section.id }} .title-wrapper-with-link {
    width: 100%;
    max-width: {{ s.header_max_width | default: 50 }}%;
    margin-left: {{ title_ml }};
    margin-right: {{ title_mr }};
    margin-bottom: 1rem;
    justify-content: {{ title_justify }};
    text-align: {{ title_align }};
  }
  #shopify-section-{{ section.id }} .title-wrapper-with-link .title { width: 100%; text-align: {{ title_align }}; }

  /* ===== Párrafo intro (alineación editable) ===== */
  .section-{{ section.id }} .multicolumn__intro {
    width: 100%;
    max-width: {{ s.header_max_width | default: 50 }}%;
    margin: 0.5rem {{ intro_mr }} 1.5rem {{ intro_ml }};
    text-align: {{ intro_align }};
    color: rgb(var(--color-foreground, 18,18,18));
    font: inherit;
    line-height: var(--font-body-line-height, 1.6);
  }
  .section-{{ section.id }} .multicolumn__intro p { margin: 0; }
  @media (min-width: 750px) {
    .section-{{ section.id }} .multicolumn__intro { margin-top: 0.75rem; margin-bottom: 2rem; }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .title-wrapper-with-link,
    .section-{{ section.id }} .multicolumn__intro { max-width: 100%; }
    .section-{{ section.id }} .title-wrapper--self-padded-tablet-down,
    .section-{{ section.id }} .title-wrapper--self-padded-mobile { padding: 0; }
  }

  /* ===== Cards: alineación (izq / centro / der) ===== */
  #shopify-section-{{ section.id }} .multicolumn-card-spacing { padding-bottom: 1rem !important; }
  /* Alineación de texto por card (izq / centro / der) */
  .section-{{ section.id }} .mc-txt--left .multicolumn-card__info { text-align: left !important; }
  .section-{{ section.id }} .mc-txt--center .multicolumn-card__info { text-align: center !important; }
  .section-{{ section.id }} .mc-txt--right .multicolumn-card__info { text-align: right !important; }

  /* ===== Posición del grid ===== */
  #Slider-{{ section.id }} {
    justify-content: {{ grid_justify }};
    align-items: {{ grid_align }};
    {%- unless s.use_theme_spacing -%}
    --grid-desktop-horizontal-spacing: {{ s.gap_horizontal }}px;
    --grid-desktop-vertical-spacing: {{ s.gap_vertical }}px;
    --grid-mobile-horizontal-spacing: {{ s.gap_horizontal | divided_by: 2 }}px;
    --grid-mobile-vertical-spacing: {{ s.gap_vertical | divided_by: 2 }}px;
    {%- endunless -%}
  }
  {%- if show_mobile_slider -%}
  @media (max-width: 749px) { #Slider-{{ section.id }} { justify-content: flex-start; } }
  {%- endif -%}
  {%- if grid_align != 'stretch' -%}
  #Slider-{{ section.id }} .multicolumn-card { height: auto; }
  {%- endif -%}

  /* ===== Tablet (750–989px): columnas editables ===== */
  @media (min-width: 750px) and (max-width: 989px) {
    #Slider-{{ section.id }} {
      display: flex !important;
      flex-wrap: wrap !important;
      overflow: visible !important;
      column-gap: var(--grid-desktop-horizontal-spacing, 16px) !important;
      row-gap: var(--grid-desktop-vertical-spacing, 16px) !important;
    }
    #Slider-{{ section.id }} > .grid__item {
      width: calc((100% - {{ cols_tablet | minus: 1 }} * var(--grid-desktop-horizontal-spacing, 16px)) / {{ cols_tablet }}) !important;
      max-width: calc((100% - {{ cols_tablet | minus: 1 }} * var(--grid-desktop-horizontal-spacing, 16px)) / {{ cols_tablet }}) !important;
      flex: 0 0 auto !important;
    }
  }

  /* ===== CTA general ===== */
  .section-{{ section.id }} .mc-cta {
    display: flex;
    justify-content: {{ btn_justify }};
    margin-top: 3.2rem;
  }
  .section-{{ section.id }} .mc-cta .button {
    background-color: rgba(var(--color-button), var(--alpha-button-background));
    color: rgb(var(--color-button-text));
    margin: 0;
  }
  {%- if s.button_pill -%}
  .section-{{ section.id }} .mc-cta .button { --buttons-radius: 999px; --buttons-radius-outset: 999px; border-radius: 999px; }
  {%- endif -%}
{%- endstyle -%}

<div class="multicolumn color-{{ s.color_scheme }} gradient{% unless s.background_style == 'none' and settings.text_boxes_border_thickness > 0 or settings.text_boxes_shadow_opacity > 0 %} background-{{ s.background_style }}{% endunless %}{% if s.title == blank %} no-heading{% endif %}">
  <div
    class="section-{{ section.id }} page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {% render 'tdm-section-eyebrow', text: s.pretitle, rule_color: s.rule_color, align: title_align %}

    {%- unless s.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title">
        <h2 class="title inline-richtext {{ s.heading_size }}">
          {{ s.title }}
        </h2>
      </div>
    {%- endunless -%}

    {%- if s.intro_paragraph != blank -%}
      <div class="multicolumn__intro rte">
        {{ s.intro_paragraph }}
      </div>
    {%- endif -%}

    <slider-component class="slider-mobile-gutter">
      <ul
        class="multicolumn-list contains-content-container grid grid--{{ s.columns_mobile }}-col-tablet-down grid--{{ cols_desktop }}-col-desktop{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- liquid
          assign highest_ratio = 0
          for block in section.blocks
            if block.settings.image != blank and block.settings.image.aspect_ratio
              if block.settings.image.aspect_ratio > highest_ratio
                assign highest_ratio = block.settings.image.aspect_ratio
              endif
            endif
          endfor
          if highest_ratio == 0
            assign highest_ratio = 1
          endif
        -%}
        {%- for block in section.blocks limit: visible -%}
          {%- liquid
            assign empty_column = ''
            assign img_align = block.settings.image_alignment_override | default: 'section'
            if img_align == 'section'
              assign img_align = img_align_default
            endif
            assign txt_align = block.settings.text_alignment_override | default: 'section'
            if txt_align == 'section'
              assign txt_align = card_align
            endif

            # Posición vertical del párrafo: card > sección
            assign txt_valign = block.settings.text_valign_override | default: 'section'
            if txt_valign == 'section'
              assign txt_valign = text_valign_default
            endif

            # Tamaños de texto: card > sección (0 = no forzar)
            assign t_size = block.settings.title_size | default: 0
            if t_size == 0 and s.custom_text_sizes
              assign t_size = s.card_title_size
            endif
            assign p_size = block.settings.text_size | default: 0
            if p_size == 0 and s.custom_text_sizes
              assign p_size = s.card_text_size
            endif
            assign card_style = ''
            if t_size > 0
              assign card_style = card_style | append: '--mc-ts: ' | append: t_size | append: ';'
            endif
            if p_size > 0
              assign card_style = card_style | append: '--mc-ps: ' | append: p_size | append: ';'
            endif

            # Título sin espacios duros al inicio (evita que se vea desalineado)
            assign card_title = block.settings.title | strip
            for i in (1..5)
              assign head6 = card_title | slice: 0, 6
              assign head1 = card_title | slice: 0
              if head6 == '&nbsp;'
                assign card_title = card_title | remove_first: '&nbsp;' | strip
              elsif head1 == ' '
                assign card_title = card_title | remove_first: ' ' | strip
              else
                break
              endif
            endfor
          -%}
          {%- if block.settings.image == blank
            and block.settings.title == blank
            and block.settings.text == blank
            and block.settings.link_label == blank
          -%}
            {%- assign empty_column = ' multicolumn-list__item--empty' -%}
          {%- endif -%}

          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="{% if s.mobile_side_line %}multicolumn-list__item{% else %}mc-list__item{% endif %} grid__item mc-img--{{ img_align }} mc-txt--{{ txt_align }}{% if s.swipe_on_mobile %} slider__slide{% endif %}{{ empty_column }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {%- liquid
              assign card_scheme = s.card_color_scheme
              if block.settings.use_custom_scheme
                assign card_scheme = block.settings.card_color_scheme
              endif
            -%}
            <div
              class="multicolumn-card content-container mc-tv--{{ txt_valign }}{% if t_size > 0 %} mc-card--ts{% endif %}{% if p_size > 0 %} mc-card--ps{% endif %}{% if s.card_background %} mc-card color-{{ card_scheme }}{% endif %}"
              {% if card_style != '' %}
                style="{{ card_style }}"
              {% endif %}
            >
              {%- if block.settings.image != blank -%}
                {%- liquid
                  assign number_of_columns = cols_desktop
                  assign number_of_columns_mobile = s.columns_mobile
                  if s.image_mode == 'icon'
                    assign img_px = s.icon_size | times: 2
                    capture sizes
                      echo s.icon_size | append: 'px'
                    endcapture
                  else
                    assign img_px = 1600
                    assign pct = s.image_width_percent | divided_by: 100.0
                    capture sizes
                      echo '(min-width: 990px) calc(100vw * ' | append: pct | append: ' / ' | append: number_of_columns | append: '), '
                      echo '(min-width: 750px) calc(100vw * ' | append: pct | append: ' / ' | append: cols_tablet | append: '), '
                      echo 'calc(100vw * ' | append: pct | append: ' / ' | append: number_of_columns_mobile | append: ')'
                    endcapture
                  endif
                -%}
                {%- liquid
                  # Ajuste (cubrir / contener) por card
                  assign fit = block.settings.image_fit_override | default: 'section'
                  if fit == 'section'
                    if s.image_mode == 'icon'
                      assign fit = 'contain'
                    else
                      assign fit = s.image_fit | default: 'cover'
                    endif
                  endif

                  # Posición: punto focal de Shopify o vertical elegida + alineación horizontal
                  assign pos_v = block.settings.image_position_override | default: 'section'
                  if pos_v == 'section'
                    assign pos_v = s.image_position | default: 'focal'
                  endif
                  case img_align
                    when 'left'
                      assign pos_h = 'left'
                    when 'right'
                      assign pos_h = 'right'
                    else
                      assign pos_h = 'center'
                  endcase
                  if pos_v == 'focal' and block.settings.image.presentation.focal_point != blank
                    assign pos = block.settings.image.presentation.focal_point
                  elsif pos_v == 'focal'
                    assign pos = pos_h | append: ' center'
                  else
                    assign pos = pos_h | append: ' ' | append: pos_v
                  endif

                  assign has_bg = false
                  if fit == 'contain' and s.image_mode == 'image'
                    assign has_bg = true
                  endif
                -%}
                <div class="mc-media-wrap"{% if block.settings.image_size > 0 %} style="--mc-img-size: {{ block.settings.image_size }}px;"{% endif %}>
                  <div class="mc-media mc-media--{{ s.image_ratio }}{% if has_bg %} mc-media--has-bg{% endif %}" style="--mc-fit: {{ fit }}; --mc-pos: {{ pos }};">
                    {{
                      block.settings.image
                      | image_url: width: img_px
                      | image_tag:
                        widths: '80, 160, 300, 500, 750, 1000, 1300, 1600',
                        sizes: sizes,
                        loading: 'lazy',
                        class: 'multicolumn-card__image'
                    }}
                  </div>
                </div>
              {%- elsif unify and any_image -%}
                <div class="mc-media-wrap mc-media-wrap--empty" aria-hidden="true">
                  <div class="mc-media mc-media--{{ s.image_ratio }}">&nbsp;</div>
                </div>
              {%- endif -%}
              <div class="multicolumn-card__info">
                {%- if card_title != blank -%}
                  <h3 class="inline-richtext mc-card__title {{ s.card_heading_size | default: 'h3' }}">{{ card_title }}</h3>
                {%- elsif reserve_title -%}
                  <div class="mc-card__title mc-card__title--empty {{ s.card_heading_size | default: 'h3' }}" aria-hidden="true"></div>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte {{ block.settings.desc_font | default: 'body' | prepend: 'mc-desc--' }}">
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}
                {%- if block.settings.link_label != blank -%}
                  <a
                    class="link animate-arrow"
                    {% if block.settings.link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.link }}"
                    {% endif %}
                  >
                    {{- block.settings.link_label | escape -}}
                    <span class="svg-wrapper"
                      ><span class="icon-wrap">&nbsp;{{ 'icon-arrow.svg' | inline_asset_content }}</span></span
                    >
                  </a>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider -%}
        <div class="slider-buttons large-up-hide">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ visible }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>

    {%- if s.button_label != blank -%}
      <div class="mc-cta">
        <a
          class="button button--{{ s.button_style | default: 'primary' }} color-{{ s.button_color_scheme }}"
          {% if s.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ s.button_link }}"
          {% endif %}
          {% if s.button_new_tab %}target="_blank" rel="noopener"{% endif %}
        >
          {{ s.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{%- if align_titles -%}
  <script>
    /* Iguala la altura de los títulos de las cards que quedan en la misma fila
       para que los párrafos empiecen a la misma altura, en cualquier ancho de pantalla. */
    (function () {
      var listId = 'Slider-{{ section.id }}';
      var lastWidth = -1;
      var raf = 0;

      function equalize() {
        var list = document.getElementById(listId);
        if (!list) return;
        var titles = Array.prototype.slice.call(list.querySelectorAll('.mc-card__title'));
        titles.forEach(function (t) { t.style.minHeight = ''; });

        var rows = {};
        titles.forEach(function (t) {
          var li = t.closest('.grid__item');
          if (!li) return;
          var key = String(Math.round(li.offsetTop));
          (rows[key] = rows[key] || []).push(t);
        });

        Object.keys(rows).forEach(function (key) {
          var group = rows[key];
          if (group.length < 2) return;
          var max = 0;
          group.forEach(function (t) { max = Math.max(max, t.getBoundingClientRect().height); });
          group.forEach(function (t) { t.style.minHeight = Math.ceil(max) + 'px'; });
        });
      }

      function schedule() {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(equalize);
      }

      function init() {
        var list = document.getElementById(listId);
        if (!list) return;
        schedule();
        if ('ResizeObserver' in window) {
          new ResizeObserver(function (entries) {
            var w = Math.round(entries[0].contentRect.width);
            if (w === lastWidth) return;
            lastWidth = w;
            schedule();
          }).observe(list);
        } else {
          window.addEventListener('resize', schedule);
        }
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(schedule);
        window.addEventListener('load', schedule);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
{%- endif -%}

