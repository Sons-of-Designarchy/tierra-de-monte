{% render 'tdm-anchor', id: section.settings.anchor_id %}
{{ 'pr-section-tdm-ticker.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign base_speed = section.settings.speed | default: 36
  assign speed = base_speed
  assign t_font = 'body'
  assign is_light = false
  if section.settings.style == 'light'
    assign is_light = true
  endif
  if is_light
    assign t_font = 'body'
  elsif section.settings.font_variant == 'mono'
    assign speed = base_speed | plus: 8
    assign t_font = 'mono'
  elsif section.settings.typography_variant == 'primary'
    assign t_font = 'display'
  endif

  assign fs = section.settings.font_size | default: 22
  capture t_variant_raw
    render 'tdm-type-from-px', px: fs
  endcapture
  assign t_variant = t_variant_raw | strip

  assign t_class = 'tdm-ticker__text'
  assign t_weight = 'regular'
  assign root_classes = 'tdm-ticker'
  if is_light
    assign t_variant = 'display'
    assign t_weight = 'light'
    assign root_classes = root_classes | append: ' tdm-ticker--light'
  endif
  if section.settings.icon != blank
    assign root_classes = root_classes | append: ' tdm-ticker--has-icon'
  endif
  if section.settings.text_transform == 'title'
    assign root_classes = root_classes | append: ' tdm-ticker--transform-title'
  endif
  if section.settings.letter_spacing > 0
    assign root_classes = root_classes | append: ' tdm-ticker--tracked'
  endif

  assign copy = section.settings.text | strip | default: 'VIDA QUE GENERA VIDA'
-%}

{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

<div class="section-{{ section.id }}-padding">
<section
  class="{{ root_classes }}"
  style="--ticker-speed: {{ speed }}s; --ticker-h: {{ section.settings.height | default: 100 }}px; --ticker-icon-h: {{ section.settings.icon_height | default: 32 }}px; --ticker-ink: {{ section.settings.text_color | default: '#F3EFCF' }}; --ticker-bg: {{ section.settings.bg_color | default: 'transparent' }};{% if section.settings.letter_spacing > 0 %} --ticker-tracking: {{ section.settings.letter_spacing | divided_by: 100.0 }}em;{% endif %}"
>
  {% if section.settings.bg_image != blank %}
    <img
      class="tdm-ticker__img"
      src="{{ section.settings.bg_image | image_url: width: 2880 }}"
      alt=""
      width="{{ section.settings.bg_image.width }}"
      height="{{ section.settings.bg_image.height }}"
      loading="lazy"
      aria-hidden="true"
    >
  {% endif %}

  <div class="tdm-ticker__layer">
    <div class="tdm-ticker__marquee">
      <div class="tdm-ticker__track">
        {%- for chunk in (1..2) -%}
          <span class="tdm-ticker__chunk"{% if chunk == 2 %} aria-hidden="true"{% endif %}>
            {%- for i in (1..10) -%}
              <span class="tdm-ticker__item">
                {%- if section.settings.icon != blank -%}
                  <img
                    alt=""
                    class="tdm-ticker__icon"
                    src="{{ section.settings.icon | image_url }}"
                    width="{{ section.settings.icon.width }}"
                    height="{{ section.settings.icon.height }}"
                    loading="lazy"
                  >
                {%- endif -%}
                {%- render 'typography', text: copy, as: 'span', variant: t_variant, font: t_font, weight: t_weight, color: 'inherit', class: t_class -%}
              </span>
            {%- endfor -%}
          </span>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "PR · Infinite Ticker",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "ID de ancla",
      "info": "Para enlazar a esta sección desde un botón. 1 o 2 palabras en español separadas por guion, ej. formulario o como-funciona. Enlace: /pages/aliados#formulario"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Estilo",
      "options": [
        { "value": "photo", "label": "Con foto: mono en mayúsculas" },
        { "value": "light", "label": "Secundario: texto grande, fondo claro, líneas" }
      ],
      "default": "photo"
    },
    { "type": "text", "id": "text", "label": "Text", "default": "VIDA QUE GENERA VIDA" },
    { "type": "image_picker", "id": "icon", "label": "Icon" },
    {
      "type": "range",
      "id": "icon_height",
      "label": "Icon height (px)",
      "min": 12,
      "max": 55,
      "step": 1,
      "default": 32
    },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#00000000" },

    { "type": "color", "id": "text_color", "label": "Ticker text color", "default": "#F3EFCF" },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size (px)",
      "min": 12,
      "max": 100,
      "step": 1,
      "default": 22
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "title", "label": "Title Case" },
        { "value": "none", "label": "None" }
      ],
      "default": "uppercase"
    },

    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "info": "0 keeps each font style's default. Above 0 sets the spacing in hundredths of an em.",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0
    },

    {
      "type": "select",
      "id": "typography_variant",
      "label": "Typography",
      "options": [
        { "value": "primary", "label": "Heading font" },
        { "value": "secondary", "label": "Body font" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "font_variant",
      "label": "Font style",
      "options": [
        { "value": "normal", "label": "Normal (theme font)" },
        { "value": "mono", "label": "Monospace (IBMPlexMono-Light)" }
      ],
      "default": "normal"
    },

    {
      "type": "range",
      "id": "speed",
      "label": "Scroll duration (slower = bigger, seconds)",
      "min": 12,
      "max": 80,
      "step": 1,
      "default": 36
    },

    {
      "type": "range",
      "id": "height",
      "label": "Section height (px)",
      "min": 60,
      "max": 200,
      "step": 5,
      "default": 100
    },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0, "label": "Espaciado superior" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0, "label": "Espaciado inferior", "info": "En móvil se aplica al 75%, igual que el resto de secciones." }
  ],
  "presets": [{ "name": "Infinite Ticker" }]
}
{% endschema %}
