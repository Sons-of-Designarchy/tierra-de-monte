{% render 'tdm-anchor', id: section.settings.anchor_id %}
{{ 'section-tdm-rich-text.css' | asset_url | stylesheet_tag }}
{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- liquid
  assign width_class = ''
  if section.settings.content_width != blank and section.settings.content_width != 'auto'
    assign width_class = ' rich-text__blocks--' | append: section.settings.content_width
  endif
  assign logo_alt = section.settings.logo_alt | default: 'Section logo'
  assign body_font = 'body'
  if section.settings.mono_body
    assign body_font = 'mono'
  endif
  assign heading_font = 'display'
  if section.settings.mono_heading
    assign heading_font = 'mono'
  endif
-%}

<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
  <div
    class="rich-text content-container color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} rich-text--full-width content-container--full-width{% endif %} section-{{ section.id }}-padding{% if section.settings.bg_image != blank %} tdm-has-bg{% endif %}"
    {% if section.settings.logo != blank %}style="--rt-logo-w: {{ section.settings.logo_width | default: 120 }}px;"{% endif %}
  >
    {% render 'tdm-section-background', image: section.settings.bg_image, image_mobile: section.settings.bg_image_mobile, overlay: section.settings.bg_overlay, position: section.settings.bg_position %}
    {%- comment -%} Eyebrow spans the full page width, outside the narrow text column {%- endcomment -%}
    {%- if section.settings.eyebrow != blank -%}
      <div class="{% if section.settings.full_width %}page-width{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- render 'section-header', eyebrow: section.settings.eyebrow, align: section.settings.content_alignment -%}
      </div>
    {%- endif -%}
    <div class="rich-text__wrapper rich-text__wrapper--{{ section.settings.desktop_content_position }}{% if section.settings.full_width %} page-width{% endif %}">
      <div class="rich-text__blocks {{ section.settings.content_alignment }}{{ width_class }}">
        {%- if section.settings.logo != blank -%}
          <div class="rich-text__logo">
            {{-
              section.settings.logo
              | image_url: width: 1100
              | image_tag: alt: logo_alt, loading: 'lazy', class: 'rich-text__logo-img'
            -}}
          </div>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- assign reveal = '' -%}
          {%- if settings.animations_reveal_on_scroll -%}
            {%- assign reveal = ' scroll-trigger animate--slide-in' -%}
          {%- endif -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              {%- assign heading_variant = 'h1' -%}
              {%- case block.settings.heading_size -%}
                {%- when 'h3' -%}{%- assign heading_variant = 'h3' -%}
                {%- when 'h2' -%}{%- assign heading_variant = 'h2' -%}
                {%- when 'h0' or 'hxl' or 'hxxl' -%}{%- assign heading_variant = 'display' -%}
              {%- endcase -%}
              {%- assign heading_tag = block.settings.heading_tag | default: 'h2' -%}
              {%- capture heading_attrs -%}{{ block.shopify_attributes }}{% if settings.animations_reveal_on_scroll %} data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}{%- endcapture -%}
              {% render 'typography', text: block.settings.heading, variant: heading_variant, as: heading_tag, font: heading_font, weight: 'medium', class: 'rich-text__heading rte inline-richtext', attrs: heading_attrs %}
            {%- when 'caption' -%}
              {%- assign caption_text = block.settings.caption | escape -%}
              {%- capture caption_attrs -%}{{ block.shopify_attributes }}{% if settings.animations_reveal_on_scroll %} data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}{%- endcapture -%}
              {%- if block.settings.text_style == 'subtitle' -%}
                {%- assign caption_variant = 'body' -%}
                {%- if block.settings.text_size == 'small' -%}{%- assign caption_variant = 'body-sm' -%}{%- elsif block.settings.text_size == 'large' -%}{%- assign caption_variant = 'body-lg' -%}{%- endif -%}
                {% render 'typography', text: caption_text, variant: caption_variant, color: 'secondary', class: 'rich-text__caption', attrs: caption_attrs %}
              {%- else -%}
                {% render 'typography', text: caption_text, variant: 'eyebrow', font: 'body', color: 'secondary', class: 'rich-text__caption', attrs: caption_attrs %}
              {%- endif -%}
            {%- when 'text' -%}
              {%- capture text_attrs -%}{{ block.shopify_attributes }}{% if settings.animations_reveal_on_scroll %} data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}{%- endcapture -%}
              {% render 'typography', text: block.settings.text, variant: 'body', as: 'div', font: body_font, class: 'rich-text__text rte', attrs: text_attrs %}
            {%- when 'button' -%}
              <div
                class="rich-text__buttons{% if block.settings.button_label != blank and block.settings.button_label_2 != blank %} rich-text__buttons--multiple{% endif %}{{ reveal }}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {%- if block.settings.button_label != blank -%}
                  {%- assign button_variant = 'primary' -%}
                  {%- if block.settings.button_style_secondary -%}{%- assign button_variant = 'outline' -%}{%- endif -%}
                  {% render 'button', label: block.settings.button_label, href: block.settings.button_link, variant: button_variant, size: 'md' %}
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  {%- assign button_variant_2 = 'primary' -%}
                  {%- if block.settings.button_style_secondary_2 -%}{%- assign button_variant_2 = 'outline' -%}{%- endif -%}
                  {% render 'button', label: block.settings.button_label_2, href: block.settings.button_link_2, variant: button_variant_2, size: 'md' %}
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "ID de ancla",
      "info": "Para enlazar a esta sección desde un botón. 1 o 2 palabras en español separadas por guion, ej. formulario o como-funciona. Enlace: /pages/aliados#formulario"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Texto pequeño arriba del contenido. La línea aparece solo si hay texto."
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.desktop_content_position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.desktop_content_position.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.desktop_content_position.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.desktop_content_position.label"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.content_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.content_alignment.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    { "type": "header", "content": "Imagen de fondo" },
    { "type": "image_picker", "id": "bg_image", "label": "Imagen de fondo" },
    { "type": "image_picker", "id": "bg_image_mobile", "label": "Imagen de fondo (móvil)", "info": "Opcional. Si está vacía usa la de escritorio." },
    { "type": "range", "id": "bg_overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Oscurecer imagen", "default": 40 },
    { "type": "select", "id": "bg_position", "label": "Enfoque de la imagen", "default": "center", "options": [
      { "value": "top", "label": "Arriba" }, { "value": "center", "label": "Centro" }, { "value": "bottom", "label": "Abajo" }
    ] },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        { "value": "auto", "label": "Automatic" },
        { "value": "narrow", "label": "Narrow" },
        { "value": "default", "label": "Default" },
        { "value": "wide", "label": "Wide" }
      ],
      "default": "auto"
    },
    { "type": "checkbox", "id": "mono_heading", "label": "Use monospaced font for headings", "default": false },
    { "type": "checkbox", "id": "mono_body", "label": "Use monospaced font for text", "default": false },
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo (top)" },
    { "type": "text", "id": "logo_alt", "label": "Logo alt text", "default": "Section logo" },
    {
      "type": "range",
      "id": "logo_width",
      "min": 24,
      "max": 320,
      "step": 4,
      "unit": "px",
      "label": "Logo width",
      "default": 120
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.rich-text.blocks.heading.name",
      "limit": 3,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.rich-text.blocks.heading.settings.heading.default",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__4.label"
            },
            {
              "value": "hxxl",
              "label": "t:sections.all.heading_size.options__5.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading HTML tag",
          "options": [
            { "value": "h1", "label": "H1" },
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "caption",
      "name": "t:sections.rich-text.blocks.caption.name",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "default": "t:sections.rich-text.blocks.caption.settings.text.default",
          "label": "t:sections.rich-text.blocks.caption.settings.text.label"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "subtitle",
              "label": "t:sections.rich-text.blocks.caption.settings.text_style.options__1.label"
            },
            {
              "value": "caption-with-letter-spacing",
              "label": "t:sections.rich-text.blocks.caption.settings.text_style.options__2.label"
            }
          ],
          "default": "caption-with-letter-spacing",
          "label": "t:sections.rich-text.blocks.caption.settings.text_style.label"
        },
        {
          "type": "select",
          "id": "text_size",
          "options": [
            {
              "value": "small",
              "label": "t:sections.rich-text.blocks.caption.settings.caption_size.options__1.label"
            },
            {
              "value": "medium",
              "label": "t:sections.rich-text.blocks.caption.settings.caption_size.options__2.label"
            },
            {
              "value": "large",
              "label": "t:sections.rich-text.blocks.caption.settings.caption_size.options__3.label"
            }
          ],
          "default": "medium",
          "label": "t:sections.rich-text.blocks.caption.settings.caption_size.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich-text.blocks.text.name",
      "limit": 3,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "t:sections.rich-text.blocks.text.settings.text.default",
          "label": "t:sections.rich-text.blocks.text.settings.text.label"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.rich-text.blocks.buttons.name",
      "limit": 2,
      "settings": [
        {
         "type": "header",
         "content": "t:sections.rich-text.blocks.buttons.settings.header_button1.content"
        },        
        {
          "type": "text",
          "id": "button_label",
          "default": "t:sections.rich-text.blocks.buttons.settings.button_label_1.default",
          "label": "t:sections.rich-text.blocks.buttons.settings.button_label_1.label",
          "info": "t:sections.rich-text.blocks.buttons.settings.button_label_1.info"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.rich-text.blocks.buttons.settings.button_link_1.label"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary",
          "default": false,
          "label": "t:sections.rich-text.blocks.buttons.settings.button_style_secondary_1.label"
        },
        {
         "type": "header",
         "content": "t:sections.rich-text.blocks.buttons.settings.header_button2.content"
        },          
        {
          "type": "text",
          "id": "button_label_2",
          "label": "t:sections.rich-text.blocks.buttons.settings.button_label_2.label",
          "info": "t:sections.rich-text.blocks.buttons.settings.button_label_2.info"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "t:sections.rich-text.blocks.buttons.settings.button_link_2.label"
        },
        {
          "type": "checkbox",
          "id": "button_style_secondary_2",
          "default": false,
          "label": "t:sections.rich-text.blocks.buttons.settings.button_style_secondary_2.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich-text.presets.name",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
