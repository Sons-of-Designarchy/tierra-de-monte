{% comment %}
  SECTION: custom-breadcrumb-blog
  Back link + mono uppercase crumb trail. Styles: assets/section-tdm-breadcrumb.css.
{% endcomment %}

{%- assign has_context = false -%}
{%- if article and blog -%}
  {%- assign has_context = true -%}
{%- endif -%}

{{ 'section-tdm-breadcrumb.css' | asset_url | stylesheet_tag }}
{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

<section class="tdm-breadcrumb section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="cbb__bar">
    <div class="page-width">
      <div class="cbb__inner">
        {%- assign cbb_back_label = section.settings.back_label | default: 'Back' -%}
        {%- if has_context -%}
          {%- assign cbb_back_url = blog.url -%}
        {%- else -%}
          {%- assign cbb_back_url = '/blogs' -%}
        {%- endif -%}
        {% render 'button', label: cbb_back_label, href: cbb_back_url, variant: 'outline', size: 'md', icon: 'arrow-left', class: 'cbb__back' %}

        {%- if has_context -%}
          {%- capture cbb_items -%}
            {{- blog.title | replace: ';', ',' | replace: '|', '-' -}}|{{- blog.url -}};{{- article.title | truncate: 60 | replace: ';', ',' | replace: '|', '-' -}}
          {%- endcapture -%}
          {% render 'breadcrumb', items: cbb_items, class: 'cbb__crumbs' %}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom breadcrumb — blog",
  "class": "section section--custom-breadcrumb-blog",
  "settings": [
    { "type": "text", "id": "back_label", "label": "Back button label", "default": "Back" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 12
    }
  ],
  "presets": [{ "name": "Custom breadcrumb — blog" }]
}
{% endschema %}
