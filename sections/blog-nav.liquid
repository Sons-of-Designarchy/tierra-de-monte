{% comment %}
  Blog Nav — page title (display) with the category links as the tabs atom below. Styles: assets/section-tdm-blog-nav.css.
{% endcomment %}

{{ 'section-tdm-blog-nav.css' | asset_url | stylesheet_tag }}
{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- liquid
  assign bn_labels = ''
  assign bn_hrefs = ''
  assign bn_active = 0
  assign bn_n = 0
  for block in section.blocks
    assign chosen_blog = blogs[block.settings.blog]
    if chosen_blog
      assign bn_n = bn_n | plus: 1
      assign bn_label = block.settings.title | default: chosen_blog.title
      assign bn_labels = bn_labels | append: bn_label | append: '|'
      assign bn_hrefs = bn_hrefs | append: chosen_blog.url | append: '|'
      if request.page_type == 'blog' and blog and blog.id == chosen_blog.id
        assign bn_active = bn_n
      endif
    endif
  endfor
  if bn_active == 0 and request.page_type == 'page'
    assign bn_active = 1
  endif
  assign bn_labels = bn_labels | split: '|' | join: '|'
  assign bn_hrefs = bn_hrefs | split: '|' | join: '|'
  assign bn_aria = section.settings.label | strip_html | default: 'Explora nuestro blog'
-%}

<section class="tdm-blog-nav color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="blog-nav__bar">
      {%- if section.settings.label != blank -%}
        {% render 'typography', text: section.settings.label, as: 'h1', variant: 'display', font: 'display', weight: 'medium', align: 'center', class: 'blog-nav__title' %}
      {%- endif -%}
      {% render 'tabs', label: bn_aria, tabs: bn_labels, hrefs: bn_hrefs, active: bn_active, class: 'blog-nav__tabs' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog navigation",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "label",
      "label": "Label",
      "default": "Explora nuestro blog"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "blog_link",
      "name": "Blog button",
      "settings": [
        {
          "type": "blog",
          "id": "blog",
          "label": "Blog"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label override",
          "info": "Optional; defaults to the blog title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog navigation",
      "blocks": [{ "type": "blog_link" }, { "type": "blog_link" }, { "type": "blog_link" }, { "type": "blog_link" }]
    }
  ]
}
{% endschema %}
