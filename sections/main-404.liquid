{{ 'section-tdm-404.css' | asset_url | stylesheet_tag }}

<div class="template-404 page-width page-margin center">
  {%- assign t404_sub = 'templates.404.subtext' | t -%}
  {%- assign t404_title = 'templates.404.title' | t -%}
  {%- assign t404_cta = 'general.continue_shopping' | t -%}
  {% render 'typography', text: t404_sub, variant: 'body', color: 'secondary', align: 'center' %}
  {% render 'typography', text: t404_title, as: 'h1', font: 'display', weight: 'medium', variant: 'h1', align: 'center', class: 'template-404__title' %}
  {% render 'button', label: t404_cta, href: routes.all_products_collection_url, variant: 'primary', size: 'md' %}
</div>
