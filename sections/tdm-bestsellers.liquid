{%- comment -%}
  Más vendidos — vitrina de productos con sus propios beneficios (Aliados). Va entre el encabezado de la línea y la banda
  "lo que todos comparten" (la sección Detalles con imagen).
  Cada producto es el átomo product-card (blanca): foto, nombre, 1–2 beneficios y "Agregar al pedido".
  El botón suma 1 unidad al pedido de #pedido (sección Pedido de Aliado, assets/pr-order.js, atributo data-order-add)
  y baja a esa sección. Sin la sección de pedido en la página el botón solo hace scroll al ancla.
  Fuente: la colección elegida (vacío = todos los productos). Para "Más vendidos" basta crear la colección y elegirla aquí.
  Beneficios de cada producto, en este orden: bloque "Beneficios de un producto" con ese producto → metafield
  (por defecto custom.beneficios, lista o texto con un beneficio por línea) → primeras palabras de la descripción.
  El precio sale solo cuando es mayor a $0 (átomo price-tag).
  Styles: assets/section-tdm-bestsellers.css
{%- endcomment -%}

{{ 'section-tdm-bestsellers.css' | asset_url | stylesheet_tag }}
{% render 'tdm-anchor', id: section.settings.anchor_id %}
{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- liquid
  assign s = section.settings
  assign bs_collection = s.collection
  if bs_collection == blank
    assign bs_collection = collections.all
  endif
  assign bs_limit = s.max_products | default: 4
  assign bs_cols = s.columns_desktop | default: 4
  assign bs_mf = s.benefits_metafield | split: '.'
  assign bs_notes = section.blocks | where: 'type', 'benefits'
  case s.heading_size
    when 'h2'
      assign bs_title_variant = 'h2'
    when 'h1'
      assign bs_title_variant = 'h1'
    else
      assign bs_title_variant = 'display'
  endcase
-%}

<section class="tdm-bestsellers color-{{ s.color_scheme }} gradient" style="--bs-cols: {{ bs_cols }};">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="tdm-bestsellers__header">
      {%- render 'section-header', eyebrow: s.eyebrow, title: s.title, intro: s.text, size: bs_title_variant, align: 'center' -%}
    </div>

    <ul class="tdm-bestsellers__track" role="list">
      {%- for product in bs_collection.products limit: bs_limit -%}
        {%- liquid
          assign bs_variant = product.selected_or_first_available_variant
          assign bs_b1 = ''
          assign bs_b2 = ''
          for note in bs_notes
            if note.settings.product.id == product.id
              assign bs_b1 = note.settings.benefit_1
              assign bs_b2 = note.settings.benefit_2
            endif
          endfor
          assign bs_list = ''
          if bs_b1 != blank or bs_b2 != blank
            assign bs_list = bs_b1 | append: '|' | append: bs_b2 | split: '|'
          elsif bs_mf.size == 2
            assign bs_meta = product.metafields[bs_mf[0]][bs_mf[1]].value
            if bs_meta != blank
              assign bs_list = bs_meta | join: '<br />' | newline_to_br | split: '<br />'
            endif
          endif
        -%}
        {%- capture bs_content -%}
          {%- if bs_list != blank -%}
            <ul class="tdm-bestsellers__benefits" role="list">
              {%- assign bs_shown = 0 -%}
              {%- for item in bs_list -%}
                {%- assign bs_item = item | strip | strip_newlines -%}
                {%- if bs_item != blank and bs_shown < 2 -%}
                  {%- assign bs_shown = bs_shown | plus: 1 -%}
                  <li class="tdm-bestsellers__benefit">
                    {%- render 'icon', name: 'check-circle', size: 'sm' -%}
                    {%- render 'typography', text: bs_item, as: 'span', variant: 'body-sm', color: 'secondary' -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- elsif product.description != blank -%}
            {%- assign bs_excerpt = product.description | strip_html | strip | truncatewords: 18 -%}
            {%- render 'typography', text: bs_excerpt, variant: 'body-sm', color: 'secondary' -%}
          {%- endif -%}
        {%- endcapture -%}
        {%- capture bs_action -%}
          {%- capture bs_attrs -%}data-order-add="{{ bs_variant.id }}" data-track="agregar-al-pedido" aria-label="Agregar {{ product.title | escape }} al pedido"{%- endcapture -%}
          {%- assign bs_href = s.button_link | default: '#pedido' -%}
          {%- render 'button', label: s.button_label, href: bs_href, variant: 'primary', size: 'sm', attrs: bs_attrs, class: 'tdm-bestsellers__btn' -%}
        {%- endcapture -%}
        {%- render 'product-card',
          product: product,
          href: '',
          tag: 'li',
          price: bs_variant.price,
          compare_at_price: bs_variant.compare_at_price,
          from: false,
          image_ratio: s.image_ratio,
          image_fit: s.image_fit,
          content: bs_content,
          actions: bs_action,
          class: 'tdm-bestsellers__card'
        -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Más vendidos",
  "tag": "div",
  "class": "section section-tdm-bestsellers",
  "max_blocks": 12,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "ID de ancla",
      "info": "Para enlazar a esta sección. 1 o 2 palabras separadas por guion."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "header", "content": "Encabezado" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "title", "label": "Título" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1"
    },
    { "type": "richtext", "id": "text", "label": "Párrafo", "info": "Opcional. Va debajo del título." },
    { "type": "header", "content": "Productos" },
    { "type": "collection", "id": "collection", "label": "Colección", "info": "Vacío: todos los productos. Para los más vendidos: crea la colección \"Más vendidos\" en el admin y elígela aquí." },
    { "type": "range", "id": "max_products", "min": 2, "max": 8, "step": 1, "label": "Máximo de productos", "default": 4 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Columnas en escritorio", "default": 4 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la foto",
      "options": [
        { "value": "1/1", "label": "Cuadrada" },
        { "value": "4/5", "label": "Vertical 4:5" },
        { "value": "3/4", "label": "Vertical 3:4" },
        { "value": "4/3", "label": "Horizontal 4:3" }
      ],
      "default": "4/5"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Ajuste de la foto",
      "options": [
        { "value": "cover", "label": "Llenar" },
        { "value": "contain", "label": "Contener" }
      ],
      "default": "cover"
    },
    { "type": "text", "id": "benefits_metafield", "label": "Metafield de beneficios", "info": "espacio.clave del metafield del producto (lista de texto, o texto con un beneficio por línea). Se usa si el producto no tiene bloque propio. Si tampoco hay, sale el inicio de la descripción.", "default": "custom.beneficios" },
    { "type": "header", "content": "Botón" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Agregar al pedido" },
    { "type": "url", "id": "button_link", "label": "Destino", "info": "Sección a la que baja después de agregar. Por defecto el pedido (#pedido)." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espaciado superior", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espaciado inferior", "default": 48 }
  ],
  "blocks": [
    {
      "type": "benefits",
      "name": "Beneficios de un producto",
      "settings": [
        { "type": "product", "id": "product", "label": "Producto" },
        { "type": "text", "id": "benefit_1", "label": "Beneficio 1" },
        { "type": "text", "id": "benefit_2", "label": "Beneficio 2" }
      ]
    }
  ],
  "presets": [
    { "name": "Más vendidos" }
  ]
}
{% endschema %}
