{{ 'section-tdm-grid-gallery.css' | asset_url | stylesheet_tag }}
{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

<section class="tdm-grid-gallery page-width section-{{ section.id }}-padding">
  {% if section.settings.kicker != blank %}
    {% render 'typography', text: section.settings.kicker, as: 'p', variant: 'body-sm', color: 'secondary', align: 'center', class: 'grid-gallery__kicker' %}
  {% endif %}

  {% if section.settings.heading != blank %}
    {% render 'typography', text: section.settings.heading, as: 'h1', font: 'display', weight: 'medium', variant: 'h1', align: 'center', class: 'grid-gallery__heading' %}
  {% endif %}

  {% if section.settings.subheading != blank %}
    {% render 'typography', text: section.settings.subheading, as: 'p', variant: 'body-lg', color: 'secondary', align: 'center', class: 'grid-gallery__subheading' %}
  {% endif %}

  {% if section.blocks.size > 0 %}
    {%- assign gg_product_label = section.settings.product_label | default: 'Producto recomendado' -%}
    <div class="grid-gallery__grid" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign img = block.settings.image
          assign name = block.settings.name
          assign sci = block.settings.scientific_name
          assign product = block.settings.product
          assign note = block.settings.note
        %}

        {%- capture gg_content -%}
          {%- if sci != blank -%}
            {%- capture gg_sci -%}<em>{{ sci }}</em>{%- endcapture -%}
            {% render 'typography', text: gg_sci, variant: 'body-sm', color: 'secondary', class: 'grid-gallery__sci' %}
          {%- endif -%}
          {%- if note != blank -%}
            {% render 'typography', text: note, variant: 'body-sm', color: 'secondary', class: 'grid-gallery__note' %}
          {%- endif -%}
          {%- if product != blank -%}
            <div class="grid-gallery__product">
              {% render 'typography', text: gg_product_label, as: 'span', variant: 'xs', color: 'secondary' %}
              {% render 'product-card', product: product, layout: 'horizontal', tag: 'div', class: 'grid-gallery__product-card' %}
            </div>
          {%- endif -%}
        {%- endcapture -%}

        <div class="grid-gallery__item" role="listitem" {{ block.shopify_attributes }}>
          {% render 'card', tag: 'article', title: name, title_as: 'h3', image: img, image_alt: img.alt, image_ratio: '1/1', content: gg_content, class: 'grid-gallery__card' %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    {% render 'typography', text: 'Add items using “Add block”.', variant: 'body', color: 'secondary', class: 'tdm-grid-gallery__empty' %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Grid gallery",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "product_label", "label": "Product label", "default": "Producto recomendado" },

    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "item",
      "name": "Gallery item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "scientific_name", "label": "Scientific name" },
        { "type": "product", "id": "product", "label": "Recommended product" },
        { "type": "textarea", "id": "note", "label": "Short note (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "Grid gallery" }]
}
{% endschema %}
