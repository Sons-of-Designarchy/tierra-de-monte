{% comment %}
  Hero Overlay Card
  Image as the frame background, card pinned to a corner. Text through typography, CTA through button.
  Layout values arrive as custom properties on .tdm-hero__frame; CSS in assets/section-tdm-hero.css.
{% endcomment %}

{{ 'section-tdm-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sec = section.settings
  assign img = sec.image
  assign card_pos = sec.card_position | default: 'bottom-left'
  assign card_scheme = 'dark'
  if sec.text_on_dark
    assign card_scheme = ''
  endif
  assign head_variant = 'display'
  if sec.heading_size == 'lg'
    assign head_variant = 'h1'
  endif
  assign btn_class = 'tdm-hero__btn'
  if sec.button_pill
    assign btn_class = 'tdm-hero__btn tdm-hero__btn--pill'
  endif
  assign opacity = sec.card_bg_opacity | default: 85
-%}

<section class="tdm-hero">
  <div class="page-width">
    <div
      class="tdm-hero__frame"
      style="
        --hero-card-max: {{ sec.card_max_width | default: 560 }}px;
        --hero-card-pad: {{ sec.card_padding | default: 24 }}px;
        --hero-card-opacity: {{ opacity }}%;
        --hero-radius: {{ sec.corner_radius | default: 8 }}px;
        --hero-min-h-desktop: {{ sec.min_height_desktop | default: 70 }}vh;
        --hero-min-h-mobile: {{ sec.min_height_mobile | default: 55 }}vh;
        {% if img != blank %}background-image:url({{ img | image_url: width: 2880 }});{% endif %}
      "
    >
      {% if sec.scrim and img != blank %}<div class="tdm-hero__scrim tdm-hero__scrim--{{ card_pos }}" aria-hidden="true"></div>{% endif %}
      {% if img == blank %}
        <div class="tdm-hero__placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}

      <div class="tdm-hero__card tdm-hero__card--{{ card_pos }} tdm-hero__card--{{ card_style }}{% if sec.card_shadow and card_style != 'none' %} tdm-hero__card--shadow{% endif %}">
        <div
          class="tdm-hero__card-inner{% if sec.card_glass %} tdm-hero__card-inner--glass{% endif %}"
          {% if card_scheme != blank %}data-scheme="{{ card_scheme }}"{% endif %}
        >
          {%- if sec.subtitle != blank -%}
            {% render 'typography', text: sec.subtitle, variant: 'eyebrow', color: 'secondary', class: 'tdm-hero__eyebrow' %}
          {%- endif -%}

          {%- if sec.heading != blank -%}
            {% assign head_text = sec.heading | escape %}
            {% render 'typography', text: head_text, variant: head_variant, as: 'h2', font: 'display', weight: 'medium', class: 'tdm-hero__heading' %}
          {%- endif -%}

          {%- if sec.body != blank -%}
            {% render 'typography', text: sec.body, variant: 'body-lg', as: 'div', class: 'tdm-hero__body rte' %}
          {%- endif -%}

          {%- if sec.button_label != blank and sec.button_link != blank -%}
            {% render 'button', label: sec.button_label, href: sec.button_link, variant: 'primary', size: 'lg', class: btn_class %}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero overlay card",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "full",
      "options": [
        { "value": "full", "label": "Full bleed (edge to edge)" },
        { "value": "page", "label": "Page width" }
      ]
    },
    { "type": "checkbox", "id": "scrim", "label": "Darken the image behind the text", "default": true },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },

    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Minimum height (desktop, vh)",
      "min": 40,
      "max": 90,
      "step": 1,
      "unit": "vh",
      "default": 70
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height (mobile, vh)",
      "min": 40,
      "max": 90,
      "step": 1,
      "unit": "vh",
      "default": 55
    },

    {
      "type": "range",
      "id": "corner_radius",
      "label": "Frame corner radius (px)",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 8
    },

    { "type": "header", "content": "Card" },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "default": "solid",
      "options": [
        { "value": "solid", "label": "Solid card" },
        { "value": "none", "label": "No card (text on the image)" }
      ]
    },
    {
      "type": "select",
      "id": "card_position",
      "label": "Card position",
      "default": "bottom-left",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-right", "label": "Bottom right" },
        { "value": "top-left", "label": "Top left" },
        { "value": "top-right", "label": "Top right" },
        { "value": "center-left", "label": "Center left" },
        { "value": "center-right", "label": "Center right" }
      ]
    },
    {
      "type": "range",
      "id": "card_max_width",
      "label": "Card max width (px)",
      "min": 260,
      "max": 720,
      "step": 10,
      "default": 560
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding (px)",
      "min": 12,
      "max": 40,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "card_bg_opacity",
      "label": "Card background opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 85
    },
    { "type": "checkbox", "id": "card_glass", "label": "Enable glass blur", "default": true },
    { "type": "checkbox", "id": "card_shadow", "label": "Drop shadow", "default": true },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "subtitle", "label": "Eyebrow / small label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Vida que genera vida" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "xl",
      "options": [
        { "label": "XL", "value": "xl" },
        { "label": "Large", "value": "lg" }
      ]
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "default": "<p>Nuestros productos combinan ciencia y biotecnología con el poder de la naturaleza, restaurando la vida del suelo y fortaleciendo las plantas desde la raíz.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Soluciones" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "button_pill", "label": "Rounded (pill) button", "default": true },

    { "type": "checkbox", "id": "text_on_dark", "label": "Use inverted text colors", "default": false }
  ],
  "presets": [{ "name": "Hero overlay card" }]
}
{% endschema %}
