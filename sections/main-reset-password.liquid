{{ 'customer.css' | asset_url | stylesheet_tag }}

{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

<div class="customer reset-password section-{{ section.id }}-padding">
  {%- assign rp_title = 'customer.reset_password.title' | t -%}
  {%- assign rp_sub = 'customer.reset_password.subtext' | t -%}
  {% render 'typography', text: rp_title, as: 'h1', variant: 'h2', align: 'center', class: 'customer__title' %}
  {% render 'typography', text: rp_sub, variant: 'body', color: 'secondary', align: 'center' %}
  {%- form 'reset_customer_password' -%}
    {% render 'customer-form-errors', errors: form.errors %}
    {%- assign rp_password = 'customer.reset_password.password' | t -%}
    {%- assign rp_confirm = 'customer.reset_password.password_confirm' | t -%}
    {%- assign rp_submit = 'customer.reset_password.submit' | t -%}
    {%- assign rp_password_error = '' -%}
    {%- assign rp_confirm_error = '' -%}
    {%- if form.errors contains 'password' -%}
      {%- capture rp_password_error -%}{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}{%- endcapture -%}
    {%- endif -%}
    {%- if form.errors contains 'password_confirmation' -%}
      {%- capture rp_confirm_error -%}{{ form.errors.translated_fields.password_confirmation | capitalize }} {{ form.errors.messages.password_confirmation }}{%- endcapture -%}
    {%- endif -%}
    <div class="customer__fields">
      {% render 'input', id: 'password', name: 'customer[password]', type: 'password', label: rp_password, autocomplete: 'new-password', error: rp_password_error %}
      {% render 'input', id: 'password_confirmation', name: 'customer[password_confirmation]', type: 'password', label: rp_confirm, autocomplete: 'new-password', error: rp_confirm_error %}
    </div>
    <div class="customer__actions">
      {% render 'button', label: rp_submit, type: 'submit', variant: 'primary' %}
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "t:sections.main-reset-password.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
