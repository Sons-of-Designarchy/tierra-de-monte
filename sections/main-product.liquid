{%- comment -%}
  Main product — the product page: gallery on the left, the info column on the right, built from blocks in the order the template sets
  (brand, title, description, buttons, benefits, ingredients). The purchase pieces (price, quantity_selector, variant_picker, buy_buttons)
  only render when the theme setting "Mostrar compra en el sitio" is on and the block is enabled; otherwise the page only informs.
  Behaviour of the purchase form lives in assets/pr-product.js; layout in assets/section-tdm-product.css.
{%- endcomment -%}
{{ 'section-tdm-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pr-product.js' | asset_url }}" defer="defer"></script>
{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- liquid
  assign mp_commerce = settings.show_commerce
  assign mp_has_price = false
  assign mp_has_qty = false
  assign mp_has_picker = false
  assign mp_has_buy = false
  for block in section.blocks
    case block.type
      when 'price'
        assign mp_has_price = true
      when 'quantity_selector'
        assign mp_has_qty = true
      when 'variant_picker'
        assign mp_has_picker = true
      when 'buy_buttons'
        assign mp_has_buy = true
    endcase
  endfor
  if section.settings.hide_variants
    assign mp_has_picker = false
  endif
  assign mp_form_done = false
  assign mp_titles = ''
  assign mp_panels = ''
  for block in section.blocks
    if block.type == 'detail' and block.settings.heading != blank
      if mp_titles != blank
        assign mp_titles = mp_titles | append: '|'
        assign mp_panels = mp_panels | append: '<!--pr-->'
      endif
      assign mp_titles = mp_titles | append: block.settings.heading
      assign mp_panel = '<div class="rte">' | append: block.settings.content | append: block.settings.page.content | append: '</div>'
      assign mp_panels = mp_panels | append: mp_panel
    endif
  endfor
  assign mp_gallery_layout = section.settings.gallery_layout
-%}

<div class="pr-product gradient color-{{ section.settings.color_scheme }}" data-product-id="{{ product.id }}">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="pr-product__layout{% if section.settings.enable_sticky_info %} pr-product__layout--sticky{% endif %}">
      <div class="pr-product__media">
        {% render 'product-gallery', product: product, ratio: section.settings.gallery_ratio, fit: section.settings.gallery_fit, show_thumbnails: section.settings.show_thumbnails, layout: mp_gallery_layout %}
      </div>
      <div class="pr-product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                {%- case block.settings.text_style -%}
                  {%- when 'uppercase' -%}
                    {%- render 'typography', text: block.settings.text, variant: 'eyebrow', color: 'secondary', attrs: block.shopify_attributes -%}
                  {%- when 'subtitle' -%}
                    {%- render 'typography', text: block.settings.text, variant: 'body-lg', color: 'secondary', attrs: block.shopify_attributes -%}
                  {%- else -%}
                    {%- render 'typography', text: block.settings.text, attrs: block.shopify_attributes -%}
                {%- endcase -%}
              {%- endif -%}
            {%- when 'title' -%}
              {%- render 'typography', text: product.title, as: 'h1', variant: 'h2', font: 'display', attrs: block.shopify_attributes -%}
            {%- when 'rating' -%}
              {%- if product.metafields.reviews.rating.value != blank -%}
                <div class="pr-product__rating" {{ block.shopify_attributes }}>
                  {%- render 'rating', value: product.metafields.reviews.rating.value.rating -%}
                  {%- capture mp_rating_text %}{{ product.metafields.reviews.rating.value.rating }} · {{ product.metafields.reviews.rating_count }} reseñas{% endcapture -%}
                  {%- render 'typography', text: mp_rating_text, variant: 'body-sm', color: 'secondary' -%}
                </div>
              {%- endif -%}
            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="pr-product__description" {{ block.shopify_attributes }}>
                  {%- render 'typography', text: product.description, as: 'div', variant: 'body', class: 'rte' -%}
                </div>
              {%- endif -%}
            {%- when 'price' or 'quantity_selector' or 'variant_picker' or 'buy_buttons' -%}
              {%- if mp_commerce and mp_form_done == false -%}
                {%- assign mp_form_done = true -%}
                {%- render 'buy-box', product: product, section_id: section.id, show_price: mp_has_price, show_options: mp_has_picker, show_quantity: mp_has_qty, show_buy: mp_has_buy, option_type: section.settings.option_type, show_dynamic_checkout: section.settings.show_dynamic_checkout -%}
              {%- endif -%}
            {%- when 'cta' -%}
              {%- if block.settings.label != blank -%}
                {%- render 'button', label: block.settings.label, href: block.settings.link, variant: block.settings.variant, size: 'lg', class: 'pr-product__cta', attrs: block.shopify_attributes -%}
              {%- endif -%}
            {%- when 'extras' -%}
              {%- render 'product-extras' -%}
            {%- when 'benefits' -%}
              {%- assign mp_benefits = '' -%}
              {%- for i in (1..3) -%}
                {%- assign mp_key = 'item_' | append: i -%}
                {%- assign mp_item = block.settings[mp_key] -%}
                {%- if mp_item != blank -%}
                  {%- if mp_benefits != blank %}{% assign mp_benefits = mp_benefits | append: '<!--pr-->' %}{% endif -%}
                  {%- assign mp_benefits = mp_benefits | append: mp_item -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if mp_benefits != blank -%}
                {%- render 'icon-list', items: mp_benefits -%}
              {%- endif -%}
            {%- when 'detail' -%}
              {%- comment %}Collected above into one accordion{% endcomment -%}
            {%- when '@app' -%}
              {%- render block -%}
          {%- endcase -%}
        {%- endfor -%}
        {%- if mp_titles != blank -%}
          {%- render 'accordion', titles: mp_titles, panels: mp_panels, multiple: true -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Texto",
          "label": "Texto",
          "info": "Admite un valor dinámico, por ejemplo la marca o el subtítulo del producto."
        },
        {
          "type": "select",
          "id": "text_style",
          "label": "Estilo",
          "options": [
            {
              "value": "body",
              "label": "Cuerpo"
            },
            {
              "value": "subtitle",
              "label": "Subtítulo"
            },
            {
              "value": "uppercase",
              "label": "Etiqueta (mayúsculas)"
            }
          ],
          "default": "body"
        }
      ]
    },
    {
      "type": "title",
      "name": "Título",
      "limit": 1,
      "settings": []
    },
    {
      "type": "rating",
      "name": "Reseñas",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Lee el metafield reviews.rating de Shopify. Sin reseñas no muestra nada."
        }
      ]
    },
    {
      "type": "description",
      "name": "Descripción",
      "limit": 1,
      "settings": []
    },
    {
      "type": "price",
      "name": "Precio",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Solo se ve con el ajuste del tema «Mostrar compra en el sitio»."
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "Cantidad",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Solo se ve con el ajuste del tema «Mostrar compra en el sitio»."
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Selector de variantes",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Solo se ve con el ajuste del tema «Mostrar compra en el sitio» y con «Ocultar variantes» apagado."
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Botones de compra",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Agregar al carrito y pago rápido. Solo se ven con el ajuste del tema «Mostrar compra en el sitio»."
        }
      ]
    },
    {
      "type": "cta",
      "name": "Botón (enlace)",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Compra",
          "label": "Texto"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        },
        {
          "type": "select",
          "id": "variant",
          "label": "Estilo",
          "options": [
            {
              "value": "primary",
              "label": "Sólido"
            },
            {
              "value": "secondary",
              "label": "Secundario"
            },
            {
              "value": "outline",
              "label": "Contorno"
            }
          ],
          "default": "secondary"
        }
      ]
    },
    {
      "type": "extras",
      "name": "Ficha e ingredientes",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Lee los metafields del producto: ficha_tecnica, hoja_de_seguridad, beneficio_1 a beneficio_3 e ingredientes."
        }
      ]
    },
    {
      "type": "benefits",
      "name": "Beneficios",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "item_1",
          "label": "Beneficio 1"
        },
        {
          "type": "inline_richtext",
          "id": "item_2",
          "label": "Beneficio 2"
        },
        {
          "type": "inline_richtext",
          "id": "item_3",
          "label": "Beneficio 3"
        }
      ]
    },
    {
      "type": "detail",
      "name": "Detalle desplegable",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Detalle",
          "label": "Título"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Contenido"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Contenido de una página"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_variants",
      "label": "Ocultar variantes",
      "default": true,
      "info": "Con la compra en el sitio encendida, oculta el selector aunque exista el bloque."
    },
    {
      "type": "select",
      "id": "option_type",
      "label": "Selector de opciones",
      "options": [
        {
          "value": "pills",
          "label": "Botones"
        },
        {
          "value": "swatches",
          "label": "Muestras"
        },
        {
          "value": "select",
          "label": "Menú desplegable"
        }
      ],
      "default": "pills"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Mostrar botones de pago rápido",
      "info": "Shopify pone aquí Apple Pay, Shop Pay y similares.",
      "default": true
    },
    {
      "type": "header",
      "content": "Galería"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Disposición",
      "options": [
        {
          "value": "stacked",
          "label": "Apilada: foto grande y las demás en cuadrícula"
        },
        {
          "value": "slider",
          "label": "Carrusel con miniaturas"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "gallery_ratio",
      "label": "Proporción de las fotos",
      "options": [
        {
          "value": "4/5",
          "label": "Vertical 4:5"
        },
        {
          "value": "1/1",
          "label": "Cuadrada"
        },
        {
          "value": "3/4",
          "label": "Vertical 3:4"
        },
        {
          "value": "4/3",
          "label": "Horizontal 4:3"
        }
      ],
      "default": "4/5"
    },
    {
      "type": "select",
      "id": "gallery_fit",
      "label": "Ajuste de las fotos",
      "options": [
        {
          "value": "cover",
          "label": "Llenar"
        },
        {
          "value": "contain",
          "label": "Contener"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Miniaturas (tablet y escritorio)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "Fijar el cuadro de compra al hacer scroll (escritorio)",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 12
    }
  ]
}
{% endschema %}
