{%- comment -%}
  Main product — the product page: product-gallery on the left, buy-box on the right. Blocks add to the buy-box:
  benefits (check list), detail (accordion item), cta (a button link such as WhatsApp), app blocks.
  Replaces Dawn's 2,000-line section. Behaviour lives in assets/pr-product.js.
{%- endcomment -%}
<script src="{{ 'pr-product.js' | asset_url }}" defer="defer"></script>
{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- liquid
  assign mp_benefits = ''
  assign mp_titles = ''
  assign mp_panels = ''
  capture mp_children
    for block in section.blocks
      case block.type
        when '@app'
          render block
        when 'cta'
          if block.settings.label != blank
            render 'button', label: block.settings.label, href: block.settings.link, variant: block.settings.variant, size: 'lg', class: 'pr-buy-box__cta', attrs: block.shopify_attributes
          endif
      endcase
    endfor
  endcapture
  for block in section.blocks
    case block.type
      when 'benefits'
        for i in (1..3)
          assign mp_key = 'item_' | append: i
          assign mp_item = block.settings[mp_key]
          if mp_item != blank
            if mp_benefits != blank
              assign mp_benefits = mp_benefits | append: '<!--pr-->'
            endif
            assign mp_benefits = mp_benefits | append: mp_item
          endif
        endfor
      when 'detail'
        if block.settings.heading != blank
          if mp_titles != blank
            assign mp_titles = mp_titles | append: '|'
            assign mp_panels = mp_panels | append: '<!--pr-->'
          endif
          assign mp_titles = mp_titles | append: block.settings.heading
          assign mp_panel = '<div class="rte">' | append: block.settings.content | append: block.settings.page.content | append: '</div>'
          assign mp_panels = mp_panels | append: mp_panel
        endif
    endcase
  endfor
  assign mp_description = product.description
  if mp_description != blank
    assign mp_desc_panel = '<div class="rte">' | append: mp_description | append: '</div>'
    if mp_titles != blank
      assign mp_titles = 'Descripción|' | append: mp_titles
      assign mp_panels = mp_desc_panel | append: '<!--pr-->' | append: mp_panels
    else
      assign mp_titles = 'Descripción'
      assign mp_panels = mp_desc_panel
    endif
  endif
  assign mp_rating = nil
  assign mp_rating_count = nil
  if section.settings.show_rating and product.metafields.reviews.rating.value != blank
    assign mp_rating = product.metafields.reviews.rating.value.rating
    assign mp_rating_count = product.metafields.reviews.rating_count
  endif
-%}

<div class="pr-product gradient color-{{ section.settings.color_scheme }}" data-product-id="{{ product.id }}">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="pr-product__layout{% if section.settings.enable_sticky_info %} pr-product__layout--sticky{% endif %}">
      <div class="pr-product__media">
        {% render 'product-gallery', product: product, ratio: section.settings.gallery_ratio, fit: section.settings.gallery_fit, show_thumbnails: section.settings.show_thumbnails %}
      </div>
      <div class="pr-product__info">
        {% render 'buy-box',
          product: product,
          section_id: section.id,
          show_vendor: section.settings.show_vendor,
          rating_value: mp_rating,
          rating_count: mp_rating_count,
          summary: section.settings.summary,
          option_type: section.settings.option_type,
          benefits: mp_benefits,
          details_titles: mp_titles,
          details_panels: mp_panels,
          show_dynamic_checkout: section.settings.show_dynamic_checkout,
          children: mp_children
        %}
      </div>
    </div>
  </div>
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "benefits",
      "name": "Beneficios",
      "settings": [
        {
          "type": "paragraph",
          "content": "Hasta tres razones para comprar, con palomita. Los metafields beneficio_1 a beneficio_3 del producto se suman solos."
        },
        { "type": "inline_richtext", "id": "item_1", "label": "Beneficio 1" },
        { "type": "inline_richtext", "id": "item_2", "label": "Beneficio 2" },
        { "type": "inline_richtext", "id": "item_3", "label": "Beneficio 3" }
      ]
    },
    {
      "type": "detail",
      "name": "Detalle desplegable",
      "settings": [
        { "type": "text", "id": "heading", "default": "Detalle", "label": "Título" },
        { "type": "richtext", "id": "content", "label": "Contenido" },
        { "type": "page", "id": "page", "label": "Contenido de una página" }
      ]
    },
    {
      "type": "cta",
      "name": "Botón (enlace)",
      "settings": [
        { "type": "text", "id": "label", "default": "Comprar por WhatsApp", "label": "Texto" },
        { "type": "url", "id": "link", "label": "Enlace" },
        {
          "type": "select",
          "id": "variant",
          "label": "Estilo",
          "options": [
            { "value": "primary", "label": "Sólido" },
            { "value": "secondary", "label": "Secundario" },
            { "value": "outline", "label": "Contorno" }
          ],
          "default": "secondary"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Mostrar la marca sobre el título",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "summary",
      "label": "Resumen bajo el precio",
      "info": "Puede usar un metafield dinámico (por ejemplo el subtítulo)."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Mostrar reseñas",
      "info": "Lee el metafield reviews.rating de Shopify.",
      "default": true
    },
    {
      "type": "select",
      "id": "option_type",
      "label": "Selector de opciones",
      "options": [
        { "value": "pills", "label": "Botones" },
        { "value": "swatches", "label": "Muestras" },
        { "value": "select", "label": "Menú desplegable" }
      ],
      "default": "pills"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Mostrar botones de pago rápido",
      "info": "Shopify pone aquí Apple Pay, Shop Pay y similares.",
      "default": true
    },
    {
      "type": "header",
      "content": "Galería"
    },
    {
      "type": "select",
      "id": "gallery_ratio",
      "label": "Proporción de las fotos",
      "options": [
        { "value": "4/5", "label": "Vertical 4:5" },
        { "value": "1/1", "label": "Cuadrada" },
        { "value": "3/4", "label": "Vertical 3:4" },
        { "value": "4/3", "label": "Horizontal 4:3" }
      ],
      "default": "4/5"
    },
    {
      "type": "select",
      "id": "gallery_fit",
      "label": "Ajuste de las fotos",
      "options": [
        { "value": "cover", "label": "Llenar" },
        { "value": "contain", "label": "Contener" }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Miniaturas (tablet y escritorio)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "label": "Fijar el cuadro de compra al hacer scroll (escritorio)",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 12
    }
  ]
}
{% endschema %}
