{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{{ 'section-tdm-footer.css' | asset_url | stylesheet_tag }}

{%- render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom -%}

<footer
  class="footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  style="--footer-margin-top: {{ section.settings.margin_top }}px; --footer-margin-top-mobile: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;"
>
  {%- liquid
    assign has_social_icons = true
    if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
      assign has_social_icons = false
    endif

    if settings.brand_image == blank and settings.brand_headline == blank and settings.brand_description == blank
      assign brand_empty = true
    endif

    if section.blocks.size == 1 and section.blocks[0].type == 'brand_information' and brand_empty and has_social_icons == false and section.settings.newsletter_enable == false and section.settings.enable_follow_on_shop == false
      assign only_empty_brand = true
    endif
  -%}
  {%- if section.blocks.size > 0
    or section.settings.newsletter_enable
    or section.settings.show_social
    and has_social_icons == true
    or section.settings.enable_follow_on_shop
  -%}
    {%- unless only_empty_brand -%}
      <div class="footer__content-top page-width footer--custom">
        {%- if section.blocks.size > 0 -%}
          {%- liquid
            if section.blocks.size == 9
              assign footer_grid_class = 'grid--3-col-tablet'
            elsif section.blocks.size > 6
              assign footer_grid_class = 'grid--4-col-desktop'
            elsif section.blocks.size > 4
              assign footer_grid_class = 'grid--3-col-tablet'
            endif
          -%}
          <div
            class="footer__blocks-wrapper footer-grid-custom grid grid--1-col grid--2-col grid--4-col-tablet {{ footer_grid_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {%- for block in section.blocks -%}
              <div
                class="footer-block grid__item{% if block.type == 'link_list' %} footer-block--menu{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {%- if block.settings.heading != blank -%}
                  {%- render 'typography',
                    text: block.settings.heading,
                    variant: 'eyebrow',
                    as: 'p',
                    class: 'footer-block__heading'
                  -%}
                {%- endif -%}

                {%- case block.type -%}
                  {%- when '@app' -%}
                    {% render block %}
                  {%- when 'text' -%}
                    {%- render 'typography',
                      text: block.settings.subtext,
                      variant: 'body-sm',
                      as: 'div',
                      color: 'secondary',
                      class: 'footer-block__details-content rte'
                    -%}
                  {%- when 'social_icons' -%}
                    {%- if has_social_icons -%}
                      {%- render 'social-icons', class: 'footer__list-social footer__list-social--start' -%}
                    {%- endif -%}
                  {%- when 'link_list' -%}
                    {%- if block.settings.menu != blank -%}
                      <ul class="footer-block__details-content list-unstyled">
                        {%- for link in block.settings.menu.links -%}
                          <li>
                            {%- assign link_title = link.title | escape -%}
                            {%- render 'link',
                              text: link_title,
                              href: link.url,
                              variant: 'body-sm',
                              weight: 'regular',
                              color: 'secondary',
                              quiet: true,
                              current: link.active,
                              class: 'footer-link'
                            -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  {%- when 'brand_information' -%}
                    <div class="footer-block__brand-info">
                      {%- liquid
                        # Optional per-footer logo (e.g. the aliados footer); falls back to the theme brand image
                        assign brand_img = settings.brand_image
                        if block.settings.brand_image_override != blank
                          assign brand_img = block.settings.brand_image_override
                        endif
                      -%}
                      {%- if brand_img != blank -%}
                        {%- assign brand_image_height = settings.brand_image_width
                          | divided_by: brand_img.aspect_ratio
                        -%}
                        <div
                          class="footer-block__image-wrapper"
                          style="--footer-image-width: {{ settings.brand_image_width }}px;"
                        >
                          {{
                            brand_img
                            | image_url: width: 1100
                            | image_tag:
                              loading: 'lazy',
                              widths: '50, 100, 150, 200, 300, 400, 550, 800, 1100',
                              height: brand_image_height,
                              width: settings.brand_image_width
                          }}
                        </div>
                      {%- endif -%}
                      {%- if settings.brand_headline != blank -%}
                        {%- render 'typography',
                          text: settings.brand_headline,
                          variant: 'h5',
                          as: 'h2',
                          class: 'footer-block__heading rte'
                        -%}
                      {%- endif -%}
                      {%- if settings.brand_description != blank -%}
                        {%- render 'typography',
                          text: settings.brand_description,
                          variant: 'body-sm',
                          as: 'div',
                          color: 'secondary',
                          class: 'rte'
                        -%}
                      {%- endif -%}
                      {%- if block.settings.show_social and has_social_icons -%}
                        {%- render 'social-icons', class: 'footer__list-social' -%}
                      {%- endif -%}
                    </div>
                  {%- when 'image' -%}
                    <div class="footer-block__details-content footer-block-image {{ block.settings.alignment }}">
                      {%- if block.settings.image != blank -%}
                        {%- assign image_size_2x = block.settings.image_width | times: 2 | at_most: 5760 -%}
                        <div
                          class="footer-block__image-wrapper"
                          style="--footer-image-width: {{ block.settings.image_width }}px;"
                        >
                          <img
                            srcset="{{ block.settings.image | image_url: width: block.settings.image_width }}, {{ block.settings.image | image_url: width: image_size_2x }} 2x"
                            src="{{ block.settings.image | image_url: width: 760 }}"
                            alt="{{ block.settings.image.alt | escape }}"
                            loading="lazy"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                          >
                        </div>
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                      {%- endif -%}
                    </div>
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="footer-block--newsletter">
          <div class="footer-block__newsletter">
            <div
              class="footer-newsletter{% unless section.settings.newsletter_enable %} footer-newsletter--media-only{% endunless %}"
              style="--nl-media-w: {{ section.settings.newsletter_image_max_width | default: 140 }}px;"
            >
              {%- if section.settings.newsletter_enable -%}
              <div class="footer-newsletter__form">
                {%- if section.settings.newsletter_title != blank -%}
                  {%- render 'typography',
                    text: section.settings.newsletter_title,
                    variant: 'label',
                    weight: 'medium',
                    as: 'p',
                    class: 'footer-block__heading'
                  -%}
                {%- endif -%}

                <form
                  method="post"
                  action="/contact#ContactFooter"
                  id="ContactFooter"
                  accept-charset="UTF-8"
                  class="footer__newsletter newsletter-form"
                >
                  <input type="hidden" name="form_type" value="customer">
                  <input type="hidden" name="utf8" value="✓">
                  <input type="hidden" name="contact[tags]" value="newsletter">

                  <div class="footer-newsletter__row">
                    {%- liquid
                      assign nl_button = 'newsletter.button_label' | t
                      assign nl_label = 'newsletter.label' | t | default: 'Correo electrónico'
                      assign nl_id = 'NewsletterForm--' | append: section.id
                    -%}
                    {%- render 'input',
                      label: nl_label,
                      name: 'contact[email]',
                      id: nl_id,
                      type: 'email',
                      placeholder: nl_label,
                      autocomplete: 'email',
                      hide_label: true,
                      required: true,
                      class: 'footer-newsletter__field'
                    -%}
                    {%- render 'icon-button',
                      icon: 'arrow-right',
                      label: nl_button,
                      variant: 'primary',
                      type: 'submit',
                      id: 'Subscribe',
                      class: 'footer-newsletter__button'
                    -%}
                  </div>
                </form>
              </div>
              {%- endif -%}

              <!-- RIGHT: image -->
              {% if section.settings.newsletter_image != blank %}
                {%- liquid
                  assign newsletter_img_class = 'footer-newsletter__img'
                  if section.settings.newsletter_image_circle
                    assign newsletter_img_class = 'footer-newsletter__img footer-newsletter__img--circle'
                  endif
                -%}
                <div class="footer-newsletter__media">
                  {{
                    section.settings.newsletter_image
                    | image_url: width: 800
                    | image_tag:
                      widths: '320,480,640,800',
                      sizes: '(min-width: 990px) var(--nl-media-w), 40vw',
                      class: newsletter_img_class,
                      alt: section.settings.newsletter_image_alt
                  }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    {%- endunless -%}
  {%- endif -%}

  <div
    class="footer__content-bottom{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    <div class="footer__content-bottom-wrapper page-width">
      <div class="footer__column footer__localization isolate">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <div>
                {%- assign country_label = 'localization.country_label' | t -%}
                {%- render 'typography', text: country_label, variant: 'label', as: 'h2', color: 'secondary', id: 'FooterCountryLabel' -%}
                {%- render 'country-localization', localPosition: 'FooterCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
              <div>
                {%- assign language_label = 'localization.language_label' | t -%}
                {%- render 'typography', text: language_label, variant: 'label', as: 'h2', color: 'secondary', id: 'FooterLanguageLabel' -%}
                {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
      <div class="footer__column footer__column--info">
        {%- if section.settings.payment_enable -%}
          <div class="footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
    <div class="footer__content-bottom-wrapper page-width{% if section.settings.enable_country_selector == false and section.settings.enable_language_selector == false %} footer__content-bottom-wrapper--center{% endif %}">
      <div class="footer__copyright">
        {%- capture copyright_text -%}&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}{%- endcapture -%}
        {%- render 'typography', text: copyright_text, variant: 'xs', as: 'small', color: 'secondary', class: 'copyright__content' -%}
        {%- render 'typography', text: powered_by_link, variant: 'xs', as: 'small', color: 'secondary', class: 'copyright__content' -%}
        {%- if section.settings.show_policy -%}
          <ul class="policies list-unstyled">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li>
                  {%- capture policy_link -%}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{%- endcapture -%}
                  {%- render 'typography', text: policy_link, variant: 'xs', as: 'small', color: 'secondary', class: 'copyright__content' -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "social_icons",
      "name": "Redes sociales (íconos)",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Redes sociales",
          "label": "Título"
        },
        {
          "type": "paragraph",
          "content": "Los íconos usan los enlaces de Redes sociales de la configuración del tema."
        }
      ]
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.link_list.settings.heading.default",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label"
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.brand_information.settings.paragraph.content"
        },
        {
          "type": "image_picker",
          "id": "brand_image_override",
          "label": "Logo de este footer",
          "info": "Opcional. Reemplaza el logo de marca del tema solo en este footer (p. ej. el footer de aliados)."
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "default": true,
          "label": "t:sections.footer.blocks.brand_information.settings.show_social.label",
          "info": "t:sections.footer.blocks.brand_information.settings.show_social.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.text.settings.heading.default",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "t:sections.footer.blocks.text.settings.subtext.default",
          "label": "t:sections.footer.blocks.text.settings.subtext.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 550,
          "step": 5,
          "unit": "px",
          "label": "Width",
          "default": 100
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            {
              "value": "",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__1.content",
      "info": "t:sections.footer.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_enable.label"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "default": "t:sections.footer.settings.newsletter_heading.default",
      "label": "t:sections.footer.settings.newsletter_heading.label"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter title",
      "default": "Subscribe to our emails"
    },
    {
      "type": "image_picker",
      "id": "newsletter_image",
      "label": "Newsletter image (left)"
    },
    {
      "type": "text",
      "id": "newsletter_image_alt",
      "label": "Image alt text",
      "default": "Newsletter"
    },
    {
      "type": "range",
      "id": "newsletter_image_max_width",
      "label": "Image max width (px)",
      "min": 80,
      "max": 280,
      "step": 4,
      "default": 140
    },
    {
      "type": "checkbox",
      "id": "newsletter_image_circle",
      "label": "Make image circular",
      "default": false
    },

    {
      "type": "header",
      "content": "t:sections.footer.settings.header__9.content"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "default": true,
      "label": "t:sections.footer.settings.enable_follow_on_shop.label",
      "info": "t:sections.footer.settings.enable_follow_on_shop.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "t:sections.footer.settings.show_social.label",
      "info": "t:sections.footer.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_country_selector.label",
      "info": "t:sections.footer.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_language_selector.label",
      "info": "t:sections.footer.settings.enable_language_selector.info"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "t:sections.footer.settings.payment_enable.label"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": true,
      "label": "t:sections.footer.settings.show_policy.label",
      "info": "t:sections.footer.settings.show_policy.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list"
      },
      {
        "type": "text"
      }
    ]
  }
}
{% endschema %}
