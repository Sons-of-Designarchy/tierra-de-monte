{{ 'section-tdm-logo-bar.css' | asset_url | stylesheet_tag }}
{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- liquid
  assign total = section.blocks.size
  assign root_classes = 'tdm-logo-bar'
  if section.settings.grayscale
    assign root_classes = root_classes | append: ' tdm-logo-bar--grayscale'
  endif

  assign title_text = section.settings.title | strip_html
-%}

{%- capture bar_inner -%}
  {% if section.settings.title != blank %}
    <div class="logo-bar__header">
      {% render 'typography', text: title_text, variant: 'eyebrow', as: 'h2', align: 'center' %}
    </div>
  {% endif %}

  <ul role="list" class="logo-bar__list">
    {%- for block in section.blocks -%}
      {%- if block.settings.image != blank -%}
        <li class="logo-bar__item" {{ block.shopify_attributes }}>
          <div class="logo-bar__box">
            {%- assign img = block.settings.image -%}
            {{
              img
              | image_url: width: 800
              | image_tag:
                widths: '160, 200, 240, 320, 480, 640, 800',
                sizes: '(min-width: 990px) 180px, (min-width: 750px) 160px, 45vw',
                class: 'logo-bar__img',
                alt: block.settings.alt
              | default: img.alt
            }}
          </div>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endcapture -%}

<section
  class="{{ root_classes }} color-{{ section.settings.color_scheme }} gradient"
  style="--logo-bar-gap: {{ section.settings.gap }}px; --logo-h: {{ section.settings.max_height }}px;"
>
  <div
    class="page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    <div class="logo-bar__inner">{{ bar_inner }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Logo bar",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Title", "default": "ALIANZAS QUE NUTREN LA TIERRA" },

    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "gap", "label": "Logo gap (px)", "info": "Logos sit together in the centre with this fixed gap.", "min": 16, "max": 128, "step": 8, "default": 64 },
    { "type": "checkbox", "id": "grayscale", "label": "Grayscale logos", "default": true },
    {
      "type": "range",
      "id": "max_height",
      "label": "Max logo height (px)",
      "min": 24,
      "max": 160,
      "step": 2,
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Logo bar",
      "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }]
    }
  ]
}
{% endschema %}
