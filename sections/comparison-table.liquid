{%- comment -%}
  Tabla comparativa editable (v8)
  - Columnas: bloques "Columna" (máx. 6) con precio, nota y botón (CTA) propios
  - Filas: bloques "Fila"
  - Esquemas de color independientes:
      · Sección (fondo general)
      · Tabla (fondo y texto del contenido)
      · Columna destacada (esquema propio por columna)
      · Botones de columnas (esquema propio a nivel sección, independiente de tabla y columna destacada)
        └ Cada columna puede sobrescribirlo con su propio esquema
      · Botón general debajo de la tabla (esquema propio)
  - En las celdas escribe "si" / "✓" para palomita y "-" / "no" para guion
  - Compatible con Dawn, Horizon y temas OS 2.0 (lee directamente los colores del esquema)
{%- endcomment -%}

{% render 'tdm-anchor', id: section.settings.anchor_id %}

{%- liquid
  assign column_blocks = section.blocks | where: 'type', 'column'
  assign row_blocks = section.blocks | where: 'type', 'row'
  assign display_columns = column_blocks.size | at_most: 6
  assign other_width = 100 | minus: section.settings.first_column_width
  assign sid = section.id
  assign radius = section.settings.table_radius
  assign hl_radius = section.settings.highlight_radius

  assign ts = section.settings.table_color_scheme.settings
  assign t_bg = ts.background
  assign t_fg = ts.text | default: ts.foreground
  assign t_accent = ts.button | default: ts.primary_button_background | default: t_fg

  # ---------- Esquema de los CTA (nivel sección) ----------
  # Se lee el color directo del esquema. Si el tema usa otros nombres,
  # se cae a las variables CSS que el tema define en .color-scheme-X
  assign cta_scheme_id = section.settings.cta_color_scheme.id | default: section.settings.cta_color_scheme
  assign gs = section.settings.cta_color_scheme.settings
  assign g_bg = gs.button | default: gs.primary_button_background | default: 'var(--color-primary-button-background, rgb(var(--color-button)))'
  assign g_fg = gs.button_label | default: gs.primary_button_text | default: 'var(--color-primary-button-text, rgb(var(--color-button-text)))'
  assign g_hbg = gs.primary_button_hover_background | default: g_bg
  assign g_hfg = gs.primary_button_hover_text | default: g_fg

  # ---------- Botón general (debajo de la tabla) ----------
  # Por defecto usa el mismo esquema de CTA; opcionalmente uno propio
  if section.settings.button_scheme_source == 'custom'
    assign btn_scheme_id = section.settings.button_color_scheme.id | default: section.settings.button_color_scheme
    assign bs = section.settings.button_color_scheme.settings
    assign b_bg = bs.button | default: bs.primary_button_background | default: 'var(--color-primary-button-background, rgb(var(--color-button)))'
    assign b_fg = bs.button_label | default: bs.primary_button_text | default: 'var(--color-primary-button-text, rgb(var(--color-button-text)))'
    assign b_hbg = bs.primary_button_hover_background | default: b_bg
    assign b_hfg = bs.primary_button_hover_text | default: b_fg
  else
    assign btn_scheme_id = cta_scheme_id
    assign b_bg = g_bg
    assign b_fg = g_fg
    assign b_hbg = g_hbg
    assign b_hfg = g_hfg
  endif

  # ---------- Posición de los botones de columnas ----------
  # bottom = fila al final de la tabla (por defecto)
  assign cta_placement = section.settings.cta_placement | default: 'bottom'
  assign ctas_in_header = true
  if cta_placement == 'bottom'
    assign ctas_in_header = false
  endif

  assign any_cta = false
  for col in column_blocks limit: display_columns
    if col.settings.cta_label != blank
      assign any_cta = true
    endif
  endfor

  assign has_bottom_ctas = false
  if any_cta
    if cta_placement == 'bottom' or section.settings.show_bottom_ctas
      assign has_bottom_ctas = true
    endif
  endif

  # ---------- Botones: siempre el estilo del tema (clase .button), sin variantes propias ----------
  assign theme_btn = true

  # ---------- Anchos en móvil (px) ----------
  assign m_feat_w = section.settings.mobile_feature_width | default: 130
  assign m_col_w = section.settings.mobile_column_width | default: 120
  assign m_pad = section.settings.table_padding_x | at_most: 8

  # ---------- Ancho de columnas (la destacada puede ser más ancha) ----------
  assign hl_extra = section.settings.highlight_extra_width | default: 0 | times: 0.01
  assign total_weight = 0.0
  for col in column_blocks limit: display_columns
    assign total_weight = total_weight | plus: 1
    if col.settings.highlight
      assign total_weight = total_weight | plus: hl_extra
    endif
  endfor
  assign m_hl_w = m_col_w | times: hl_extra | plus: m_col_w | round: 0
  assign m_table_w = m_col_w | times: total_weight | plus: m_feat_w | round: 0

  # ---------- Root modifier classes (settings booleans become classes, not conditional CSS) ----------
  assign root_class = 'ct-section tdm-comparison-table section-' | append: sid | append: '-padding color-' | append: section.settings.color_scheme | append: ' gradient'
  if section.settings.price_size != 'default'
    assign root_class = root_class | append: ' ct-price--' | append: section.settings.price_size
  endif
  if section.settings.show_vertical_borders
    assign root_class = root_class | append: ' ct-vborders'
  endif
  if section.settings.feature_tint
    assign root_class = root_class | append: ' ct-feature-tint'
  endif
  if section.settings.striped_rows
    assign root_class = root_class | append: ' ct-striped'
  endif
  if section.settings.sticky_first_column
    assign root_class = root_class | append: ' ct-sticky-feature'
  endif
  if theme_btn
    assign root_class = root_class | append: ' ct-theme-btn'
  endif
  if section.settings.full_width_buttons
    assign root_class = root_class | append: ' ct-full-btns'
  endif
  if section.settings.check_color == 'accent'
    assign root_class = root_class | append: ' ct-check-accent'
  endif

  # ---------- Values that used to be Liquid-conditional CSS become plain values ----------
  assign feature_weight = 400
  if section.settings.feature_bold
    assign feature_weight = 600
  endif

-%}

{%- comment -%} Per-column custom properties: highlight scheme + optional CTA scheme override {%- endcomment -%}
{%- capture col_style -%}
  {%- for col in column_blocks limit: display_columns -%}
    {%- liquid
      assign hs = col.settings.highlight_scheme.settings
      assign h_bg = hs.background
      assign h_fg = hs.text | default: hs.foreground
      assign h_ac = hs.button | default: hs.primary_button_background | default: h_fg
    -%}
    --ct-hl-bg-{{ forloop.index }}: {{ h_bg }}; --ct-hl-fg-{{ forloop.index }}: {{ h_fg }}; --ct-hl-accent-{{ forloop.index }}: {{ h_ac }};
    {%- if col.settings.cta_custom_scheme -%}
      {%- liquid
        assign cs = col.settings.cta_scheme.settings
        assign c_bg = cs.button | default: cs.primary_button_background | default: 'var(--color-primary-button-background, rgb(var(--color-button)))'
        assign c_fg = cs.button_label | default: cs.primary_button_text | default: 'var(--color-primary-button-text, rgb(var(--color-button-text)))'
        assign c_hbg = cs.primary_button_hover_background | default: c_bg
        assign c_hfg = cs.primary_button_hover_text | default: c_fg
      -%}
      --ct-btn-bg-{{ forloop.index }}: {{ c_bg }}; --ct-btn-fg-{{ forloop.index }}: {{ c_fg }}; --ct-btn-hover-bg-{{ forloop.index }}: {{ c_hbg }}; --ct-btn-hover-fg-{{ forloop.index }}: {{ c_hfg }};
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- comment -%} All per-instance/setting values, as custom properties on the root element. Styles: assets/section-tdm-comparison-table.css {%- endcomment -%}
{%- capture root_style -%}
  --ct-align: {{ section.settings.text_align }};
  --ct-table-bg: {{ t_bg }};
  --ct-table-fg: {{ t_fg }};
  --ct-accent: {{ t_accent }};
  --ct-radius: {{ radius }}px;
  --ct-hl-radius: {{ hl_radius }}px;
  --ct-pad: {{ section.settings.table_padding_x }}px;
  --ct-pad-mobile: {{ m_pad }}px;
  --ct-border-opacity: {{ section.settings.border_opacity }}%;
  --ct-min-w: {{ display_columns | plus: 1 | times: 130 }}px;
  --ct-image-size: {{ section.settings.image_size }}px;
  --ct-image-size-mobile: {{ section.settings.mobile_image_size | default: 64 }}px;
  --ct-cell-align: {{ section.settings.cell_align }};
  --ct-feature-weight: {{ feature_weight }};
  --ct-mobile-feat-w: {{ m_feat_w }}px;
  --ct-mobile-col-w: {{ m_col_w }}px;
  --ct-mobile-hl-w: {{ m_hl_w }}px;
  --ct-mobile-table-w: {{ m_table_w }}px;
  --ct-btn-bg: {{ g_bg }};
  --ct-btn-fg: {{ g_fg }};
  --ct-btn-hover-bg: {{ g_hbg }};
  --ct-btn-hover-fg: {{ g_hfg }};
  --ct-cta-bg: {{ b_bg }};
  --ct-cta-fg: {{ b_fg }};
  --ct-cta-hover-bg: {{ b_hbg }};
  --ct-cta-hover-fg: {{ b_hfg }};
  --ct-cta-align: {{ section.settings.button_align }};
  {{ col_style }}
{%- endcapture -%}

{{ 'section-tdm-comparison-table.css' | asset_url | stylesheet_tag }}
{% render 'section-padding', id: sid, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- capture ct_check_svg -%}
  <svg class="ct-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg><span class="visually-hidden">Incluido</span>
{%- endcapture -%}
{%- capture ct_dash -%}
  <span class="ct-dash" aria-hidden="true"></span><span class="visually-hidden">No incluido</span>
{%- endcapture -%}

<div class="{{ root_class }}" style="{{ root_style }}">
  <div class="{{ section.settings.container_width }}">
    {%- if section.settings.pretitle != blank or section.settings.heading != blank or section.settings.description != blank -%}
      <div class="ct-intro">
        {%- render 'tdm-section-eyebrow', text: section.settings.pretitle, rule_color: section.settings.rule_color, align: 'var(--ct-align)' -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if display_columns > 0 -%}
      <div class="ct-block" id="CtBlock-{{ sid }}">
      {%- if section.settings.scroll_hint != blank -%}
        <p class="ct-scroll-hint" aria-hidden="true">
          {{ section.settings.scroll_hint | escape }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </p>
      {%- endif -%}
      <div class="ct-scroll">
      <div class="ct-wrapper" tabindex="0" role="region" aria-label="{{ section.settings.heading | strip_html | default: 'Tabla comparativa' | escape }}">
        <table class="ct-table">
          <colgroup>
            <col class="ct-col-feature" style="--ct-col-w: {{ section.settings.first_column_width }}%;">
            {%- for col in column_blocks limit: display_columns -%}
              {%- liquid
                assign w = 1.0
                if col.settings.highlight
                  assign w = w | plus: hl_extra
                endif
                assign col_pct = other_width | times: w | divided_by: total_weight | round: 3
              -%}
              <col class="ct-col-plan{% if col.settings.highlight %} ct-col-hl{% endif %}" style="--ct-col-w: {{ col_pct }}%;">
            {%- endfor -%}
          </colgroup>

          <thead>
            <tr{% if row_blocks.size == 0 and has_bottom_ctas == false %} class="ct-last"{% endif %}>
              <th class="ct-feature ct-corner" scope="col">{{ section.settings.first_column_label }}</th>
              {%- for block in column_blocks limit: display_columns -%}
                {%- capture col_cta -%}
                  {%- if block.settings.cta_label != blank -%}
                    <a
                      {% if block.settings.cta_link != blank %}href="{{ block.settings.cta_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                      {% if block.settings.cta_new_tab %}target="_blank" rel="noopener"{% endif %}
                      class="{% if theme_btn %}button button--{% if block.settings.cta_style == 'outline' %}secondary{% else %}primary{% endif %} {% endif %}ct-btn ct-btn--{{ block.settings.cta_style }} ct-btn-c{{ forloop.index }} color-{% if block.settings.cta_custom_scheme %}{{ block.settings.cta_scheme.id | default: block.settings.cta_scheme }}{% else %}{{ cta_scheme_id }}{% endif %}"
                    >{{ block.settings.cta_label | escape }}</a>
                  {%- endif -%}
                {%- endcapture -%}
                {%- capture col_price -%}
                  {%- if block.settings.price != blank or block.settings.price_note != blank -%}
                    <div class="ct-header__price">
                      {%- if block.settings.price != blank -%}<span>{{ block.settings.price }}</span>{%- endif -%}
                      {%- if block.settings.price_note != blank -%}<span class="ct-header__note">{{ block.settings.price_note }}</span>{%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endcapture -%}

                <th
                  class="ct-header ct-c{{ forloop.index }}{% if block.settings.highlight %} ct-hl{% endif %}"
                  scope="col"
                  {{ block.shopify_attributes }}
                >
                  <div class="ct-header__inner">
                    {%- if block.settings.badge != blank -%}
                      <span class="ct-badge">{{ block.settings.badge }}</span>
                    {%- endif -%}

                    {%- if block.settings.header_image != blank -%}
                      {{ block.settings.header_image
                        | image_url: width: 400
                        | image_tag: class: 'ct-header__image', loading: 'lazy', alt: block.settings.title
                      }}
                    {%- else -%}
                      {%- case block.settings.header_icon -%}
                        {%- when 'star' -%}
                          <svg class="ct-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        {%- when 'heart' -%}
                          <svg class="ct-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                        {%- when 'check' -%}
                          <svg class="ct-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                      {%- endcase -%}
                    {%- endif -%}

                    {%- if block.settings.link != blank -%}
                      <a href="{{ block.settings.link }}" class="ct-header__title">{{ block.settings.title }}</a>
                    {%- else -%}
                      <span class="ct-header__title">{{ block.settings.title }}</span>
                    {%- endif -%}

                    {%- if block.settings.subtitle != blank -%}
                      <span class="ct-header__subtitle">{{ block.settings.subtitle }}</span>
                    {%- endif -%}

                    {%- if ctas_in_header == false -%}
                      {{ col_price }}
                    {%- elsif cta_placement == 'before_price' -%}
                      {{ col_cta }}{{ col_price }}
                    {%- else -%}
                      {{ col_price }}{{ col_cta }}
                    {%- endif -%}
                  </div>
                </th>
              {%- endfor -%}
            </tr>
          </thead>

          <tbody>
            {%- for block in row_blocks -%}
              <tr
                {% if forloop.last and has_bottom_ctas == false %}class="ct-last"{% endif %}
                {{ block.shopify_attributes }}
              >
                <th class="ct-feature" scope="row">
                  {{- block.settings.feature_content -}}
                  {%- if block.settings.feature_note != blank -%}<small>{{ block.settings.feature_note }}</small>{%- endif -%}
                </th>
                {%- for col in column_blocks limit: display_columns -%}
                  {%- capture col_key %}col{{ forloop.index }}_content{% endcapture -%}
                  {%- assign cell = block.settings[col_key] -%}
                  {%- assign cell_key = cell | strip_html | strip | downcase -%}
                  <td class="ct-cell ct-c{{ forloop.index }}{% if col.settings.highlight %} ct-hl{% endif %}">
                    {%- case cell_key -%}
                      {%- when 'si', 'sí', 'yes', '✓', '✔', 'check' -%}
                        {{ ct_check_svg }}
                      {%- when '-', '—', '–', 'no' -%}
                        {{ ct_dash }}
                      {%- else -%}
                        {{ cell }}
                    {%- endcase -%}
                  </td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>

          {%- if has_bottom_ctas -%}
            <tfoot>
              <tr class="ct-foot ct-last">
                <th class="ct-feature" scope="row"></th>
                {%- for block in column_blocks limit: display_columns -%}
                  <td class="ct-c{{ forloop.index }}{% if block.settings.highlight %} ct-hl{% endif %}">
                    {%- if block.settings.cta_label != blank -%}
                      <a
                        {% if block.settings.cta_link != blank %}href="{{ block.settings.cta_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                        {% if block.settings.cta_new_tab %}target="_blank" rel="noopener"{% endif %}
                        class="{% if theme_btn %}button button--{% if block.settings.cta_style == 'outline' %}secondary{% else %}primary{% endif %} {% endif %}ct-btn ct-btn--{{ block.settings.cta_style }} ct-btn-c{{ forloop.index }} color-{% if block.settings.cta_custom_scheme %}{{ block.settings.cta_scheme.id | default: block.settings.cta_scheme }}{% else %}{{ cta_scheme_id }}{% endif %}"
                      >{{ block.settings.cta_label | escape }}</a>
                    {%- endif -%}
                  </td>
                {%- endfor -%}
              </tr>
            </tfoot>
          {%- endif -%}
        </table>
      </div>
      </div>
      </div>
      <script src="{{ 'tdm-comparison-table.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <div class="ct-footnote rte">{{ section.settings.footnote }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="ct-cta">
        <a
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
          {% if section.settings.button_new_tab %}target="_blank" rel="noopener"{% endif %}
          class="{% if theme_btn %}button button--{% if section.settings.button_style == 'outline' %}secondary{% else %}primary{% endif %} {% endif %}ct-btn ct-btn--{{ section.settings.button_style }} color-{{ btn_scheme_id }}"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Tabla comparativa",
  "tag": "section",
  "class": "section section-comparison-table",
  "max_blocks": 50,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "ID de ancla",
      "info": "Para enlazar a esta sección desde un botón. 1 o 2 palabras en español separadas por guion, ej. formulario o como-funciona. Enlace: /pages/aliados#formulario"
    },
    { "type": "header", "content": "Contenido" },
    { "type": "text", "id": "pretitle", "label": "Eyebrow", "info": "Texto pequeño arriba del título. La línea aparece solo si hay texto.", "placeholder": "Ej. Planes" },
    { "type": "color", "id": "rule_color", "label": "Color de la línea del eyebrow", "default": "#294E3F" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Compara nuestros planes" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamaño del título",
      "options": [
        { "value": "h2", "label": "Pequeño" },
        { "value": "h1", "label": "Mediano" },
        { "value": "h0", "label": "Grande" }
      ],
      "default": "h1"
    },
    { "type": "richtext", "id": "description", "label": "Descripción" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación del título y eyebrow",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "center"
    },
    { "type": "richtext", "id": "footnote", "label": "Notas al pie (debajo de la tabla)", "info": "Útil para aclaraciones con asteriscos (*)." },

    { "type": "header", "content": "Colores" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de la sección (fondo general)", "default": "scheme-1" },
    { "type": "color_scheme", "id": "table_color_scheme", "label": "Esquema de la tabla (contenido)", "default": "scheme-2", "info": "Fondo y texto de la tabla. El color de acento (palomitas) usa el color de botón de este esquema." },
    {
      "type": "select",
      "id": "check_color",
      "label": "Color de palomitas",
      "options": [
        { "value": "text", "label": "Color de texto" },
        { "value": "accent", "label": "Color de acento (botón del esquema)" }
      ],
      "default": "text"
    },

    { "type": "header", "content": "Tabla" },
    { "type": "paragraph", "content": "Cada bloque Columna aparece a la derecha y las demás se ajustan automáticamente (máx. 6). En las celdas escribe \"si\" o \"✓\" para palomita y \"-\" o \"no\" para guion." },
    { "type": "range", "id": "first_column_width", "min": 15, "max": 40, "step": 1, "unit": "%", "default": 28, "label": "Ancho de la columna de características" },
    { "type": "text", "id": "first_column_label", "label": "Encabezado de la primera columna" },
    { "type": "checkbox", "id": "feature_bold", "label": "Características en negrita", "default": false },
    { "type": "checkbox", "id": "feature_tint", "label": "Sombrear columna de características", "default": false },
    {
      "type": "select",
      "id": "cell_align",
      "label": "Alineación de celdas",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "image_size", "min": 40, "max": 240, "step": 10, "unit": "px", "default": 120, "label": "Tamaño de imagen del encabezado" },
    {
      "type": "select",
      "id": "price_size",
      "label": "Tamaño del precio",
      "info": "Usa la escala de títulos del tema (H4–H1). En móvil se reduce igual que los títulos.",
      "options": [
        { "value": "default", "label": "Pequeño (actual)" },
        { "value": "h4", "label": "H4" },
        { "value": "h3", "label": "H3" },
        { "value": "h2", "label": "H2" },
        { "value": "h1", "label": "H1" }
      ],
      "default": "default"
    },
    { "type": "range", "id": "table_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12, "label": "Redondeo de la tabla" },
