{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-intro {
    padding-top: {{ section.settings.intro_padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.intro_padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-intro {
      padding-top: {{ section.settings.intro_padding_top }}px;
      padding-bottom: {{ section.settings.intro_padding_bottom }}px;
    }
  }

  .section-{{ section.id }}-cta {
    padding-top: {{ section.settings.cta_padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.cta_padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-cta {
      padding-top: {{ section.settings.cta_padding_top }}px;
      padding-bottom: {{ section.settings.cta_padding_bottom }}px;
    }
  }

  .slide-gallery-intro__inner > * + * {
    margin-top: 1.5rem;
  }

  .slide-gallery-intro__heading {
    margin: 0;
  }

  /* Eyebrow: mismas clases que Multicolumn Sept 2026 (.mc-eyebrow) */
  .slide-gallery-intro__head .mc-eyebrow + .slide-gallery-intro__heading {
    margin-top: 0.8rem;
  }

  .slide-gallery-intro__head--center .mc-eyebrow__rule {
    margin-left: auto;
    margin-right: auto;
  }

  .slide-gallery-intro__head--right .mc-eyebrow__rule {
    margin-left: auto;
    margin-right: 0;
  }

  .slide-gallery-intro__head,
  .slide-gallery-intro__text {
    width: 100%;
    max-width: {{ section.settings.header_max_width }}%;
  }

  @media screen and (max-width: 749px) {
    .slide-gallery-intro__head,
    .slide-gallery-intro__text {
      max-width: 100%;
    }
  }

  .slide-gallery-intro__head--left,
  .slide-gallery-intro__text--left { text-align: left; margin-left: 0; margin-right: auto; }
  .slide-gallery-intro__head--center,
  .slide-gallery-intro__text--center { text-align: center; margin-left: auto; margin-right: auto; }
  .slide-gallery-intro__head--right,
  .slide-gallery-intro__text--right { text-align: right; margin-left: auto; margin-right: 0; }

  .slide-gallery-intro__buttons--left { text-align: left; }
  .slide-gallery-intro__buttons--center { text-align: center; }
  .slide-gallery-intro__buttons--right { text-align: right; }

  .slide-gallery-intro__text > *:first-child {
    margin-top: 0;
  }

  .slide-gallery-intro__text > *:last-child {
    margin-bottom: 0;
  }


  .slide-gallery-intro__btn--pill {
    border-radius: 999px;
  }

  .slide-gallery-intro__btn--pill::after,
  .slide-gallery-intro__btn--pill::before {
    border-radius: 999px;
  }

  {%- if section.settings.layout == 'grid' -%}
    /* Con padding: contenedor con márgenes + esquinas redondeadas (igual que el Hero) */
    .slide-gallery-{{ section.id }}.page-width {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      padding-left: {{ section.settings.padding_x_mobile }}px;
      padding-right: {{ section.settings.padding_x_mobile }}px;
    }

    @media screen and (min-width: 750px) {
      .slide-gallery-{{ section.id }}.page-width {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
        padding-left: {{ section.settings.padding_x_desktop }}px;
        padding-right: {{ section.settings.padding_x_desktop }}px;
      }
    }

    #Slider-{{ section.id }} {
      border-radius: {{ section.settings.corner_radius }}px;
      isolation: isolate;
    }
  {%- else -%}
    /* Ancho completo: de orilla a orilla, sin redondeo */
    #Slider-{{ section.id }} {
      border-radius: 0;
    }
  {%- endif -%}
{%- endstyle -%}

{%- if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image != blank -%}
  {%- style -%}
    #Slider-{{ section.id }}::before,
    #Slider-{{ section.id }} .media::before {
      padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
      content: '';
      display: block;
    }
  {%- endstyle -%}
{%- endif -%}

{%- liquid
  assign has_cta = false
  if section.settings.button_label != blank
    assign has_cta = true
  endif

  assign has_text = false
  if section.settings.eyebrow != blank or section.settings.intro_title != blank or section.settings.intro_text != blank
    assign has_text = true
  endif

  assign cta_with_text = false
  if has_cta and section.settings.cta_position == section.settings.intro_position
    assign cta_with_text = true
  endif
-%}

{%- liquid
  if cta_with_text
    assign cta_align = section.settings.intro_text_alignment
  else
    assign cta_align = section.settings.cta_alignment
  endif
-%}

{%- capture cta_button -%}
  <div class="slide-gallery-intro__buttons slide-gallery-intro__buttons--{{ cta_align }}">
    <a
      {% if section.settings.button_link != blank %}
        href="{{ section.settings.button_link }}"
      {% else %}
        role="link" aria-disabled="true"
      {% endif %}
      class="button {% if section.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}{% if section.settings.button_pill %} slide-gallery-intro__btn--pill{% endif %}"
    >
      {{- section.settings.button_label | escape -}}
    </a>
  </div>
{%- endcapture -%}

{%- capture intro -%}
  {%- if has_text or cta_with_text -%}
    <div class="slide-gallery-intro section-{{ section.id }}-intro color-{{ section.settings.intro_color_scheme }} gradient">
      <div class="slide-gallery-intro__inner page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.eyebrow != blank or section.settings.intro_title != blank -%}
          <div class="slide-gallery-intro__head slide-gallery-intro__head--{{ section.settings.intro_alignment }}">
            {%- if section.settings.eyebrow != blank -%}
              <div class="mc-eyebrow">
                {{ section.settings.eyebrow }}
                {%- if section.settings.show_rule -%}
                  <div
                    class="mc-eyebrow__rule"
                    aria-hidden="true"
                    style="background-color: {{ section.settings.rule_color }}; border-color: {{ section.settings.rule_color }};"
                  ></div>
                {%- endif -%}
              </div>
            {%- endif -%}
            {%- if section.settings.intro_title != blank -%}
              <h2 class="slide-gallery-intro__heading inline-richtext {{ section.settings.intro_heading_size }}">
                {{ section.settings.intro_title }}
              </h2>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.intro_text != blank -%}
          <div class="slide-gallery-intro__text slide-gallery-intro__text--{{ section.settings.intro_text_alignment }} rte">
            {{ section.settings.intro_text }}
          </div>
        {%- endif -%}
        {%- if cta_with_text -%}
          {{ cta_button }}
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture cta_alone -%}
  {%- if has_cta and cta_with_text == false -%}
    <div class="slide-gallery-cta section-{{ section.id }}-cta color-{{ section.settings.intro_color_scheme }} gradient">
      <div class="page-width">
        {{ cta_button }}
      </div>
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture slider_controls_inner -%}
  <button
    type="button"
    class="slider-button slider-button--prev"
    name="previous"
    aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
    aria-controls="Slider-{{ section.id }}"
  >
    <span class="svg-wrapper">
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </span>
  </button>
  <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
    {%- if section.settings.slider_visual == 'counter' -%}
      <span class="slider-counter--current">1</span>
      <span aria-hidden="true"> / </span>
      <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
      <span class="slider-counter--total">{{ section.blocks.size }}</span>
    {%- else -%}
      <div class="slideshow__control-wrapper">
        {%- for block in section.blocks -%}
          <button
            class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
            aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
            aria-controls="Slider-{{ section.id }}"
          >
            {%- if section.settings.slider_visual == 'numbers' -%}
              {{ forloop.index -}}
            {%- else -%}
              <span class="dot"></span>
            {%- endif -%}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  <button
    type="button"
    class="slider-button slider-button--next"
    name="next"
    aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
    aria-controls="Slider-{{ section.id }}"
  >
    <span class="svg-wrapper">
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </span>
  </button>
{%- endcapture -%}

{%- if section.settings.intro_position == 'top' -%}
  {{ intro }}
{%- endif -%}
{%- if section.settings.cta_position == 'top' -%}
  {{ cta_alone }}
{%- endif -%}

<slideshow-component
  class="slide-gallery-{{ section.id }} slider-mobile-gutter{% if section.settings.layout == 'grid' %} page-width{% endif %}"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  {%- if section.settings.auto_rotate and section.blocks.size > 1 -%}
    <div class="slideshow__controls slideshow__controls--top slider-buttons">
      {{ slider_controls_inner }}
      <button
        type="button"
        class="slideshow__autoplay slider-button"
        aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-pause.svg' | inline_asset_content -}}
        </span>
        <span class="svg-wrapper">
          {{- 'icon-play.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>
  {%- endif -%}

  <div
    class="slideshow banner banner--{{ section.settings.slide_height }} grid grid--1-col slider slider--everywhere{% if section.blocks.first.settings.image == blank %} slideshow--placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    id="Slider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_speed }}"
  >
    {%- for block in section.blocks -%}
      <div
        class="slideshow__slide grid__item grid--1-col slider__slide"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        {{ block.shopify_attributes }}
        role="group"
        aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
        tabindex="-1"
      >
        <div class="slideshow__media banner__media media{% if block.settings.image == blank %} placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
          {%- if block.settings.image -%}
            {%- liquid
              assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
              if section.settings.image_behavior == 'ambient'
                assign sizes = '120vw'
                assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
              else
                assign sizes = '100vw'
                assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
              endif
              assign fetch_priority = 'auto'
              if section.index == 1
                assign fetch_priority = 'high'
              endif
            -%}
            {%- if forloop.first %}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag: height: height, sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
              }}
            {%- endif -%}
          {%- else -%}
            {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
            {%- if placeholder_slide == 1 -%}
              {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 and section.settings.auto_rotate == false -%}
    <div class="slideshow__controls slider-buttons">
      {{ slider_controls_inner }}
    </div>
  {%- endif -%}
</slideshow-component>

{%- if section.settings.intro_position == 'bottom' -%}
  {{ intro }}
{%- endif -%}
{%- if section.settings.cta_position == 'bottom' -%}
  {{ cta_alone }}
{%- endif -%}

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Slide gallery",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "placeholder": "Ej. Explora",
      "info": "Deja vacío para ocultarlo."
    },
    {
      "type": "color",
      "id": "rule_color",
      "label": "Color de la línea del eyebrow",
      "default": "#294E3F"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Mostrar línea del eyebrow",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "intro_title",
      "label": "Título de la sección",
      "default": "Título de la sección"
    },
    {
      "type": "select",
      "id": "intro_heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "Tamaño del título"
    },
    {
      "type": "text_alignment",
      "id": "intro_alignment",
      "label": "Alineación del título y eyebrow",
      "default": "center"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Párrafo introductorio",
      "default": "<p>Escribe aquí una descripción breve que acompañe a la galería.</p>"
    },
    {
      "type": "text_alignment",
      "id": "intro_text_alignment",
      "label": "Alineación del párrafo",
      "default": "center"
    },
    {
      "type": "range",
      "id": "header_max_width",
      "label": "Ancho máximo del título y párrafo",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "select",
      "id": "intro_position",
      "options": [
        {
          "value": "top",
          "label": "Arriba de la galería"
        },
        {
          "value": "bottom",
          "label": "Abajo de la galería"
        }
      ],
      "default": "top",
      "label": "Posición del texto"
    },
    {
      "type": "color_scheme",
      "id": "intro_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "intro_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "intro_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 36
    },
    {
      "type": "header",
      "content": "Botón (CTA) de la sección"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Ver más",
      "info": "Deja vacío para ocultar el botón."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "label": "Usar estilo secundario",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "button_pill",
      "label": "Botón redondeado (pill)",
      "default": true
    },
    {
      "type": "select",
      "id": "cta_position",
      "options": [
        {
          "value": "top",
          "label": "Arriba de la galería"
        },
        {
          "value": "bottom",
          "label": "Abajo de la galería"
        }
      ],
      "default": "bottom",
      "label": "Posición del CTA",
      "info": "Si coincide con la posición del texto, el botón va debajo del párrafo."
    },
    {
      "type": "text_alignment",
      "id": "cta_alignment",
      "label": "Alineación del CTA",
      "default": "center",
      "info": "Solo aplica cuando el CTA está separado del texto. Si va junto al texto, usa la alineación del párrafo."
    },
    {
      "type": "range",
      "id": "cta_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior del CTA",
      "default": 24,
      "info": "Solo aplica cuando el CTA está separado del texto."
    },
    {
      "type": "range",
      "id": "cta_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior del CTA",
      "default": 36,
      "info": "Solo aplica cuando el CTA está separado del texto."
    },
    {
      "type": "header",
      "content": "Galería"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "full_bleed",
          "label": "Ancho completo"
        },
        {
          "value": "grid",
          "label": "Con padding"
        }
      ],
      "default": "grid",
      "label": "Diseño"
    },
    {
      "type": "paragraph",
      "content": "El radio y los paddings solo aplican con el diseño \"Con padding\"."
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Radio de las esquinas",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_x_desktop",
      "label": "Padding lateral (escritorio)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "Padding lateral (móvil)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "slide_height",
      "options": [
        {
          "value": "adapt_image",
          "label": "t:sections.slideshow.settings.slide_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.slideshow.settings.slide_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.slideshow.settings.slide_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.slideshow.settings.slide_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.slideshow.settings.slide_height.label"
    },
    {
      "type": "select",
      "id": "slider_visual",
      "options": [
        {
          "value": "dots",
          "label": "t:sections.slideshow.settings.slider_visual.options__2.label"
        },
        {
          "value": "counter",
          "label": "t:sections.slideshow.settings.slider_visual.options__1.label"
        },
        {
          "value": "numbers",
          "label": "t:sections.slideshow.settings.slider_visual.options__3.label"
        }
      ],
      "default": "counter",
      "label": "t:sections.slideshow.settings.slider_visual.label"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.slideshow.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 2,
      "unit": "s",
      "label": "t:sections.slideshow.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.animation.image_behavior.options__1.label"
        },
        {
          "value": "ambient",
          "label": "t:sections.all.animation.image_behavior.options__2.label"
        }
      ],
      "default": "none",
      "label": "t:sections.all.animation.image_behavior.label"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.accessibility.content"
    },
    {
      "type": "text",
