{%- comment -%}
  Hero Slider — Dawn 15.x
  - Cada bloque "Slide" tiene su propia imagen, textos, 2 botones y pie de foto (nombre / tipo de cultivo)
  - Con 1 slide se comporta como hero fijo; con 2+ se activa el slider
  - Botones usan las clases .button de Dawn + esquema de color por botón
{%- endcomment -%}

{%- liquid
  assign sec = section.settings
  assign slides = section.blocks | where: 'type', 'slide'
  assign uid = 'tdm-hs-' | append: section.id
  assign font = sec.heading_font
-%}

<style>
  {%- if sec.use_custom_font and font -%}
    {{ font | font_face: font_display: 'swap' }}
  {%- endif -%}

  #{{ uid }} {
    --hs-h-desktop: {{ sec.min_height_desktop }}vh;
    --hs-h-mobile: {{ sec.min_height_mobile }}vh;
    --hs-radius: {{ sec.corner_radius }}px;
    --hs-content-max: {{ sec.content_max_width }}px;
    --hs-heading-size: {{ sec.heading_size }}px;
    --hs-heading-family: {% if sec.use_custom_font and font %}{{ font.family }}, {{ font.fallback_families }}{% else %}var(--font-heading-family){% endif %};
    --hs-heading-weight: {% if sec.use_custom_font and font %}{{ font.weight }}{% else %}var(--font-heading-weight){% endif %};
    --hs-heading-style: {% if sec.use_custom_font and font %}{{ font.style }}{% else %}var(--font-heading-style){% endif %};
    padding-top: {{ sec.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ sec.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    #{{ uid }} { padding-top: {{ sec.padding_top }}px; padding-bottom: {{ sec.padding_bottom }}px; }
  }

  /* ===== Estructura ===== */
  #{{ uid }} .tdm-hs__viewport { position: relative; border-radius: var(--hs-radius); overflow: hidden; }
  #{{ uid }} .tdm-hs__track {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    scrollbar-width: none; -webkit-overflow-scrolling: touch; margin: 0; padding: 0; list-style: none;
  }
  #{{ uid }} .tdm-hs__track::-webkit-scrollbar { display: none; }

  #{{ uid }} .tdm-hs__slide {
    position: relative; flex: 0 0 100%; scroll-snap-align: start;
    min-height: var(--hs-h-desktop);
    display: flex;
    align-items: {{ sec.content_vertical }};
    justify-content: {% if sec.content_align == 'center' %}center{% else %}flex-start{% endif %};
    padding: clamp(2.4rem, 5vw, 6.4rem) clamp(2rem, 4vw, 6.4rem) clamp(9rem, 9vw, 11rem);
    color: var(--hs-text);
    background: #1f2a1f;
  }
  @media screen and (max-width: 749px) {
    #{{ uid }} .tdm-hs__slide { min-height: var(--hs-h-mobile); align-items: flex-end; }
  }

  /* ===== Imagen + overlay ===== */
  #{{ uid }} .tdm-hs__media, #{{ uid }} .tdm-hs__media img, #{{ uid }} .tdm-hs__media svg {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  #{{ uid }} .tdm-hs__media svg { background: rgba(255,255,255,.06); fill: rgba(255,255,255,.25); }
  #{{ uid }} .tdm-hs__overlay { position: absolute; inset: 0; background: var(--hs-overlay); opacity: var(--hs-overlay-opacity); }
  #{{ uid }} .tdm-hs__img--mobile { display: none; }
  @media screen and (max-width: 749px) {
    #{{ uid }} .tdm-hs__media--has-mobile .tdm-hs__img--desktop { display: none; }
    #{{ uid }} .tdm-hs__media--has-mobile .tdm-hs__img--mobile { display: block; }
  }

  /* ===== Contenido ===== */
  #{{ uid }} .tdm-hs__content {
    position: relative; z-index: 2; max-width: var(--hs-content-max); width: 100%;
    text-align: {{ sec.content_align }};
  }
  #{{ uid }} .tdm-hs__eyebrow {
    margin: 0 0 1.2rem;
    font-family: var(--font-mono-family, ui-monospace, monospace);
    font-weight: 300; font-size: 1.4rem; letter-spacing: .06em; text-transform: uppercase;
    color: var(--hs-accent);
  }
  #{{ uid }} .tdm-hs__heading {
    margin: 0 0 1.6rem;
    font-family: var(--hs-heading-family); font-weight: var(--hs-heading-weight); font-style: var(--hs-heading-style);
    font-size: clamp(3.2rem, 5vw, var(--hs-heading-size)); line-height: 1.08; letter-spacing: -0.01em;
    color: var(--hs-text);
  }
  #{{ uid }} .tdm-hs__heading p { margin: 0; }
  {%- if sec.accent_marks -%}
  #{{ uid }} .tdm-hs__heading em, #{{ uid }} .tdm-hs__heading strong { font-style: inherit; font-weight: inherit; color: var(--hs-accent); }
  {%- endif -%}
  #{{ uid }} .tdm-hs__text { margin: 0 0 2.4rem; font-size: 1.6rem; line-height: 1.6; color: var(--hs-text); opacity: .92; }
  #{{ uid }} .tdm-hs__text p { margin: 0 0 .8rem; }
  #{{ uid }} .tdm-hs__text p:last-child { margin-bottom: 0; }
  #{{ uid }} .tdm-hs__text a { color: inherit; }

  /* ===== Botones (Dawn .button + esquema propio) ===== */
  #{{ uid }} .tdm-hs__buttons {
    display: flex; gap: 1.2rem;
    flex-direction: {% if sec.buttons_layout == 'stacked' %}column{% else %}row{% endif %};
    flex-wrap: wrap;
    align-items: {% if sec.content_align == 'center' %}center{% else %}flex-start{% endif %};
    justify-content: {% if sec.content_align == 'center' %}center{% else %}flex-start{% endif %};
  }
  #{{ uid }} .tdm-hs__buttons .button {
    background-color: rgba(var(--color-button), var(--alpha-button-background));
    color: rgb(var(--color-button-text));
    margin: 0;
    {%- if sec.buttons_heading_font -%}
    font-family: var(--hs-heading-family); font-weight: var(--hs-heading-weight);
    {%- endif -%}
  }
  {%- if sec.button_pill -%}
  #{{ uid }} .tdm-hs__buttons .button { --buttons-radius: 999px; --buttons-radius-outset: 999px; border-radius: 999px; }
  {%- endif -%}
  {%- if sec.button_size == 'small' -%}
  #{{ uid }} .tdm-hs__buttons .button { min-height: 3.6rem; min-width: 0; padding: 0 2.4rem; font-size: 1.4rem; }
  {%- endif -%}

  /* ===== Pie de foto (nombre / tipo de cultivo) ===== */
  #{{ uid }} .tdm-hs__caption {
    position: absolute; z-index: 2; bottom: clamp(2rem, 3vw, 3.2rem);
    max-width: 32rem; font-size: 1.5rem; line-height: 1.35; color: var(--hs-text);
  }
  #{{ uid }} .tdm-hs__caption--bottom-left { left: clamp(2rem, 4vw, 6.4rem); }
  #{{ uid }} .tdm-hs__caption--bottom-right { right: clamp(2rem, 4vw, 6.4rem); text-align: right; }
  #{{ uid }} .tdm-hs__caption p { margin: 0; }
  #{{ uid }} .tdm-hs__caption strong { font-weight: 700; }
  @media screen and (max-width: 749px) {
    #{{ uid }} .tdm-hs__caption { position: relative; inset: auto; order: 3; margin-top: 2rem; }
    #{{ uid }} .tdm-hs__slide { flex-direction: column; justify-content: flex-end; align-items: stretch; }
    #{{ uid }} .tdm-hs__content { align-self: {% if sec.content_align == 'center' %}center{% else %}flex-start{% endif %}; }
  }

  /* ===== Controles ===== */
  #{{ uid }} .tdm-hs__controls {
    position: absolute; z-index: 3; right: clamp(1.6rem, 3vw, 3.2rem); bottom: clamp(1.6rem, 3vw, 3.2rem);
    display: flex; align-items: center; gap: 1.2rem;
  }
  /* Centro abajo */
  #{{ uid }} .tdm-hs__controls--center { left: 50%; right: auto; transform: translateX(-50%); }
  /* Flechas a los lados (centradas verticalmente) + puntos centro abajo */
  #{{ uid }} .tdm-hs__controls--sides { inset: 0; transform: none; pointer-events: none; }
  #{{ uid }} .tdm-hs__controls--sides > * { pointer-events: auto; }
  #{{ uid }} .tdm-hs__controls--sides .tdm-hs__arrow { position: absolute; top: 50%; transform: translateY(-50%); }
  #{{ uid }} .tdm-hs__controls--sides .tdm-hs__arrow[data-dir="-1"] { left: clamp(1.2rem, 2vw, 2.4rem); }
  #{{ uid }} .tdm-hs__controls--sides .tdm-hs__arrow[data-dir="1"] { right: clamp(1.2rem, 2vw, 2.4rem); }
  #{{ uid }} .tdm-hs__controls--sides .tdm-hs__dots { position: absolute; left: 50%; bottom: clamp(1.6rem, 3vw, 3.2rem); transform: translateX(-50%); }
  #{{ uid }} .tdm-hs__arrow {
    width: 4.4rem; height: 4.4rem; border-radius: 50%; border: 1px solid rgba(255,255,255,.6);
    background: rgba(0,0,0,.25); color: #fff; display: grid; place-items: center; cursor: pointer; padding: 0;
    -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); transition: background .2s;
  }
  #{{ uid }} .tdm-hs__arrow:hover { background: rgba(0,0,0,.5); }
  #{{ uid }} .tdm-hs__arrow svg { width: 1.6rem; height: 1.6rem; }
  #{{ uid }} .tdm-hs__dots { display: flex; gap: .8rem; }
  #{{ uid }} .tdm-hs__dot {
    width: .9rem; height: .9rem; border-radius: 99px; border: 0; padding: 0; cursor: pointer;
    background: rgba(255,255,255,.45); transition: width .25s, background .25s;
  }
  #{{ uid }} .tdm-hs__dot[aria-current="true"] { width: 2.4rem; background: #fff; }
  @media screen and (max-width: 749px) {
    #{{ uid }} .tdm-hs__arrow { display: none; }
    #{{ uid }} .tdm-hs__controls { top: 1.6rem; bottom: auto; }
    #{{ uid }} .tdm-hs__controls--sides { inset: 0; }
    #{{ uid }} .tdm-hs__controls--sides .tdm-hs__dots { top: 1.6rem; bottom: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    #{{ uid }} .tdm-hs__track { scroll-behavior: auto; }
  }
</style>

<tdm-hero-slider
  id="{{ uid }}"
  class="tdm-hs"
  data-autoplay="{{ sec.autoplay }}"
  data-speed="{{ sec.autoplay_speed | times: 1000 }}"
  role="region"
  aria-roledescription="carousel"
  aria-label="{{ sec.aria_label | escape }}"
>
  <div class="{{ sec.container_width }}">
    <div class="tdm-hs__viewport">
      <ul class="tdm-hs__track">
        {%- for block in slides -%}
          {%- liquid
            assign b = block.settings
            assign is_first = forloop.first
            if b.image_mobile != blank
              assign has_mobile = true
            else
              assign has_mobile = false
            endif
            assign pos_d = ''
            assign pos_m = ''
            if b.image.presentation.focal_point != blank
              assign pos_d = 'object-position: ' | append: b.image.presentation.focal_point | append: ';'
            endif
            if b.image_mobile.presentation.focal_point != blank
              assign pos_m = 'object-position: ' | append: b.image_mobile.presentation.focal_point | append: ';'
            endif
            if b.image_alt != blank
              assign alt = b.image_alt
            else
              assign alt = b.image.alt
            endif
          -%}
          <li
            class="tdm-hs__slide"
            id="{{ uid }}-slide-{{ forloop.index }}"
            role="group"
            aria-roledescription="slide"
            aria-label="{{ forloop.index }} / {{ slides.size }}"
            style="--hs-text: {{ b.text_color }}; --hs-accent: {{ b.accent_color }}; --hs-overlay: {{ b.overlay_color }}; --hs-overlay-opacity: {{ b.overlay_opacity | divided_by: 100.0 }};"
            {{ block.shopify_attributes }}
          >
            <div class="tdm-hs__media{% if has_mobile %} tdm-hs__media--has-mobile{% endif %}">
              {%- if b.image != blank -%}
                {%- if is_first -%}{%- assign load = 'eager' -%}{%- else -%}{%- assign load = 'lazy' -%}{%- endif -%}
                {{ b.image
                  | image_url: width: 3000
                  | image_tag:
                    class: 'tdm-hs__img tdm-hs__img--desktop',
                    widths: '750, 1100, 1500, 2000, 2500, 3000',
                    sizes: '100vw',
                    loading: load,
                    alt: alt,
                    style: pos_d
                }}
              {%- else -%}
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'tdm-hs__img tdm-hs__img--desktop' }}
              {%- endif -%}
              {%- if has_mobile -%}
                {{ b.image_mobile
                  | image_url: width: 1500
                  | image_tag:
                    class: 'tdm-hs__img tdm-hs__img--mobile',
                    widths: '500, 750, 1100, 1500',
                    sizes: '100vw',
                    loading: 'lazy',
                    alt: alt,
                    style: pos_m
                }}
              {%- endif -%}
              <div class="tdm-hs__overlay" aria-hidden="true"></div>
            </div>

            <div class="tdm-hs__content">
              {%- if b.eyebrow != blank -%}
                <p class="tdm-hs__eyebrow">{{ b.eyebrow }}</p>
              {%- endif -%}

              {%- if b.heading != blank -%}
                <div class="tdm-hs__heading" role="heading" aria-level="{% if is_first %}1{% else %}2{% endif %}">
                  {{ b.heading }}
                </div>
              {%- endif -%}

              {%- if b.text != blank -%}
                <div class="tdm-hs__text">{{ b.text }}</div>
              {%- endif -%}

              {%- if b.button_1_label != blank or b.button_2_label != blank -%}
                <div class="tdm-hs__buttons">
                  {%- for n in (1..2) -%}
                    {%- liquid
                      assign k = 'button_' | append: n
                      assign k_label = k | append: '_label'
                      assign k_link = k | append: '_link'
                      assign k_style = k | append: '_style'
                      assign k_scheme = k | append: '_scheme'
                      assign k_tab = k | append: '_new_tab'
                      assign label = b[k_label]
                      assign link = b[k_link]
                    -%}
                    {%- if label != blank -%}
                      <a
                        {% if link != blank %}href="{{ link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                        {% if b[k_tab] %}target="_blank" rel="noopener"{% endif %}
                        class="button button--{{ b[k_style] }} color-{{ b[k_scheme] }}"
                      >
                        {{- label | escape -}}
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>

            {%- if b.caption != blank -%}
              <div class="tdm-hs__caption tdm-hs__caption--{{ b.caption_position }}">{{ b.caption }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if slides.size > 1 -%}
        <div class="tdm-hs__controls tdm-hs__controls--{{ sec.controls_position | default: 'center' }}">
          {%- if sec.show_arrows -%}
            <button type="button" class="tdm-hs__arrow" data-dir="-1" aria-label="Anterior">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
          {%- endif -%}
          {%- if sec.show_dots -%}
            <div class="tdm-hs__dots">
              {%- for block in slides -%}
                <button type="button" class="tdm-hs__dot" data-index="{{ forloop.index0 }}" aria-label="Ir al slide {{ forloop.index }}" aria-controls="{{ uid }}-slide-{{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if sec.show_arrows -%}
            <button type="button" class="tdm-hs__arrow" data-dir="1" aria-label="Siguiente">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</tdm-hero-slider>

<script>
  if (!customElements.get('tdm-hero-slider')) {
    customElements.define('tdm-hero-slider', class extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.tdm-hs__track');
        this.slides = Array.from(this.querySelectorAll('.tdm-hs__slide'));
        this.dots = Array.from(this.querySelectorAll('.tdm-hs__dot'));
        this.index = 0;
        if (this.slides.length < 2) return;

        this.querySelectorAll('.tdm-hs__arrow').forEach((btn) =>
          btn.addEventListener('click', () => { this.stop(); this.goTo(this.index + Number(btn.dataset.dir)); })
        );
        this.dots.forEach((dot) =>
          dot.addEventListener('click', () => { this.stop(); this.goTo(Number(dot.dataset.index)); })
        );

        let t;
        this.track.addEventListener('scroll', () => {
          clearTimeout(t);
          t = setTimeout(() => this.sync(), 60);
        }, { passive: true });

        this.track.addEventListener('pointerdown', () => this.stop());
        this.addEventListener('mouseenter', () => this.pause());
        this.addEventListener('mouseleave', () => this.play());
        this.addEventListener('focusin', () => this.pause());
        this.addEventListener('focusout', () => this.play());

        this.onBlockSelect = (e) => {
          const i = this.slides.indexOf(e.target);
          if (i > -1) { this.stop(); this.goTo(i, true); }
        };
        document.addEventListener('shopify:block:select', this.onBlockSelect);

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const inEditor = window.Shopify && Shopify.designMode;
        this.autoplay = this.dataset.autoplay === 'true' && !reduce && !inEditor;
        this.play();
      }
      disconnectedCallback() {
        this.stop();
        if (this.onBlockSelect) document.removeEventListener('shopify:block:select', this.onBlockSelect);
      }
      goTo(i, instant) {
        const n = this.slides.length;
        this.index = ((i % n) + n) % n;
        this.track.scrollTo({ left: this.index * this.track.clientWidth, behavior: instant ? 'auto' : 'smooth' });
        this.update();
      }
      sync() {
        const i = Math.round(this.track.scrollLeft / this.track.clientWidth);
        if (i !== this.index) { this.index = i; this.update(); }
      }
      update() {
        this.dots.forEach((d, i) => d.setAttribute('aria-current', i === this.index ? 'true' : 'false'));
      }
      play() {
        if (!this.autoplay || this.timer) return;
        this.timer = setInterval(() => this.goTo(this.index + 1), Number(this.dataset.speed) || 6000);
      }
      pause() { clearInterval(this.timer); this.timer = null; }
      stop() { this.pause(); this.autoplay = false; }
    });
  }
</script>

{% schema %}
{
  "name": "Hero slider",
  "tag": "section",
  "class": "section tdm-hero-slider-section",
  "max_blocks": 8,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Tamaño y contenedor" },
    {
      "type": "select",
      "id": "container_width",
      "label": "Ancho",
      "options": [
        { "value": "page-width", "label": "Estándar (dentro del contenedor)" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "page-width"
    },
    { "type": "range", "id": "min_height_desktop", "min": 40, "max": 100, "step": 5, "unit": "vh", "default": 85, "label": "Altura mínima escritorio" },
    { "type": "range", "id": "min_height_mobile", "min": 40, "max": 100, "step": 5, "unit": "vh", "default": 80, "label": "Altura mínima móvil" },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0, "label": "Radio de esquinas" },

    { "type": "header", "content": "Contenido" },
    {
      "type": "select",
      "id": "content_vertical",
      "label": "Posición vertical del texto",
      "options": [
        { "value": "flex-start", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "flex-end", "label": "Abajo" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Alineación del texto",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "content_max_width", "min": 400, "max": 1000, "step": 20, "unit": "px", "default": 760, "label": "Ancho máximo del texto" },

    { "type": "header", "content": "Tipografía del título" },
    { "type": "range", "id": "heading_size", "min": 32, "max": 96, "step": 2, "unit": "px", "default": 60, "label": "Tamaño del título (escritorio)" },
    { "type": "checkbox", "id": "use_custom_font", "label": "Usar fuente personalizada en el título", "default": false, "info": "Si está apagado usa la fuente de títulos del tema." },
    { "type": "font_picker", "id": "heading_font", "label": "Fuente del título", "default": "assistant_n4", "info": "Ej. Barlow Condensed Light para el estilo de referencia." },
    { "type": "checkbox", "id": "accent_marks", "label": "Cursiva/negrita del título = color de acento", "default": true, "info": "Marca una palabra en cursiva para pintarla con el color de acento del slide." },

    { "type": "header", "content": "Botones" },
    {
      "type": "select",
      "id": "buttons_layout",
      "label": "Disposición",
      "options": [
        { "value": "stacked", "label": "Uno debajo del otro" },
        { "value": "row", "label": "En línea" }
      ],
      "default": "stacked"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Tamaño",
      "options": [
        { "value": "small", "label": "Pequeño" },
        { "value": "default", "label": "Normal (tema)" }
      ],
      "default": "small"
    },
    { "type": "checkbox", "id": "button_pill", "label": "Botones redondeados (pill)", "default": true },
    { "type": "checkbox", "id": "buttons_heading_font", "label": "Botones con la fuente del título", "default": true },

    { "type": "header", "content": "Slider" },
    { "type": "checkbox", "id": "autoplay", "label": "Reproducción automática", "default": true, "info": "Se desactiva dentro del editor para que puedas trabajar." },
    { "type": "range", "id": "autoplay_speed", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6, "label": "Tiempo por slide" },
    { "type": "checkbox", "id": "show_arrows", "label": "Mostrar flechas", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Mostrar puntos", "default": true },
    {
      "type": "select",
      "id": "controls_position",
      "label": "Posición de los controles",
      "options": [
        { "value": "center", "label": "Centro abajo" },
        { "value": "sides", "label": "Flechas a los lados, puntos al centro" },
        { "value": "right", "label": "Derecha abajo" }
      ],
      "default": "center"
    },
    { "type": "text", "id": "aria_label", "placeholder": "Ej. Programa de aliados", "label": "Nombre accesible del slider", "default": "Programa de aliados" },

    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0, "label": "Espaciado superior" },
