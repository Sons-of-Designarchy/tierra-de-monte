{%- comment -%}
  Feature — lead copy on the left, one of three layouts on the right.
  Replaces multicolumn-feature (stats), multicol-custom-feature (cards)
  and multicol-row-list (rows). Styles: assets/section-tdm-feature.css.
  Text goes through typography, the CTA through button, boxes through card.
{%- endcomment -%}

{{ 'section-tdm-feature.css' | asset_url | stylesheet_tag }}
{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- liquid
  assign layout = section.settings.layout | default: 'stats'
  assign cols_desktop = section.settings.columns_desktop | default: 3
  assign cols_tablet = cols_desktop | at_most: 3
  assign cols_mobile = section.settings.columns_mobile | default: '1'
  assign rule_color = section.settings.rule_color | default: 'currentColor'

  assign title_variant = 'h1'
  case section.settings.heading_size
    when 'h2'
      assign title_variant = 'h2'
    when 'h0' or 'hxl' or 'hxxl'
      assign title_variant = 'display'
  endcase
-%}

<div
  class="tdm-feature tdm-feature--{{ layout }} color-{{ section.settings.color_scheme }} gradient{% if section.settings.bg_image != blank %} tdm-has-bg{% endif %}"
  style="--feature-rule: {{ rule_color }}; --cols-mobile: {{ cols_mobile }}; --cols-tablet: {{ cols_tablet }}; --cols-desktop: {{ cols_desktop }};"
>
  {% render 'tdm-section-background', image: section.settings.bg_image, image_mobile: section.settings.bg_image_mobile, overlay: section.settings.bg_overlay, position: section.settings.bg_position %}
  <div
    class="page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- if section.settings.pretitle != blank -%}
      <div class="tdm-feature__eyebrow">
        {% render 'typography', text: section.settings.pretitle, variant: 'eyebrow' %}
        {%- if section.settings.show_rule -%}
          <div class="tdm-feature__rule" aria-hidden="true"></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="tdm-feature__split">
      <div class="tdm-feature__lead">
        {%- if section.settings.title != blank -%}
          {% render 'typography', text: section.settings.title, variant: title_variant, as: 'h2', font: 'display', weight: 'medium' %}
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          {% render 'typography', text: section.settings.description, variant: 'body-lg', as: 'div', class: 'rte' %}
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="tdm-feature__cta">
            {% render 'button', label: section.settings.button_label, href: section.settings.button_link, variant: 'primary', size: 'lg' %}
          </div>
        {%- endif -%}
      </div>

      {%- if layout == 'rows' -%}
        {%- assign row_size = section.settings.row_title_size | default: 20 -%}
        {%- capture row_px_raw -%}{% render 'tdm-type-from-px', px: row_size %}{%- endcapture -%}
        {%- assign row_px = row_px_raw | strip -%}
        <ul class="tdm-feature__rows" role="list">
          {%- for block in section.blocks -%}
            {%- capture row_inner -%}
              {%- if block.settings.image != blank -%}
                <span class="tdm-feature__icon" style="--icon-size: {{ block.settings.icon_size | default: 40 }}px;">
                  {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: '' }}
                </span>
              {%- endif -%}
              <span class="tdm-feature__row-texts">
                {%- if block.settings.title != blank -%}
                  {% render 'typography', text: block.settings.title, as: 'span', variant: row_px, font: 'display', weight: 'medium' %}
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  {%- assign row_font = 'body' -%}
                  {%- if block.settings.desc_font == 'mono' -%}{%- assign row_font = 'mono' -%}{%- endif -%}
                  {% render 'typography', text: block.settings.text, as: 'div', variant: 'body-sm', font: row_font, color: 'secondary', class: 'rte' %}
                {%- endif -%}
              </span>
              <span class="tdm-feature__row-arrow" aria-hidden="true">{% render 'icon', name: 'arrow-right', size: 'md' %}</span>
            {%- endcapture -%}
            <li class="tdm-feature__row" {{ block.shopify_attributes }}>
              {% render 'card', href: block.settings.link, content: row_inner, padding: 'md', class: 'tdm-feature__row-card' %}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <ul class="tdm-feature__grid" role="list">
          {%- for block in section.blocks -%}
            {%- assign stat_size = block.settings.stat_size_desktop | default: 72 -%}
            {%- capture stat_raw -%}{% render 'tdm-type-from-px', px: stat_size %}{%- endcapture -%}
            {%- assign stat_variant = stat_raw | strip -%}
            {%- assign stat_font = block.settings.stat_font | default: 'heading' -%}
            {%- assign stat_family = 'display' -%}
            {%- assign stat_weight = 'regular' -%}
            {%- if stat_font == 'mono' -%}
              {%- assign stat_family = 'mono' -%}
            {%- elsif stat_font == 'body' -%}
              {%- assign stat_family = 'body' -%}
              {%- assign stat_weight = 'bold' -%}
            {%- endif -%}
            {%- assign text_font = 'body' -%}
            {%- assign text_class = 'rte' -%}
            {%- assign text_variant = 'body' -%}
            {%- if layout == 'stats' or block.settings.desc_font == 'display' -%}
              {%- assign text_font = 'display' -%}
              {%- assign text_variant = 'h3' -%}
            {%- endif -%}
            {%- if layout != 'stats' and block.settings.desc_font == 'mono' -%}
              {%- assign text_font = 'mono' -%}
              {%- assign text_class = 'rte tdm-upper' -%}
            {%- endif -%}

            {%- capture info -%}
              <div class="tdm-feature__info">
                {%- if block.settings.title != blank -%}
                  {% render 'typography', text: block.settings.title, as: 'h3', variant: stat_variant, font: stat_family, weight: stat_weight %}
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  {% render 'typography', text: block.settings.text, as: 'div', variant: text_variant, font: text_font, class: text_class %}
                {%- endif -%}
                {%- if block.settings.link_label != blank -%}
                  {%- if block.settings.link != blank -%}
                    {% render 'link', text: block.settings.link_label, href: block.settings.link %}
                  {%- else -%}
                    {% render 'typography', text: block.settings.link_label, as: 'span', variant: 'body', weight: 'medium' %}
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endcapture -%}

            <li
              class="tdm-feature__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                style="--animation-order: {{ forloop.index }};"
                data-cascade
              {% endif %}
            >
              {%- if layout == 'cards' -%}
                {%- capture icon_html -%}
                  {%- if block.settings.image != blank -%}
                    <div class="tdm-feature__icon" style="--icon-size: {{ block.settings.icon_size | default: 40 }}px;">
                      {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: '' }}
                    </div>
                  {%- endif -%}
                {%- endcapture -%}
                {% render 'card', media: icon_html, content: info, padding: 'md', class: 'tdm-feature__tile' %}
              {%- else -%}
                <div class="tdm-feature__tile">
                  {{ info }}
                  {%- if block.settings.image != blank -%}
                    <div class="tdm-feature__media">
                      {{
                        block.settings.image
                        | image_url: width: 1600
                        | image_tag:
                          loading: 'lazy',
                          alt: '',
                          sizes: '(min-width: 990px) calc((100vw - 116px) * 7 / 12 / 3), (min-width: 750px) calc((100vw - 100px) / 3), calc(100vw - 30px)'
                      }}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stats", "label": "Stats — numbers with image" },
        { "value": "cards", "label": "Cards — icon tiles" },
        { "value": "rows", "label": "Rows — clickable list" }
      ],
      "default": "stats"
    },

    { "type": "header", "content": "Eyebrow" },
    { "type": "inline_richtext", "id": "pretitle", "label": "Eyebrow" },
    { "type": "checkbox", "id": "show_rule", "label": "Show rule under eyebrow", "default": true },
    { "type": "color", "id": "rule_color", "label": "Rule color", "default": "#294E3F" },

    { "type": "header", "content": "Lead" },
    { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Efecto Tierra de monte" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Title size",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h1", "label": "H1" },
        { "value": "h0", "label": "H0" },
        { "value": "hxl", "label": "HXL" },
        { "value": "hxxl", "label": "HXXL" }
      ],
      "default": "h1"
    },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Columns (stats and cards)" },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1",
      "label": "Columns on mobile"
    },

    { "type": "header", "content": "Rows" },
    {
      "type": "range",
      "id": "row_title_size",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Row title size",
      "default": 20
    },

    { "type": "header", "content": "Section" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" },

    { "type": "header", "content": "Imagen de fondo" },
    { "type": "image_picker", "id": "bg_image", "label": "Imagen de fondo" },
    { "type": "image_picker", "id": "bg_image_mobile", "label": "Imagen de fondo (móvil)", "info": "Opcional. Si está vacía usa la de escritorio." },
    { "type": "range", "id": "bg_overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Oscurecer imagen", "default": 40 },
    { "type": "select", "id": "bg_position", "label": "Enfoque de la imagen", "default": "center", "options": [
      { "value": "top", "label": "Arriba" }, { "value": "center", "label": "Centro" }, { "value": "bottom", "label": "Abajo" }
    ] },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (stats) / Icon (cards)" },
        {
          "type": "range",
          "id": "icon_size",
          "label": "Icon size (cards)",
          "min": 16,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 40
        },
        { "type": "inline_richtext", "id": "title", "label": "Heading / Stat", "default": "+230" },
        {
          "type": "select",
          "id": "stat_font",
          "label": "Heading font",
          "options": [
            { "value": "heading", "label": "Theme heading" },
            { "value": "body", "label": "Theme body (bold)" },
            { "value": "mono", "label": "Monospace" }
          ],
          "default": "heading"
        },
        {
          "type": "range",
          "id": "stat_size_mobile",
          "label": "Heading size (mobile)",
          "min": 8,
          "max": 108,
          "step": 1,
          "unit": "px",
          "default": 48
        },
        {
          "type": "range",
          "id": "stat_size_desktop",
          "label": "Heading size (desktop)",
          "min": 8,
          "max": 108,
          "step": 1,
          "unit": "px",
          "default": 72
        },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Hectáreas regeneradas</p>" },
        {
          "type": "select",
          "id": "desc_font",
          "label": "Text font (cards)",
          "info": "Stats columns always use the display font, large (h3).",
          "options": [
            { "value": "body", "label": "Theme body" },
            { "value": "mono", "label": "Monospace (uppercase)" },
            { "value": "display", "label": "Display, large (h3)" }
          ],
          "default": "body"
        },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Icon" },
        {
          "type": "range",
          "id": "icon_size",
          "label": "Icon size",
          "min": 16,
          "max": 60,
          "step": 1,
          "unit": "px",
          "default": 40
        },
        { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Ver más" },
        { "type": "richtext", "id": "text", "label": "Description" },
        {
          "type": "select",
          "id": "desc_font",
          "label": "Description font",
          "options": [
            { "value": "body", "label": "Theme body" },
            { "value": "mono", "label": "Monospace" }
          ],
          "default": "body"
        },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature — stats",
      "settings": { "layout": "stats" },
      "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }]
    },
    {
      "name": "Feature — cards",
      "settings": { "layout": "cards" },
      "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }]
    },
    {
      "name": "Feature — rows",
      "settings": { "layout": "rows" },
      "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }]
    }
  ]
}
{% endschema %}
