{% render 'tdm-anchor', id: section.settings.anchor_id %}
{{ 'section-tdm-collapsible-content.css' | asset_url | stylesheet_tag }}

{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- liquid
  case section.settings.heading_size
    when 'h2'
      assign cc_title_variant = 'h2'
    when 'h1'
      assign cc_title_variant = 'h1'
    else
      assign cc_title_variant = 'display'
  endcase

  assign cc_root_style = ''
  if section.settings.faq_editorial and section.settings.open_row_color_scheme != blank
    assign open_scheme = section.settings.open_row_color_scheme.settings
    assign open_bg = open_scheme.background | color_to_rgb | remove: 'rgb(' | remove: ')' | replace: ',', ''
    assign open_fg = open_scheme.text | color_to_rgb | remove: 'rgb(' | remove: ')' | replace: ',', ''
    assign cc_root_style = '--tdm-faq-open-bg: ' | append: open_bg | append: '; --tdm-faq-open-fg: ' | append: open_fg | append: ';'
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient{% if section.settings.bg_image != blank %} tdm-has-bg{% endif %}">
  {% render 'tdm-section-background', image: section.settings.bg_image, image_mobile: section.settings.bg_image_mobile, overlay: section.settings.bg_overlay, position: section.settings.bg_position %}
  <div class="collapsible-content collapsible-{{ section.settings.layout }}-layout isolate{% if section.settings.faq_editorial %} tdm-faq{% endif %}{% if section.settings.layout == 'section' %} page-width{% elsif section.settings.layout == 'none' %} content-container content-container--full-width{% endif %}"{% if cc_root_style != blank %} style="{{ cc_root_style }}"{% endif %}>
    <div class="collapsible-content__wrapper section-{{ section.id }}-padding{% if section.settings.layout == 'section' %} content-container color-{{ section.settings.container_color_scheme }} gradient{% endif %}">
      {%- comment -%} Eyebrow sits outside the narrow column so its rule spans the full page width {%- endcomment -%}
      {%- if section.settings.caption != blank -%}
        {%- assign eyebrow_text = section.settings.caption | escape -%}
        <div class="{% unless section.settings.layout == 'section' %}page-width{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- render 'tdm-section-eyebrow', text: eyebrow_text, rule_color: section.settings.rule_color, align: section.settings.heading_alignment -%}
        </div>
      {%- endif -%}
      <div class="{% if section.settings.image == blank %}collapsible-content-wrapper-narrow{% else %}page-width{% endif %}">
        <div class="collapsible-content__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- if section.settings.heading != blank -%}
            {%- render 'typography', text: section.settings.heading, as: 'h2', variant: cc_title_variant, font: 'display', weight: 'medium', align: section.settings.heading_alignment, class: 'collapsible-content__heading' -%}
          {%- else -%}
            <h2 class="visually-hidden">{{ 'accessibility.collapsible_content_title' | t }}</h2>
          {% endif %}
        </div>
        <div class="grid grid--1-col grid--2-col-tablet collapsible-content__grid{% if section.settings.desktop_layout == 'image_second' %} collapsible-content__grid--reverse{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- if section.settings.image != blank -%}
            <div class="grid__item collapsible-content__grid-item">
              <div
                class="collapsible-content__media collapsible-content__media--{{ section.settings.image_ratio }} media global-media-settings gradient"
                {% if section.settings.image_ratio == 'adapt' %}
                  style="--cc-adapt-pad: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
                {% endif %}
              >
                {%- liquid
                  assign padding_multiplier = 1
                  if section.settings.layout == 'section'
                    assign padding_multiplier = 2
                  endif
                  assign desktop_tablet_padding = 100 | times: padding_multiplier | append: 'px'
                  assign mobile_padding = 30 | times: padding_multiplier | append: 'px'
                -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ desktop_tablet_padding }}) / 2),
                  (min-width: 750px) calc((100vw - {{ desktop_tablet_padding }}) / 2),
                  calc(100vw - {{ mobile_padding }})
                {%- endcapture -%}
                {{
                  section.settings.image
                  | image_url: width: 3200
                  | image_tag:
                    sizes: sizes,
                    widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200'
                }}
              </div>
            </div>
          {% endif %}
          <div class="grid__item">
            {%- for block in section.blocks -%}
              {%- liquid
                # Row card: section-wide scheme, overridable per row
                assign row_card = section.settings.row_container
                assign row_scheme = section.settings.row_color_scheme
                if block.settings.use_custom_scheme
                  assign row_card = true
                  assign row_scheme = block.settings.color_scheme
                endif

                assign cc_row_class = 'cc-row'
                if row_card
                  assign cc_row_class = cc_row_class | append: ' cc-row--card color-' | append: row_scheme | append: ' gradient'
                elsif section.settings.layout == 'row'
                  assign cc_row_class = cc_row_class | append: ' content-container color-' | append: section.settings.container_color_scheme | append: ' gradient'
                endif

                assign cc_open = 0
                if section.settings.open_first_collapsible_row and forloop.first
                  assign cc_open = 1
                endif
                assign cc_heading = block.settings.heading | default: block.settings.page.title | escape
              -%}
              {%- capture cc_title -%}
                {%- render 'icon-accordion', icon: block.settings.icon -%}
                {{ cc_heading }}
              {%- endcapture -%}
              {%- capture cc_body -%}
                {{ block.settings.row_content }}{{ block.settings.page.content }}
              {%- endcapture -%}
              {%- capture cc_panel -%}
                {%- render 'typography', text: cc_body, as: 'div', variant: 'body', color: 'inherit', class: 'rte accordion__content' -%}
              {%- endcapture -%}
              <div class="cc-row-wrap" {{ block.shopify_attributes }}>
                {%- render 'accordion', titles: cc_title, panels: cc_panel, multiple: true, open: cc_open, title_font: 'display', class: cc_row_class -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

