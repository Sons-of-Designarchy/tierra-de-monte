{{ 'customer.css' | asset_url | stylesheet_tag }}

{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- if section.settings.enable_shop_login_button == false -%}
  {%- assign hide_shop_login_button = true -%}
{%- endif -%}

<div class="customer login section-{{ section.id }}-padding">
  {%- assign lg_email = 'customer.login_page.email' | t -%}
  {%- assign lg_password = 'customer.login_page.password' | t -%}
  {%- assign lg_submit = 'customer.login_page.submit' | t -%}
  {%- assign lg_cancel = 'customer.login_page.cancel' | t -%}
  {%- assign lg_recover_title = 'customer.recover_password.title' | t -%}
  {%- assign lg_recover_sub = 'customer.recover_password.subtext' | t -%}
  {%- assign lg_title = 'customer.login_page.title' | t -%}
  {%- assign lg_sign_in = 'customer.login_page.sign_in' | t -%}
  {%- assign lg_forgot = 'customer.login_page.forgot_password' | t -%}
  {%- assign lg_create = 'customer.login_page.create_account' | t -%}

  {% render 'typography', text: lg_recover_title, as: 'h1', variant: 'h2', align: 'center', id: 'recover', class: 'customer__title', attrs: 'tabindex="-1"' %}
  <div>
    {% render 'typography', text: lg_recover_sub, variant: 'body', color: 'secondary', align: 'center' %}

    {%- form 'recover_customer_password' -%}
      {% assign recover_success = form.posted_successfully? %}
      {%- assign lg_recover_error = '' -%}
      {%- if form.errors -%}
        {%- assign lg_recover_error = form.errors.messages.form -%}
      {%- endif -%}
      <div class="customer__fields">
        {%- capture lg_recover_attrs -%}autocorrect="off" autocapitalize="off"{% if form.errors %} autofocus{% endif %}{%- endcapture -%}
        {% render 'input', id: 'RecoverEmail', name: 'email', type: 'email', label: lg_email, autocomplete: 'email', error: lg_recover_error, attrs: lg_recover_attrs %}
      </div>
      <div class="customer__actions">
        {% render 'button', label: lg_submit, type: 'submit', variant: 'primary' %}
        <div class="customer__link">{% render 'link', text: lg_cancel, href: '#login' %}</div>
      </div>
    {%- endform -%}
  </div>

  {% render 'typography', text: lg_title, as: 'h1', variant: 'h2', align: 'center', id: 'login', class: 'customer__title', attrs: 'tabindex="-1"' %}
  <div>
    {%- if recover_success == true -%}
      {%- assign lg_recover_ok = 'customer.recover_password.success' | t -%}
      <div tabindex="-1" autofocus>
        {% render 'alert', tone: 'success', text: lg_recover_ok %}
      </div>
    {%- endif -%}
    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        {%- assign lg_error_title = 'templates.contact.form.error_heading' | t -%}
        {%- capture lg_errors -%}{{ form.errors | default_errors }}{%- endcapture -%}
        <div tabindex="-1" autofocus>
          {% render 'alert', tone: 'error', title: lg_error_title, content: lg_errors %}
        </div>
      {%- endif -%}

      {%- if shop.features.login_with_shop_classic_customer_accounts? -%}
        <section name="sign-in-with-shop-provider">
          {{ shop | login_button: hide_button: hide_shop_login_button }}

          {%- unless hide_shop_login_button -%}
            {%- assign lg_separator = 'customer.login_page.alternate_provider_separator' | t -%}
            {% render 'typography', text: lg_separator, variant: 'body', color: 'secondary', align: 'center', class: 'customer__separator' %}
          {%- endunless -%}
        </section>
      {%- endif -%}

      {%- capture lg_login_attrs -%}autocorrect="off" autocapitalize="off"{% if form.errors contains 'form' %} aria-invalid="true"{% endif %}{%- endcapture -%}
      <div class="customer__fields">
        {% render 'input', id: 'CustomerEmail', name: 'customer[email]', type: 'email', label: lg_email, autocomplete: 'email', attrs: lg_login_attrs %}

        {%- if form.password_needed -%}
          {% render 'input', id: 'CustomerPassword', name: 'customer[password]', type: 'password', label: lg_password, autocomplete: 'current-password', attrs: lg_login_attrs %}
          <div class="customer__link customer__link--start">{% render 'link', text: lg_forgot, href: '#recover' %}</div>
        {%- endif -%}
      </div>

      <div class="customer__actions">
        {% render 'button', label: lg_sign_in, type: 'submit', variant: 'primary' %}
        <div class="customer__link">{% render 'link', text: lg_create, href: routes.account_register_url %}</div>
      </div>
    {%- endform -%}
  </div>

  {%- if shop.checkout.guest_login -%}
    <div>
      <hr>
      {%- assign lg_guest_title = 'customer.login_page.guest_title' | t -%}
      {%- assign lg_guest_continue = 'customer.login_page.guest_continue' | t -%}
      {% render 'typography', text: lg_guest_title, as: 'h2', variant: 'h4', align: 'center' %}

      {%- form 'guest_login' -%}
        <div class="customer__actions">
          {% render 'button', label: lg_guest_continue, type: 'submit', variant: 'outline' %}
        </div>
      {%- endform -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main-login.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_shop_login_button",
      "label": "t:sections.main-login.shop_login_button.enable",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
