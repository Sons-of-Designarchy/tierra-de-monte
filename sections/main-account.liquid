{{ 'customer.css' | asset_url | stylesheet_tag }}

{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

<div class="customer account section-{{ section.id }}-padding">
  <div>
    {%- assign ac_title = 'customer.account.title' | t -%}
    {%- assign ac_logout = 'customer.log_out' | t -%}
    {% render 'typography', text: ac_title, as: 'h1', font: 'display', weight: 'medium', variant: 'h2', class: 'customer__title' %}
    {% render 'link', text: ac_logout, href: routes.account_logout_url %}
  </div>

  <div>
    <div>
      {%- assign ac_orders_title = 'customer.orders.title' | t -%}
      {% render 'typography', text: ac_orders_title, as: 'h2', variant: 'h4' %}

      {% paginate customer.orders by 20 %}
        {%- if customer.orders.size > 0 -%}
          <table role="table" class="order-history">
            <caption class="visually-hidden">
              {{ 'customer.orders.title' | t }}
            </caption>
            <thead role="rowgroup">
              <tr role="row">
                <th id="ColumnOrder" scope="col" role="columnheader">{% assign ac_th = 'customer.orders.order_number' | t %}{% render 'typography', text: ac_th, as: 'span', variant: 'label', weight: 'medium', color: 'secondary' %}</th>
                <th id="ColumnDate" scope="col" role="columnheader">{% assign ac_th = 'customer.orders.date' | t %}{% render 'typography', text: ac_th, as: 'span', variant: 'label', weight: 'medium', color: 'secondary' %}</th>
                <th id="ColumnPayment" scope="col" role="columnheader">{% assign ac_th = 'customer.orders.payment_status' | t %}{% render 'typography', text: ac_th, as: 'span', variant: 'label', weight: 'medium', color: 'secondary' %}</th>
                <th id="ColumnFulfillment" scope="col" role="columnheader">
                  {%- assign ac_th = 'customer.orders.fulfillment_status' | t -%}
                  {% render 'typography', text: ac_th, as: 'span', variant: 'label', weight: 'medium', color: 'secondary' %}
                </th>
                <th id="ColumnTotal" scope="col" role="columnheader">{% assign ac_th = 'customer.orders.total' | t %}{% render 'typography', text: ac_th, as: 'span', variant: 'label', weight: 'medium', color: 'secondary' %}</th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {%- for order in customer.orders -%}
                <tr role="row">
                  <td
                    id="RowOrder"
                    role="cell"
                    headers="ColumnOrder"
                    data-label="{{ 'customer.orders.order_number' | t }}"
                  >
                    {%- assign ac_order_label = 'customer.orders.order_number_link' | t: number: order.name -%}
                    {%- capture ac_order_attrs -%}aria-label="{{ ac_order_label | escape }}"{%- endcapture -%}
                    {% render 'button', label: order.name, href: order.customer_url, variant: 'outline', size: 'sm', attrs: ac_order_attrs %}
                  </td>
                  <td headers="RowOrder ColumnDate" role="cell" data-label="{{ 'customer.orders.date' | t }}">
                    {{ order.created_at | time_tag: format: 'date' }}
                  </td>
                  <td
                    headers="RowOrder ColumnPayment"
                    role="cell"
                    data-label="{{ 'customer.orders.payment_status' | t }}"
                  >
                    {{ order.financial_status_label }}
                  </td>
                  <td
                    headers="RowOrder ColumnFulfillment"
                    role="cell"
                    data-label="{{ 'customer.orders.fulfillment_status' | t }}"
                  >
                    {{ order.fulfillment_status_label }}
                  </td>
                  <td headers="RowOrder ColumnTotal" role="cell" data-label="{{ 'customer.orders.total' | t }}">
                    {{ order.total_net_amount | money_with_currency }}
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          {%- assign ac_none = 'customer.orders.none' | t -%}
          {% render 'typography', text: ac_none, variant: 'body' %}
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          {%- if paginate.parts.size > 0 -%}
            <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
              <ul role="list">
                {%- if paginate.previous -%}
                  <li>
                    <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
                      <span class="svg-wrapper">
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </span>
                    </a>
                  </li>
                {%- endif -%}

                {%- for part in paginate.parts -%}
                  <li>
                    {%- if part.is_link -%}
                      <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                        {{- part.title -}}
                      </a>
                    {%- else -%}
                      {%- if part.title == paginate.current_page -%}
                        <span aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                          {{- part.title -}}
                        </span>
                      {%- else -%}
                        <span>{{ part.title }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  </li>
                {%- endfor -%}

                {%- if paginate.next -%}
                  <li>
                    <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
                      <span class="svg-wrapper">
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </span>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            </nav>
          {%- endif -%}
        {%- endif -%}
      {% endpaginate %}
    </div>

    <div>
      {%- assign ac_details = 'customer.account.details' | t -%}
      {%- capture ac_view -%}{{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }}){%- endcapture -%}
      {% render 'typography', text: ac_details, as: 'h2', variant: 'h4' %}

      <div class="customer__address">{{ customer.default_address | format_address }}</div>

      {% render 'link', text: ac_view, href: routes.account_addresses_url %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-account.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
