{% render 'tdm-anchor', id: section.settings.anchor_id %}
{{ 'section-tdm-ticker.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign base_speed = section.settings.speed | default: 36
  assign speed = base_speed
  if section.settings.font_variant == 'mono'
    assign speed = base_speed | plus: 8
  endif

  assign track_class = 'typo-secondary'
  if section.settings.font_variant == 'mono'
    assign track_class = 'tdm-mono'
  elsif section.settings.typography_variant == 'primary'
    assign track_class = 'typo-primary'
  endif

  assign root_classes = 'tdm-ticker'
  if section.settings.show_top_border
    assign root_classes = root_classes | append: ' tdm-ticker--border-top'
  endif
  if section.settings.show_bottom_border
    assign root_classes = root_classes | append: ' tdm-ticker--border-bottom'
  endif
  if section.settings.text_transform == 'title'
    assign root_classes = root_classes | append: ' tdm-ticker--transform-title'
  elsif section.settings.text_transform == 'none'
    assign root_classes = root_classes | append: ' tdm-ticker--transform-none'
  endif
-%}

{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

<div class="section-{{ section.id }}-padding">
<section
  class="{{ root_classes }}"
  style="--ticker-speed: {{ speed }}s; --ticker-h: {{ section.settings.height | default: 100 }}px; --ticker-fs: {{ section.settings.font_size | default: 22 }}px; --ticker-icon-h: {{ section.settings.icon_height | default: 32 }}px; --ticker-ink: {{ section.settings.text_color | default: '#F3EFCF' }}; --ticker-bg: {{ section.settings.bg_color | default: 'transparent' }};"
>
  {% if section.settings.bg_image != blank %}
    <img
      class="tdm-ticker__img"
      src="{{ section.settings.bg_image | image_url: width: 2880 }}"
      alt=""
      width="{{ section.settings.bg_image.width }}"
      height="{{ section.settings.bg_image.height }}"
      loading="lazy"
      aria-hidden="true"
    >
  {% endif %}

  <div class="tdm-ticker__layer">
    {% assign copy = section.settings.text | strip | default: 'VIDA QUE GENERA VIDA' %}
    <div class="tdm-ticker__marquee">
      <div class="tdm-ticker__track {{ track_class }}">
        <span class="tdm-ticker__chunk">
          {% for i in (1..10) %}
            <span class="tdm-ticker__item">
              {% if section.settings.icon != blank %}
                <img
                  alt=""
                  class="tdm-ticker__icon"
                  src="{{ section.settings.icon | image_url }}"
                  width="{{ section.settings.icon.width }}"
                  height="{{ section.settings.icon.height }}"
                  loading="lazy"
                >
              {% endif %}
              <span>{{ copy }}</span>
            </span>
          {% endfor %}
        </span>
        <span class="tdm-ticker__chunk" aria-hidden="true">
          {% for i in (1..10) %}
            <span class="tdm-ticker__item">
              {% if section.settings.icon != blank %}
                <img
                  alt=""
                  class="tdm-ticker__icon"
                  src="{{ section.settings.icon | image_url }}"
                  width="{{ section.settings.icon.width }}"
                  height="{{ section.settings.icon.height }}"
                  loading="lazy"
                >
              {% endif %}
              <span>{{ copy }}</span>
            </span>
          {% endfor %}
        </span>
      </div>
    </div>
  </div>
</section>
</div>

{% schema %}
{
  "name": "Infinite Ticker",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "ID de ancla",
      "info": "Para enlazar a esta sección desde un botón. 1 o 2 palabras en español separadas por guion, ej. formulario o como-funciona. Enlace: /pages/aliados#formulario"
    },
    { "type": "text", "id": "text", "label": "Text", "default": "VIDA QUE GENERA VIDA" },
    { "type": "image_picker", "id": "icon", "label": "Icon" },
    {
      "type": "range",
      "id": "icon_height",
      "label": "Icon height (px)",
      "min": 12,
      "max": 55,
      "step": 1,
      "default": 32
    },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#00000000" },

    { "type": "color", "id": "text_color", "label": "Ticker text color", "default": "#F3EFCF" },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size (px)",
      "min": 12,
      "max": 100,
      "step": 1,
      "default": 22
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "title", "label": "Title Case" },
        { "value": "none", "label": "None" }
      ],
      "default": "uppercase"
    },

    {
      "type": "select",
      "id": "typography_variant",
      "label": "Typography",
      "options": [
        { "value": "primary", "label": "Heading font" },
        { "value": "secondary", "label": "Body font" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "font_variant",
      "label": "Font style",
      "options": [
        { "value": "normal", "label": "Normal (theme font)" },
        { "value": "mono", "label": "Monospace (IBMPlexMono-Light)" }
      ],
      "default": "normal"
    },

    {
      "type": "range",
      "id": "speed",
      "label": "Scroll duration (slower = bigger, seconds)",
      "min": 12,
      "max": 80,
      "step": 1,
      "default": 36
    },

    { "type": "checkbox", "id": "show_top_border", "label": "Show top border", "default": true },
    { "type": "checkbox", "id": "show_bottom_border", "label": "Show bottom border", "default": true },

    {
      "type": "range",
      "id": "height",
      "label": "Section height (px)",
      "min": 60,
      "max": 200,
      "step": 5,
      "default": 100
    },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0, "label": "Espaciado superior" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0, "label": "Espaciado inferior", "info": "En móvil se aplica al 75%, igual que el resto de secciones." }
  ],
  "presets": [{ "name": "Infinite Ticker" }]
}
{% endschema %}
