{{ 'customer.css' | asset_url | stylesheet_tag }}

{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

<div class="customer register section-{{ section.id }}-padding">
  {%- assign reg_title = 'customer.register.title' | t -%}
  {% render 'typography', text: reg_title, as: 'h1', variant: 'h2', align: 'center', class: 'customer__title' %}
  {%- form 'create_customer', novalidate: 'novalidate' -%}
    {% render 'customer-form-errors', errors: form.errors, anchor_prefix: 'RegisterForm-' %}
    {%- assign reg_first = 'customer.register.first_name' | t -%}
    {%- assign reg_last = 'customer.register.last_name' | t -%}
    {%- assign reg_email = 'customer.register.email' | t -%}
    {%- assign reg_password = 'customer.register.password' | t -%}
    {%- assign reg_submit = 'customer.register.submit' | t -%}
    {%- assign reg_email_error = '' -%}
    {%- assign reg_password_error = '' -%}
    {%- if form.errors contains 'email' -%}
      {%- capture reg_email_error -%}{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}.{%- endcapture -%}
    {%- endif -%}
    {%- if form.errors contains 'password' -%}
      {%- capture reg_password_error -%}{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}.{%- endcapture -%}
    {%- endif -%}
    <div class="customer__fields">
      {% render 'input', id: 'RegisterForm-FirstName', name: 'customer[first_name]', label: reg_first, value: form.first_name, autocomplete: 'given-name' %}
      {% render 'input', id: 'RegisterForm-LastName', name: 'customer[last_name]', label: reg_last, value: form.last_name, autocomplete: 'family-name' %}
      {% render 'input', id: 'RegisterForm-email', name: 'customer[email]', type: 'email', label: reg_email, value: form.email, autocomplete: 'email', error: reg_email_error, attrs: 'spellcheck="false" autocapitalize="off" aria-required="true"' %}
      {% render 'input', id: 'RegisterForm-password', name: 'customer[password]', type: 'password', label: reg_password, error: reg_password_error, attrs: 'aria-required="true"' %}
    </div>
    <div class="customer__actions">
      {% render 'button', label: reg_submit, type: 'submit', variant: 'primary' %}
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "t:sections.main-register.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
