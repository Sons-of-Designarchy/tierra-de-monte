{%- comment -%}
  Card grid product — the collection page grid. Thin wrapper over the card-grid-product snippet (product-card grid + Shopify filters and sort).
  Replaces Dawn's main-collection-product-grid. Used by templates/collection*.json.
{%- endcomment -%}
<script src="{{ 'pr-grid.js' | asset_url }}" defer="defer"></script>
{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

<div class="pr-grid-section gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width section-{{ section.id }}-padding">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- render 'card-grid-product',
        products: collection.products,
        results: collection,
        paginate: paginate,
        section_id: section.id,
        columns: section.settings.columns_desktop,
        show_filters: section.settings.show_filters,
        show_availability: section.settings.show_availability,
        sort_options: section.settings.show_sort,
        show_vendor: section.settings.show_vendor,
        show_quick_add: section.settings.show_quick_add,
        show_excerpt: section.settings.show_excerpt,
        image_ratio: section.settings.image_ratio,
        image_fit: section.settings.image_fit,
        empty_title: 'Esta colección no tiene productos',
        empty_text: 'Vuelve pronto o explora el resto del catálogo.'
      -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Card grid product",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 16,
      "label": "Productos por página"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "Columnas en escritorio",
      "info": "En teléfono siempre son dos."
    },
    {
      "type": "header",
      "content": "Filtros y orden"
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Mostrar «Ordenar por»",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_availability",
      "label": "Mostrar «Solo disponibles»",
      "info": "Usa el filtro de disponibilidad de Shopify (Search & Discovery).",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Mostrar filtros",
      "info": "Los grupos vienen de Search & Discovery.",
      "default": false
    },
    {
      "type": "header",
      "content": "Tarjeta de producto"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la foto",
      "options": [
        { "value": "1/1", "label": "Cuadrada" },
        { "value": "4/5", "label": "Vertical 4:5" },
        { "value": "3/4", "label": "Vertical 3:4" },
        { "value": "4/3", "label": "Horizontal 4:3" }
      ],
      "default": "1/1"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Ajuste de la foto",
      "options": [
        { "value": "cover", "label": "Llenar" },
        { "value": "contain", "label": "Contener" }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Mostrar marca",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Mostrar descripción (2 líneas)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Mostrar «Agregar al carrito»",
      "info": "Abre el carrito lateral.",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-tdm-blanco"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
