  <div class="tdm-catalog__demo tdm-catalog__demo--stack">
{% render 'cart-summary', cart: cart, minimum: 50000000, minimum_label: 'el mínimo de Bronce' %}
  </div>
  <pre class="tdm-catalog__code"><code>{% raw %}{% render 'cart-summary', cart: cart, minimum: 50000000, minimum_label: 'el mínimo de Bronce' %}{% endraw %}</code></pre>
</div>
</section>

<section class="tdm-catalog__block" id="cart-drawer">
  {%- render 'typography', text: 'CartDrawer', variant: 'h3', font: 'display', as: 'h2' -%}
  {%- render 'typography', text: 'The one cart drawer. Opens from the header bag and after every add. Lines, minimum bar, summary, empty state. The minimum comes from theme settings, Carrito, and is off by default.', variant: 'body', color: 'secondary' -%}
  <pre class="tdm-catalog__code tdm-catalog__code--params"><code>{% raw %}{% render 'cart-drawer' %}{% endraw %}</code></pre>
<div class="tdm-catalog__example">
  {%- render 'typography', text: 'open it', variant: 'label', weight: 'medium', color: 'secondary' -%}
  <div class="tdm-catalog__demo tdm-catalog__demo--row">
{% render 'button', label: 'Abrir carrito', variant: 'outline', attrs: 'data-cart-open' %}
  </div>
  <pre class="tdm-catalog__code"><code>{% raw %}{% render 'button', label: 'Abrir carrito', variant: 'outline', attrs: 'data-cart-open' %}{% endraw %}</code></pre>
</div>
</section>

<section class="tdm-catalog__block" id="pricing">
  {%- render 'typography', text: 'Pricing (section)', variant: 'h3', font: 'display', as: 'h2' -%}
  {%- render 'typography', text: 'Plans, tiers or levels as cards with groups (T1, T2). Add it from the theme editor: sections/pricing.liquid, one Nivel block per tier (name, minimum purchase, benefits, badge, group). A tier with no minimum and no price reads Por definir and cannot be chosen. Selectable, each button points a progress bar at the tier minimum using the cart total. Sections cannot be rendered inside a section, so there is no live demo here.', variant: 'body', color: 'secondary' -%}
  <pre class="tdm-catalog__code tdm-catalog__code--params"><code>{% raw %}section pricing: eyebrow, title, intro, align, group_1_label, group_2_label, selectable, select_prompt, goal_label, note, color_scheme
block plan: name, group (t1|t2), threshold (MXN), price, period, features (one per line), badge_image, featured, action_label, action_href{% endraw %}</code></pre>
</section>
</div>
</div>
</div>
<script>
  (() => {
    const toc = document.querySelector('[data-catalog-toc]');
    if (!toc) return;
    if (window.matchMedia('(max-width: 989px)').matches) toc.open = false;
    const links = new Map([...toc.querySelectorAll('[data-toc-link]')].map((a) => [a.hash.slice(1), a]));
    toc.addEventListener('click', (e) => { if (e.target.closest('a') && window.matchMedia('(max-width: 989px)').matches) toc.open = false; });
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((a) => a.removeAttribute('aria-current'));
        const link = links.get(entry.target.id);
        if (!link) return;
        link.setAttribute('aria-current', 'true');
        const bar = link.closest('.tdm-catalog__sidebar');
        const r = link.getBoundingClientRect(), b = bar.getBoundingClientRect();
        if (r.top < b.top || r.bottom > b.bottom) bar.scrollTop += r.top - b.top - b.height / 2;
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    links.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
  })();
</script>
{% schema %}
{
  "name": "Catálogo foundations",
  "tag": "section",
  "class": "tdm-catalog-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de muestra (opcional)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-tdm-blanco"
    }
  ],
  "presets": []
}
{% endschema %}
