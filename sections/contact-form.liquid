{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- liquid
  assign heading_variant = 'h1'
  case section.settings.heading_size
    when 'h2'
      assign heading_variant = 'h2'
    when 'h0' or 'hxl' or 'hxxl'
      assign heading_variant = 'display'
  endcase
  assign contact_form_class = 'isolate'
  if settings.animations_reveal_on_scroll
    assign contact_form_class = 'isolate scroll-trigger animate--slide-in'
  endif
  assign label_name = 'templates.contact.form.name' | t
  assign label_email = 'templates.contact.form.email' | t
  assign label_phone = 'templates.contact.form.phone' | t
  assign label_comment = 'templates.contact.form.comment' | t
  assign label_email_required = label_email | append: ' *'
  assign field_name = 'contact[' | append: label_name | append: ']'
  assign field_phone = 'contact[' | append: label_phone | append: ']'
  assign field_comment = 'contact[' | append: label_comment | append: ']'
  assign v_name = ''
  assign v_email = ''
  assign v_phone = ''
  if form.name
    assign v_name = form.name
  elsif customer
    assign v_name = customer.name
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div class="contact__title{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {% render 'typography', text: section.settings.heading, variant: heading_variant, as: 'h2', font: 'display', weight: 'medium' %}
      </div>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
    {%- endif -%}
    {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
      {%- liquid
        if form.email
          assign v_email = form.email
        elsif customer
          assign v_email = customer.email
        endif
        if form.phone
          assign v_phone = form.phone
        elsif customer
          assign v_phone = customer.phone
        endif
        assign email_error = ''
        if form.errors contains 'email'
          assign email_field_label = form.errors.translated_fields.email | capitalize
          assign email_error = email_field_label | append: ' ' | append: form.errors.messages.email
        endif
      -%}

      {%- if form.posted_successfully? -%}
        <div class="contact__status" tabindex="-1" autofocus>
          {% assign success_text = 'templates.contact.form.post_success' | t %}
          {% render 'alert', tone: 'success', text: success_text %}
        </div>
      {%- elsif form.errors -%}
        <div class="contact__status" tabindex="-1" autofocus>
          {% assign error_title = 'templates.contact.form.error_heading' | t %}
          {% render 'alert', tone: 'error', title: error_title, text: email_error %}
        </div>
      {%- endif -%}

      <div class="contact__fields">
        {% render 'input', label: label_name, id: 'ContactForm-name', name: field_name, type: 'text', value: v_name, autocomplete: 'name' %}
        {% render 'input', label: label_email_required, id: 'ContactForm-email', name: 'contact[email]', type: 'email', value: v_email, autocomplete: 'email', error: email_error, attrs: 'aria-required="true" spellcheck="false" autocapitalize="off"' %}
      </div>
      {% render 'input', label: label_phone, id: 'ContactForm-phone', name: field_phone, type: 'tel', value: v_phone, autocomplete: 'tel', attrs: 'pattern="[0-9\-]*"', class: 'contact__field' %}
      {% render 'textarea', label: label_comment, id: 'ContactForm-body', name: field_comment, value: form.body, rows: 10, class: 'contact__field' %}
      <div class="contact__button">
        {% assign label_send = 'templates.contact.form.send' | t %}
        {% render 'button', label: label_send, type: 'submit', variant: 'primary', size: 'lg' %}
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.contact-form.settings.title.default",
      "label": "t:sections.contact-form.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
