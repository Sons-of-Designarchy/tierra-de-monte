{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}

<script src="{{ 'pr-grid.js' | asset_url }}" defer="defer"></script>

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>
{{ 'section-tdm-search.css' | asset_url | stylesheet_tag }}


{%- liquid
-%}

{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{% paginate search.results by 24 %}
  <div class="template-search{% unless search.performed and search.results_count > 0 %} template-search--empty{% endunless %} section-{{ section.id }}-padding">
    <div class="template-search__header page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- if search.performed -%}
        {%- assign ts_title = 'templates.search.title' | t -%}
      {%- else -%}
        {%- assign ts_title = 'general.search.search' | t -%}
      {%- endif -%}
      {% render 'typography', text: ts_title, as: 'h1', font: 'display', weight: 'medium', variant: 'h2', align: 'center' %}
      <div class="template-search__search">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- endif -%}
        <main-search>
          <form action="{{ routes.search_url }}" method="get" role="search" class="search template-search__form">
            <div class="template-search__field">
              {%- assign ts_label = 'general.search.search' | t -%}
              {%- capture ts_attrs -%}
                {%- if settings.predictive_search_enabled -%}
                  role="combobox" aria-expanded="false" aria-owns="predictive-search-results" aria-controls="predictive-search-results" aria-haspopup="listbox" aria-autocomplete="list" autocorrect="off" autocapitalize="off" spellcheck="false"
                {%- endif -%}
              {%- endcapture -%}
              {%- assign ts_autocomplete = '' -%}
              {%- if settings.predictive_search_enabled -%}{%- assign ts_autocomplete = 'off' -%}{%- endif -%}
              {% render 'input', id: 'Search-In-Template', name: 'q', type: 'search', label: ts_label, hide_label: true, value: search.terms, placeholder: ts_label, autocomplete: ts_autocomplete, attrs: ts_attrs, class: 'template-search__input' %}
              <input name="options[prefix]" type="hidden" value="last">

              {%- if settings.predictive_search_enabled -%}
                <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
                  {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
                </div>

                <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
              {%- endif -%}
            </div>

            {%- assign ts_reset_label = 'general.search.reset' | t -%}
            {%- assign ts_reset_class = 'reset__button' -%}
            {%- if search.terms == blank -%}{%- assign ts_reset_class = 'reset__button hidden' -%}{%- endif -%}
            {% render 'icon-button', icon: 'close', label: ts_reset_label, type: 'reset', variant: 'ghost', class: ts_reset_class %}
            {% render 'icon-button', icon: 'search', label: ts_label, type: 'submit', variant: 'primary', class: 'search__button' %}
          </form>
        </main-search>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- endif -%}
      </div>
      {%- if search.performed -%}
        {%- if search.results_count > 0 -%}
          {%- assign ts_count = 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: search.results_count -%}
          {% render 'typography', text: ts_count, variant: 'body', align: 'center', attrs: 'role="status"' %}
        {%- endif -%}
        {%- if search.results_count == 0 and search.filters == empty -%}
          {%- assign ts_none = 'templates.search.no_results' | t: terms: search.terms -%}
          {% render 'typography', text: ts_none, variant: 'body', align: 'center', attrs: 'role="status"' %}
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- if search.performed and search.results_count > 0 or search.performed and search.filters != empty -%}
      <div class="page-width">
        {% render 'card-grid-product',
          products: search.results,
          results: search,
          paginate: paginate,
          search_terms: search.terms,
          section_id: section.id,
          columns: section.settings.columns_desktop,
          show_filters: section.settings.enable_filtering,
          sort_options: section.settings.enable_sorting,
          show_availability: false,
          show_vendor: section.settings.show_vendor,
          show_quick_add: section.settings.show_quick_add,
          image_ratio: section.settings.image_ratio,
          empty_title: 'Ningún resultado con estos filtros'
        %}
      </div>
    {%- endif -%}
  </div>
{% endpaginate %}

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-search.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la foto",
      "options": [
        { "value": "1/1", "label": "Cuadrada" },
        { "value": "4/5", "label": "Vertical 4:5" },
        { "value": "3/4", "label": "Vertical 3:4" },
        { "value": "4/3", "label": "Horizontal 4:3" }
      ],
      "default": "1/1"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-search.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Mostrar «Agregar al carrito»",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__2.content"
    },
    {
      "type": "checkbox",
      "id": "article_show_date",
      "default": true,
      "label": "t:sections.main-search.settings.article_show_date.label"
    },
    {
      "type": "checkbox",
      "id": "article_show_author",
      "default": false,
      "label": "t:sections.main-search.settings.article_show_author.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
