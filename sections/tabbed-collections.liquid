{% render 'tdm-anchor', id: section.settings.anchor_id %}
{{ 'section-tdm-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tdm-tabs.js' | asset_url }}" defer="defer"></script>
{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

<section class="tdm-tabs page-width section-{{ section.id }}-padding">
  {% render 'section-header', eyebrow: section.settings.kicker, align: 'center' %}
  {% render 'heading', title: section.settings.heading, as: 'h1', size: 'h1', subtitle: section.settings.subheading, align: 'center', class: 'tdm-tabs__heading' %}

  {%- assign has_any = false -%}
  {%- for i in (1..6) -%}
    {%- capture key %}collection_{{ i }}{% endcapture -%}
    {%- assign c = section.settings[key] -%}
    {%- if c != blank -%}{%- assign has_any = true -%}{%- endif -%}
  {%- endfor -%}

  {% if has_any %}
    <tdm-tabs class="tdm-tabs__root">
      <div class="tdm-tabs__list" role="group" aria-label="{{ section.settings.heading | escape }}">
        {%- assign first_rendered = true -%}
        {%- for i in (1..6) -%}
          {%- capture ckey %}collection_{{ i }}{% endcapture -%}
          {%- capture lkey %}label_{{ i }}{% endcapture -%}
          {%- capture dkey %}dot_{{ i }}{% endcapture -%}
          {%- capture ikey %}icon_{{ i }}{% endcapture -%}
          {%- assign c = section.settings[ckey] -%}
          {%- if c != blank -%}
            {%- assign tab_label = section.settings[lkey] | default: c.title -%}
            {%- assign icon = section.settings[ikey] -%}
            {%- capture tab_lead -%}
              {%- if icon != blank -%}
                {{ icon | image_url: width: 36 | image_tag: class: 'tdm-tabs__icon', alt: '' }}
              {%- elsif section.settings[dkey] -%}
                <span class="tdm-tabs__dot"></span>
              {%- endif -%}
            {%- endcapture -%}
            {%- capture tab_attrs -%}data-target="tc-panel-{{ section.id }}-{{ i }}" aria-controls="tc-panel-{{ section.id }}-{{ i }}"{%- endcapture -%}
            {% render 'chip', label: tab_label, lead: tab_lead, selected: first_rendered, size: 'md', text: 'body-lg', attrs: tab_attrs, class: 'tdm-tabs__tab' %}
            {%- assign first_rendered = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="tdm-tabs__panels">
        {%- assign first_panel = true -%}
        {%- for i in (1..6) -%}
          {%- capture ckey %}collection_{{ i }}{% endcapture -%}
          {%- assign c = section.settings[ckey] -%}
          {%- if c != blank -%}
            <div
              id="tc-panel-{{ section.id }}-{{ i }}"
              class="tdm-tabs__panel"
              {% unless first_panel %}hidden{% endunless %}
            >
              {%- assign prod_limit = section.settings.products_limit | plus: 0 -%}
              {% render 'card-grid-product', products: c.products, limit: prod_limit, columns: 4, show_quick_add: true, show_excerpt: section.settings.show_card_excerpt, image_ratio: '1/1' %}

              {% if section.settings.show_view_all and c.url %}
                {%- assign view_all = section.settings.view_all_label | default: 'Ver más productos' -%}
                <div class="tdm-tabs__more">
                  {% render 'button', label: view_all, href: c.url, variant: 'primary', size: 'md' %}
                </div>
              {% endif %}
            </div>
            {%- assign first_panel = false -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </tdm-tabs>
  {% else %}
    {% render 'typography', text: 'Set “Collection 1…6” in the section settings.', variant: 'body', color: 'secondary', align: 'center' %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Tabbed collections",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "ID de ancla",
      "info": "Para enlazar a esta sección desde un botón. 1 o 2 palabras en español separadas por guion, ej. formulario o como-funciona. Enlace: /pages/aliados#formulario"
    },
    { "type": "text", "id": "kicker", "label": "Eyebrow", "info": "Texto pequeño arriba del título. La línea aparece solo si hay texto." },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "checkbox", "id": "show_card_excerpt", "label": "Show product description", "default": true },

    { "type": "collection", "id": "collection_1", "label": "Collection 1" },
    { "type": "text", "id": "label_1", "label": "Label 1" },
    { "type": "checkbox", "id": "dot_1", "label": "Show dot 1", "default": true },
    { "type": "image_picker", "id": "icon_1", "label": "Icon 1 (SVG/PNG)" },

    { "type": "collection", "id": "collection_2", "label": "Collection 2" },
    { "type": "text", "id": "label_2", "label": "Label 2" },
    { "type": "checkbox", "id": "dot_2", "label": "Show dot 2", "default": true },
    { "type": "image_picker", "id": "icon_2", "label": "Icon 2 (SVG/PNG)" },

    { "type": "collection", "id": "collection_3", "label": "Collection 3" },
    { "type": "text", "id": "label_3", "label": "Label 3" },
    { "type": "checkbox", "id": "dot_3", "label": "Show dot 3", "default": true },
    { "type": "image_picker", "id": "icon_3", "label": "Icon 3 (SVG/PNG)" },

    { "type": "collection", "id": "collection_4", "label": "Collection 4" },
    { "type": "text", "id": "label_4", "label": "Label 4" },
    { "type": "checkbox", "id": "dot_4", "label": "Show dot 4", "default": true },
    { "type": "image_picker", "id": "icon_4", "label": "Icon 4 (SVG/PNG)" },

    { "type": "collection", "id": "collection_5", "label": "Collection 5" },
    { "type": "text", "id": "label_5", "label": "Label 5" },
    { "type": "checkbox", "id": "dot_5", "label": "Show dot 5", "default": true },
    { "type": "image_picker", "id": "icon_5", "label": "Icon 5 (SVG/PNG)" },

    { "type": "collection", "id": "collection_6", "label": "Collection 6" },
    { "type": "text", "id": "label_6", "label": "Label 6" },
    { "type": "checkbox", "id": "dot_6", "label": "Show dot 6", "default": true },
    { "type": "image_picker", "id": "icon_6", "label": "Icon 6 (SVG/PNG)" },

    {
      "type": "select",
      "id": "products_limit",
      "label": "Products per tab",
      "default": "4",
      "options": [
        { "label": "4", "value": "4" },
        { "label": "8", "value": "8" },
        { "label": "12", "value": "12" }
      ]
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show “View more” button", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Button label", "default": "Ver más productos" },

    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [{ "name": "Tabbed collections" }]
}
{% endschema %}
