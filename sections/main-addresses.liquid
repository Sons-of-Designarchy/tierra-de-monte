{{ 'customer.css' | asset_url | stylesheet_tag }}

<script src="{{ 'customer.js' | asset_url }}" defer></script>

{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- paginate customer.addresses by 5 -%}
  <div class="customer addresses section-{{ section.id }}-padding" data-customer-addresses>
    {%- assign ad_title = 'customer.addresses.title' | t -%}
    {%- assign ad_return = 'customer.account.return' | t -%}
    {%- assign ad_add_new = 'customer.addresses.add_new' | t -%}
    {%- assign ad_add = 'customer.addresses.add' | t -%}
    {%- assign ad_cancel = 'customer.addresses.cancel' | t -%}
    {%- assign ad_update = 'customer.addresses.update' | t -%}
    {%- assign ad_edit = 'customer.addresses.edit' | t -%}
    {%- assign ad_delete = 'customer.addresses.delete' | t -%}
    {%- assign ad_edit_address = 'customer.addresses.edit_address' | t -%}
    {%- assign ad_default = 'customer.addresses.default' | t -%}
    {%- assign ad_confirm = 'customer.addresses.delete_confirm' | t -%}
    {% render 'typography', text: ad_title, as: 'h1', variant: 'h2', align: 'center', class: 'customer__title' %}
    <div class="customer__link">{% render 'link', text: ad_return, href: routes.account_url %}</div>

    <div data-address>
      {% render 'button', label: ad_add_new, variant: 'primary', attrs: 'aria-expanded="false" aria-controls="AddAddress"' %}
      <div id="AddAddress">
        {% render 'typography', text: ad_add_new, as: 'h2', variant: 'h4', id: 'AddressNewHeading' %}
        {%- form 'customer_address', customer.new_address, aria-labelledBy: 'AddressNewHeading' -%}
          {% render 'customer-address-fields', form: form, suffix: 'New', default_id: 'address_default_address_new' %}
          <div class="customer__actions customer__actions--row">
            {% render 'button', label: ad_add, type: 'submit', variant: 'primary' %}
            {% render 'button', label: ad_cancel, type: 'reset', variant: 'outline' %}
          </div>
        {%- endform -%}
      </div>
    </div>

    <ul role="list">
      {%- for address in customer.addresses -%}
        {%- assign ad_index_edit_label = ad_edit_address | append: ' ' | append: forloop.index -%}
        {%- assign ad_index_delete_label = ad_delete | append: ' ' | append: forloop.index -%}
        {%- assign ad_edit_id = 'EditFormButton_' | append: address.id -%}
        {%- capture ad_edit_attrs -%}aria-label="{{ ad_index_edit_label }}" aria-controls="EditAddress_{{ address.id }}" aria-expanded="false" data-address-id="{{ address.id }}"{%- endcapture -%}
        {%- capture ad_delete_attrs -%}aria-label="{{ ad_index_delete_label }}" data-target="{{ address.url }}" data-confirm-message="{{ ad_confirm }}"{%- endcapture -%}
        <li data-address>
          {%- if address == customer.default_address -%}
            {% render 'typography', text: ad_default, as: 'h2', variant: 'h4', align: 'center' %}
          {%- endif -%}
          <div class="customer__address">{{ address | format_address }}</div>
          <div class="customer__actions customer__actions--row">
            {% render 'button', label: ad_edit, variant: 'outline', size: 'sm', id: ad_edit_id, attrs: ad_edit_attrs %}
            {% render 'button', label: ad_delete, variant: 'outline', size: 'sm', attrs: ad_delete_attrs %}
          </div>
          <div id="EditAddress_{{ address.id }}">
            {% render 'typography', text: ad_edit_address, as: 'h2', variant: 'h4' %}
            {%- form 'customer_address', address -%}
              {%- assign ad_suffix = '_' | append: form.id -%}
              {%- assign ad_default_id = 'address_default_address_' | append: form.id -%}
              {% render 'customer-address-fields', form: form, suffix: ad_suffix, default_id: ad_default_id, form_id: form.id %}
              <div class="customer__actions customer__actions--row">
                {% render 'button', label: ad_update, type: 'submit', variant: 'primary' %}
                {% render 'button', label: ad_cancel, type: 'reset', variant: 'outline' %}
              </div>
            {%- endform -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if paginate.pages > 1 -%}
      {%- if paginate.parts.size > 0 -%}
        <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
          <ul role="list">
            {%- if paginate.previous -%}
              <li>
                <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
                  <span class="svg-wrapper">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </a>
              </li>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              <li>
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                    {{- part.title -}}
                  </a>
                {%- else -%}
                  {%- if part.title == paginate.current_page -%}
                    <span aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">
                      {{- part.title -}}
                    </span>
                  {%- else -%}
                    <span>{{ part.title }}</span>
                  {%- endif -%}
                {%- endif -%}
              </li>
            {%- endfor -%}

            {%- if paginate.next -%}
              <li>
                <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
                  <span class="svg-wrapper">
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main-addresses.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
