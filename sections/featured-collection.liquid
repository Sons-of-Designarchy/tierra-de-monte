{%- comment -%}
  Featured collection — a heading and a row of product-cards from one collection, through the card-grid-product snippet.
{%- endcomment -%}
{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- liquid
  assign fc_collection = section.settings.collection
  assign fc_intro = section.settings.description
  if section.settings.show_description
    assign fc_intro = fc_collection.description
  endif
  assign fc_more = false
  if fc_collection.all_products_count > section.settings.products_to_show
    assign fc_more = true
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="page-width section-{{ section.id }}-padding pr-featured">
    {% render 'section-header', title: section.settings.title, intro: fc_intro %}
    {% render 'card-grid-product',
      products: fc_collection.products,
      limit: section.settings.products_to_show,
      columns: section.settings.columns_desktop,
      show_vendor: section.settings.show_vendor,
      show_quick_add: section.settings.show_quick_add,
      show_excerpt: section.settings.show_excerpt,
      image_ratio: section.settings.image_ratio,
      empty_title: 'Elige una colección',
      empty_text: 'Agrega una colección en los ajustes de la sección.'
    %}
    {%- if section.settings.show_view_all and fc_more -%}
      <div class="pr-featured__more">
        {% render 'button', label: 'Ver toda la colección', href: fc_collection.url, variant: section.settings.view_all_style %}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.featured-collection.settings.title.default",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.featured-collection.settings.description.label"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.featured-collection.settings.show_description.label",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.products_to_show.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.columns_desktop.label"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "t:sections.featured-collection.settings.show_view_all.label"
    },
    {
      "type": "select",
      "id": "view_all_style",
      "label": "t:sections.featured-collection.settings.view_all_style.label",
      "options": [
        { "value": "primary", "label": "Sólido" },
        { "value": "outline", "label": "Contorno" }
      ],
      "default": "outline"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Tarjeta de producto"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la foto",
      "options": [
        { "value": "1/1", "label": "Cuadrada" },
        { "value": "4/5", "label": "Vertical 4:5" },
        { "value": "3/4", "label": "Vertical 3:4" },
        { "value": "4/3", "label": "Horizontal 4:3" }
      ],
      "default": "1/1"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.featured-collection.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Mostrar «Agregar al carrito»",
      "info": "Solo funciona con el ajuste del tema «Mostrar compra en el sitio».",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Mostrar extracto de la descripción",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-collection.presets.name"
    }
  ]
}
{% endschema %}
