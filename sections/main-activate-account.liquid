{{ 'customer.css' | asset_url | stylesheet_tag }}

{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

<div class="customer activate section-{{ section.id }}-padding">
  {%- assign aa_title = 'customer.activate_account.title' | t -%}
  {%- assign aa_sub = 'customer.activate_account.subtext' | t -%}
  {% render 'typography', text: aa_title, as: 'h1', font: 'display', weight: 'medium', variant: 'h2', align: 'center', class: 'customer__title' %}
  {% render 'typography', text: aa_sub, variant: 'body', color: 'secondary', align: 'center' %}
  {%- form 'activate_customer_password' -%}
    {% render 'customer-form-errors', errors: form.errors %}
    {%- assign aa_password = 'customer.activate_account.password' | t -%}
    {%- assign aa_confirm = 'customer.activate_account.password_confirm' | t -%}
    {%- assign aa_submit = 'customer.activate_account.submit' | t -%}
    {%- assign aa_cancel = 'customer.activate_account.cancel' | t -%}
    {%- assign aa_password_error = '' -%}
    {%- assign aa_confirm_error = '' -%}
    {%- if form.errors contains 'password' -%}
      {%- capture aa_password_error -%}{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}{%- endcapture -%}
    {%- endif -%}
    {%- if form.errors contains 'password_confirmation' -%}
      {%- capture aa_confirm_error -%}{{ form.errors.translated_fields.password_confirmation | capitalize }} {{ form.errors.messages.password_confirmation }}{%- endcapture -%}
    {%- endif -%}
    <div class="customer__fields">
      {% render 'input', id: 'password', name: 'customer[password]', type: 'password', label: aa_password, autocomplete: 'new-password', error: aa_password_error %}
      {% render 'input', id: 'password_confirmation', name: 'customer[password_confirmation]', type: 'password', label: aa_confirm, autocomplete: 'new-password', error: aa_confirm_error %}
    </div>
    <div class="customer__actions customer__actions--row">
      {% render 'button', label: aa_submit, type: 'submit', variant: 'primary' %}
      {% render 'button', label: aa_cancel, type: 'submit', name: 'decline', variant: 'outline' %}
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "t:sections.main-activate-account.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
