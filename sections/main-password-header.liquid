<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="password-header" style="--password-logo-width: {{ settings.logo_width }}px">
    {%- if settings.logo != blank -%}
      {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
      {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
      {{
        settings.logo
        | image_url: width: 500
        | image_tag:
          class: 'password-logo',
          widths: '50, 100, 150, 200, 250, 300, 400, 500',
          width: settings.logo_width,
          height: logo_height,
          alt: logo_alt
      }}
    {%- else -%}
      {% render 'typography', text: shop.name, as: 'h1', variant: 'h2' %}
    {%- endif -%}

    {%- if shop.password_message != blank -%}
      {% render 'typography', text: shop.password_message, as: 'div', variant: 'body', class: 'password-content' %}
    {%- endif -%}

    {%- assign login_button_label = 'general.password_page.login_password_button' | t -%}
    <password-modal>
      <details class="password-modal modal">
        <summary class="modal__toggle" aria-haspopup="dialog">
          <div class="modal__toggle-open password-link link underlined-link">
            <span class="svg-wrapper">
              {{- 'icon-padlock.svg' | inline_asset_content -}}
            </span>
            {% render 'typography', text: login_button_label, as: 'span', variant: 'body-sm', color: 'inherit' %}
          </div>
          <div class="modal__toggle-close" aria-hidden="true">
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </div>
        </summary>
        <div
          class="modal__content"
          role="dialog"
          aria-labelledby="DialogHeading"
          aria-modal="true"
        >
          <div class="password-modal__content" tabindex="-1">
            {%- assign close_label = 'accessibility.close' | t -%}
            {% render 'icon-button', icon: 'close', label: close_label, variant: 'ghost', class: 'modal__close-button' %}
            {%- assign login_heading = 'general.password_page.login_form_heading' | t -%}
            {% render 'typography', text: login_heading, as: 'h2', variant: 'h4', id: 'DialogHeading', class: 'password-modal__content-heading' %}
            {%- form 'storefront_password', class: 'password-form' -%}
              {%- assign pw_label = 'general.password_page.login_form_password_placeholder' | t -%}
              {%- assign pw_error = '' -%}
              {%- if form.errors -%}
                {%- assign pw_error = 'general.password_page.login_form_error' | t -%}
              {%- endif -%}
              {% render 'input', id: 'Password', name: 'password', type: 'password', label: pw_label, hide_label: true, placeholder: pw_label, autocomplete: 'current-password', error: pw_error, class: 'password-field' %}
              {%- assign pw_submit = 'general.password_page.login_form_submit' | t -%}
              {% render 'button', label: pw_submit, type: 'submit', variant: 'outline', name: 'commit', class: 'password-button' %}
            {%- endform -%}
            {%- assign admin_link = 'general.password_page.admin_link_html' | t -%}
            {% render 'typography', text: admin_link, as: 'small', variant: 'xs', class: 'password__footer-text' %}
          </div>
        </div>
      </details>
    </password-modal>
  </div>
</div>
{% assign scheme1 = settings.color_schemes | first %}
{%- if section.settings.color_scheme == scheme1 -%}<hr>{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-password-header.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-password-header.settings.logo_help.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
