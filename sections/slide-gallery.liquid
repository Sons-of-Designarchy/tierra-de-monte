{% render 'tdm-anchor', id: section.settings.anchor_id %}
{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'section-tdm-slide-gallery.css' | asset_url | stylesheet_tag }}

{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}
{%- liquid
  assign intro_pad_id = section.id | append: '-intro'
  assign cta_pad_id = section.id | append: '-cta'
-%}
{% render 'section-padding', id: intro_pad_id, top: section.settings.intro_padding_top, bottom: section.settings.intro_padding_bottom %}
{% render 'section-padding', id: cta_pad_id, top: 0, bottom: section.settings.intro_padding_bottom %}

{%- liquid
  case section.settings.mobile_ratio
    when '16_9'
      assign mobile_ratio = '16 / 9'
    when '4_3'
      assign mobile_ratio = '4 / 3'
    else
      assign mobile_ratio = '3 / 2'
  endcase

  assign adapt_image = false
  if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image != blank
    assign adapt_image = true
    assign adapt_ratio = section.blocks.first.settings.image.width | append: ' / ' | append: section.blocks.first.settings.image.height
  endif
  # Fixed desktop proportions: same mechanism as "adapt", image centred (cover)
  case section.settings.slide_height
    when 'ratio_16_9'
      assign adapt_image = true
      assign adapt_ratio = '16 / 9'
    when 'ratio_2_1'
      assign adapt_image = true
      assign adapt_ratio = '2 / 1'
  endcase

  assign has_cta = false
  if section.settings.button_label != blank
    assign has_cta = true
  endif
  assign cta_below = false
  if has_cta and section.settings.button_position == 'below_gallery'
    assign cta_below = true
  endif
-%}

{%- capture cta -%}
  <a
    {% if section.settings.button_link != blank %}
      href="{{ section.settings.button_link }}"
    {% else %}
      role="link" aria-disabled="true"
    {% endif %}
    class="button {% if section.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}"
  >
    {{- section.settings.button_label | escape -}}
  </a>
{%- endcapture -%}

{%- capture intro -%}
  {%- if section.settings.eyebrow != blank or section.settings.intro_title != blank or section.settings.intro_text != blank or has_cta and cta_below == false -%}
    <div class="slide-gallery-intro section-{{ section.id }}-intro-padding">
      <div class="slide-gallery-intro__inner page-width slide-gallery-intro--{{ section.settings.intro_alignment }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- render 'tdm-section-eyebrow', text: section.settings.eyebrow, rule_color: section.settings.rule_color -%}
        {%- if section.settings.intro_title != blank -%}
          <h2 class="slide-gallery-intro__heading inline-richtext {{ section.settings.intro_heading_size }}">
            {{ section.settings.intro_title }}
          </h2>
        {%- endif -%}
        {%- if section.settings.intro_text != blank -%}
          <div class="slide-gallery-intro__text rte">
            {{ section.settings.intro_text }}
          </div>
        {%- endif -%}
        {%- if has_cta and cta_below == false -%}
          <div class="slide-gallery-intro__buttons">{{ cta }}</div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
{%- endcapture -%}

{%- capture slider_controls_inner -%}
  <button
    type="button"
    class="slider-button slider-button--prev"
    name="previous"
    aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
    aria-controls="Slider-{{ section.id }}"
  >
    <span class="svg-wrapper">
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </span>
  </button>
  <div class="slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' or section.settings.slider_visual == 'numbers' %} caption{% endif %}">
    {%- if section.settings.slider_visual == 'counter' -%}
      <span class="slider-counter--current">1</span>
      <span aria-hidden="true"> / </span>
      <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
      <span class="slider-counter--total">{{ section.blocks.size }}</span>
    {%- else -%}
      <div class="slideshow__control-wrapper">
        {%- for block in section.blocks -%}
          <button
            class="slider-counter__link slider-counter__link--{{ section.settings.slider_visual }} link"
            aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
            aria-controls="Slider-{{ section.id }}"
          >
            {%- if section.settings.slider_visual == 'numbers' -%}
              {{ forloop.index -}}
            {%- else -%}
              <span class="dot"></span>
            {%- endif -%}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  <button
    type="button"
    class="slider-button slider-button--next"
    name="next"
    aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
    aria-controls="Slider-{{ section.id }}"
  >
    <span class="svg-wrapper">
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </span>
  </button>
{%- endcapture -%}

<div
  class="slide-gallery tdm-slide-gallery color-{{ section.settings.intro_color_scheme }} gradient"
  data-layout="{{ section.settings.layout }}"
  {% if adapt_image %}
    data-adapt-image
  {% endif %}
  style="--sg-mobile-ratio: {{ mobile_ratio }}; --sg-radius: {{ section.settings.corner_radius }}px; --sg-pad-x-mobile: {{ section.settings.padding_x_mobile }}px; --sg-pad-x-desktop: {{ section.settings.padding_x_desktop }}px;{% if adapt_image %} --sg-adapt-ratio: {{ adapt_ratio }};{% endif %}"
>
{%- if section.settings.intro_position == 'top' -%}
  {{ intro }}
{%- endif -%}

<slideshow-component
  class="tdm-slide-gallery__slider slider-mobile-gutter section-{{ section.id }}-padding{% if section.settings.layout == 'grid' %} page-width{% endif %}"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_info | escape }}"
>
  {%- if section.settings.auto_rotate and section.blocks.size > 1 -%}
    <div class="slideshow__controls slideshow__controls--top slider-buttons">
      {{ slider_controls_inner }}
      <button
        type="button"
        class="slideshow__autoplay slider-button"
        aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-pause.svg' | inline_asset_content -}}
        </span>
        <span class="svg-wrapper">
          {{- 'icon-play.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>
  {%- endif -%}

  <div
    class="slideshow banner banner--{{ section.settings.slide_height }} grid grid--1-col slider slider--everywhere{% if section.blocks.first.settings.image == blank %} slideshow--placeholder{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    id="Slider-{{ section.id }}"
    aria-live="polite"
    aria-atomic="true"
    data-autoplay="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.change_slides_speed }}"
  >
    {%- for block in section.blocks -%}
      <div
        class="slideshow__slide grid__item grid--1-col slider__slide"
        id="Slide-{{ section.id }}-{{ forloop.index }}"
        {{ block.shopify_attributes }}
        style="--sg-overlay-color: {{ block.settings.overlay_color | default: '#000000' }}; --sg-overlay-opacity: {{ block.settings.overlay_opacity | default: 30 | divided_by: 100.0 }};"
        role="group"
        aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
        tabindex="-1"
      >
        <div class="slideshow__media banner__media media{% if block.settings.image == blank %} placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
          {%- if block.settings.image -%}
            {%- liquid
              assign height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio | round
              if section.settings.image_behavior == 'ambient'
                assign sizes = '120vw'
                assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
              else
                assign sizes = '100vw'
                assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
              endif
              assign fetch_priority = 'auto'
              if section.index == 1
                assign fetch_priority = 'high'
              endif
            -%}
            {%- if forloop.first %}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag: height: height, sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{
                block.settings.image
                | image_url: width: 3840
                | image_tag: loading: 'lazy', height: height, sizes: sizes, widths: widths
              }}
            {%- endif -%}
          {%- else -%}
            {%- assign placeholder_slide = forloop.index | modulo: 2 -%}
            {%- if placeholder_slide == 1 -%}
              {{ 'hero-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          {%- endif -%}
        </div>
        {%- liquid
          assign bs = block.settings
          assign has_stats = false
          if bs.stat_1 != blank or bs.stat_2 != blank or bs.stat_3 != blank or bs.stat_4 != blank or bs.stat_5 != blank or bs.stat_6 != blank
            assign has_stats = true
          endif
        -%}
        {%- if bs.quote != blank or has_stats -%}
          <div
            class="tdm-slide-gallery__caption tdm-slide-gallery__caption--{{ bs.caption_position | default: 'right' }} color-{{ bs.caption_color_scheme }}"
            {% if bs.quote_color != blank or bs.stats_color != blank %}
              style="{% if bs.quote_color != blank %}--sg-quote-color: {{ bs.quote_color }};{% endif %}{% if bs.stats_color != blank %} --sg-stats-color: {{ bs.stats_color }};{% endif %}"
            {% endif %}
          >
            {%- if bs.quote != blank -%}
              <figure class="tdm-slide-gallery__quote">
                <blockquote class="tdm-slide-gallery__quote-text">{{ bs.quote | escape | newline_to_br }}</blockquote>
                {%- if bs.quote_author != blank or bs.quote_role != blank -%}
                  <figcaption class="tdm-slide-gallery__quote-author">
                    {%- if bs.quote_author != blank -%}
                      <span class="tdm-slide-gallery__quote-name">{{ bs.quote_author | escape }}</span>
                    {%- endif -%}
                    {%- if bs.quote_role != blank -%}
                      <span class="tdm-slide-gallery__quote-role">{{ bs.quote_role | escape }}</span>
                    {%- endif -%}
                  </figcaption>
                {%- endif -%}
              </figure>
            {%- endif -%}
            {%- if has_stats -%}
              <ul class="tdm-slide-gallery__stats" role="list">
                {%- for key in (1..6) -%}
                  {%- assign stat_key = 'stat_' | append: key -%}
                  {%- if bs[stat_key] != blank -%}
                    <li class="tdm-slide-gallery__stat">{{ bs[stat_key] | escape }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 and section.settings.auto_rotate == false -%}
    <div class="slideshow__controls slider-buttons">
      {{ slider_controls_inner }}
    </div>
  {%- endif -%}
</slideshow-component>

{%- if cta_below -%}
  <div class="slide-gallery-cta section-{{ section.id }}-cta-padding page-width slide-gallery-intro--{{ section.settings.intro_alignment }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {{ cta }}
  </div>
{%- endif -%}

{%- if section.settings.intro_position == 'bottom' -%}
  {{ intro }}
{%- endif -%}
</div>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Slide gallery",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "ID de ancla",
      "info": "Para enlazar a esta sección desde un botón. 1 o 2 palabras en español separadas por guion, ej. formulario o como-funciona. Enlace: /pages/aliados#formulario"
    },
    {
      "type": "color_scheme",
      "id": "intro_color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "Aplica a toda la sección: texto, galería y controles.",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Título y párrafo"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Texto pequeño arriba del título. La línea aparece solo si hay texto." },
    { "type": "color", "id": "rule_color", "label": "Color de la línea del eyebrow", "default": "#294E3F" },
    {
      "type": "inline_richtext",
      "id": "intro_title",
      "label": "Título",
      "default": "Título de la sección"
    },
    {
      "type": "select",
      "id": "intro_heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" },
        { "value": "hxl", "label": "t:sections.all.heading_size.options__4.label" },
        { "value": "hxxl", "label": "t:sections.all.heading_size.options__5.label" }
      ],
      "default": "h1",
      "label": "Tamaño del título"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Párrafo",
      "default": "<p>Escribe aquí una descripción breve que acompañe a la galería.</p>"
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Ver más",
      "info": "Deja vacío para ocultar el botón."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "button_position",
      "label": "Posición del botón",
      "options": [
        { "value": "with_text", "label": "Con el texto" },
        { "value": "below_gallery", "label": "Debajo de la galería" }
      ],
      "default": "with_text"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "label": "Usar estilo secundario",
      "default": false
    },
    {
      "type": "header",
      "content": "Diseño del texto"
    },
    {
      "type": "select",
      "id": "intro_alignment",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center",
      "label": "Alineación"
    },
    {
      "type": "select",
      "id": "intro_position",
      "options": [
        { "value": "top", "label": "Arriba de la galería" },
        { "value": "bottom", "label": "Abajo de la galería" }
      ],
      "default": "top",
      "label": "Posición"
    },
    {
      "type": "range",
      "id": "intro_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "intro_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 36
    },
    {
      "type": "header",
      "content": "Galería"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "full_bleed", "label": "Ancho completo" },
        { "value": "grid", "label": "Con padding" }
      ],
      "default": "grid",
      "label": "Diseño"
    },
    {
      "type": "paragraph",
      "content": "El radio y los paddings solo aplican con el diseño \"Con padding\"."
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Radio de las esquinas",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_x_desktop",
      "label": "Padding lateral (escritorio)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "Padding lateral (móvil)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "slide_height",
      "options": [
        { "value": "adapt_image", "label": "t:sections.slideshow.settings.slide_height.options__1.label" },
        { "value": "small", "label": "t:sections.slideshow.settings.slide_height.options__2.label" },
        { "value": "medium", "label": "t:sections.slideshow.settings.slide_height.options__3.label" },
        { "value": "large", "label": "t:sections.slideshow.settings.slide_height.options__4.label" },
        { "value": "ratio_2_1", "label": "Proporción 2:1" },
        { "value": "ratio_16_9", "label": "Proporción 16:9" }
      ],
      "default": "medium",
      "label": "t:sections.slideshow.settings.slide_height.label"
    },
    {
      "type": "select",
      "id": "mobile_ratio",
      "options": [
        { "value": "16_9", "label": "Rectángulo 16:9" },
        { "value": "3_2", "label": "Rectángulo 3:2" },
        { "value": "4_3", "label": "Rectángulo 4:3" }
      ],
      "default": "3_2",
      "label": "Proporción en móvil"
    },
    {
      "type": "select",
      "id": "slider_visual",
      "options": [
        { "value": "dots", "label": "t:sections.slideshow.settings.slider_visual.options__2.label" },
        { "value": "counter", "label": "t:sections.slideshow.settings.slider_visual.options__1.label" },
        { "value": "numbers", "label": "t:sections.slideshow.settings.slider_visual.options__3.label" }
      ],
      "default": "counter",
      "label": "t:sections.slideshow.settings.slider_visual.label"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.slideshow.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 2,
      "unit": "s",
      "label": "t:sections.slideshow.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        { "value": "none", "label": "t:sections.all.animation.image_behavior.options__1.label" },
        { "value": "ambient", "label": "t:sections.all.animation.image_behavior.options__2.label" }
      ],
      "default": "none",
      "label": "t:sections.all.animation.image_behavior.label"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.accessibility.content"
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "t:sections.slideshow.settings.accessibility.label",
      "info": "t:sections.slideshow.settings.accessibility.info",
      "default": "t:sections.slideshow.settings.accessibility.default"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 10,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen",
          "info": "Solo foto, sin texto. Recomendado: 2400 × 1200 px, con la persona en el 60% izquierdo y el lado del texto despejado."
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Color del overlay",
          "info": "Oscurece la foto y tiñe el bloque de texto para que se lea. Solo en escritorio (1200px o más), donde el texto va sobre la foto.",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Opacidad del overlay",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 30
        },
        {
          "type": "header",
          "content": "Testimonio"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Cita",
          "info": "Sin comillas: se agregan solas."
        },
        {
          "type": "text",
          "id": "quote_author",
          "label": "Quién lo dice"
        },
        {
          "type": "text",
          "id": "quote_role",
          "label": "Ocupación o cultivo",
          "info": "Va debajo del nombre, en cursiva. Ej: Productor - Aliado destacado."
        },
        {
          "type": "header",
          "content": "Datos"
        },
        {
          "type": "text",
          "id": "stat_1",
          "label": "Dato 1",
          "info": "Cada dato sale como viñeta. Ej: 300% de incremento en cosecha"
        },
        {
          "type": "text",
          "id": "stat_2",
          "label": "Dato 2",
          "info": "Ej: 30% en reducción de costos"
        },
        {
          "type": "text",
          "id": "stat_3",
          "label": "Dato 3",
          "info": "Ej: 12 tons de CO₂ mitigadas"
        },
        {
          "type": "text",
          "id": "stat_4",
          "label": "Dato 4",
          "info": "Opcional."
        },
        {
          "type": "text",
          "id": "stat_5",
          "label": "Dato 5",
          "info": "Opcional."
        },
        {
          "type": "text",
          "id": "stat_6",
          "label": "Dato 6",
          "info": "Opcional."
        },

        {
          "type": "header",
          "content": "Texto sobre la imagen"
        },
        {
          "type": "select",
          "id": "caption_position",
          "label": "Posición en escritorio",
