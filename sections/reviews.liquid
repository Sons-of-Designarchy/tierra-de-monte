{{ 'section-tdm-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tdm-reviews.js' | asset_url }}" defer="defer"></script>
{% render 'section-padding', id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}

{%- liquid
  assign root_classes = 'tdm-reviews'
  if section.settings.show_dividers
    assign root_classes = root_classes | append: ' tdm-reviews--dividers'
  endif

  assign title_variant = 'h2'
  case section.settings.heading_size
    when 'h1'
      assign title_variant = 'h1'
    when 'h0' or 'hxl' or 'hxxl'
      assign title_variant = 'display'
  endcase
  assign divider = section.settings.divider_color | default: '#000000'
-%}

<section
  class="{{ root_classes }}"
  style="--reviews-radius: {{ section.settings.radius }}px; --reviews-gap: {{ section.settings.gap }}px; --avatar-size: {{ section.settings.avatar_size }}px; --reviews-divider: {{ divider }};"
>
  <div class="section-{{ section.id }}-padding isolate">
    <div class="reviews__card color-{{ section.settings.color_scheme }} gradient">
      {% if section.settings.title != blank %}
        {% render 'typography', text: section.settings.title, variant: title_variant, as: 'h2', font: 'display', weight: 'medium', align: 'center', class: 'reviews__title' %}
      {% endif %}

      <tdm-reviews class="reviews__viewport">
        <ul class="reviews__track" role="list" aria-live="polite">
          {%- for block in section.blocks -%}
            <li
              class="review"
              {{ block.shopify_attributes }}
              data-index="{{ forloop.index0 }}"
              tabindex="0"
              aria-label="Testimonio {{ forloop.index }}"
            >
              <div class="review__inner">
                {%- if block.settings.image != blank -%}
                  {%- assign avatar_src = block.settings.image | image_url: width: 320 -%}
                  {% render 'avatar', name: block.settings.name, src: avatar_src, size: 'lg', class: 'review__avatar' %}
                {%- endif -%}
                {%- if block.settings.rating > 0 -%}
                  {% render 'rating', value: block.settings.rating, size: 'md' %}
                {%- endif -%}
                {%- if block.settings.quote != blank -%}
                  {%- capture quote_text -%}“{{ block.settings.quote | escape }}”{%- endcapture -%}
                  {% render 'typography', text: quote_text, as: 'blockquote', variant: 'h5', font: 'display', align: 'balance', class: 'review__quote' %}
                {%- endif -%}
                {%- if block.settings.name != blank -%}
                  {%- assign review_name = block.settings.name | escape -%}
                  {% render 'typography', text: review_name, variant: 'body-sm', weight: 'semibold', class: 'review__author' %}
                {%- endif -%}
                {%- if block.settings.company != blank -%}
                  {%- assign review_company = block.settings.company | escape -%}
                  {% render 'typography', text: review_company, variant: 'xs', color: 'secondary', class: 'review__company' %}
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>

        <div class="reviews__nav">
          {% render 'icon-button', icon: 'arrow-left', label: 'Anterior', variant: 'ghost', class: 'reviews__btn reviews__btn--prev' %}
          {% render 'icon-button', icon: 'arrow-right', label: 'Siguiente', variant: 'ghost', class: 'reviews__btn reviews__btn--next' %}
        </div>
      </tdm-reviews>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Reviews" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h2",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h1", "label": "H1" },
        { "value": "h0", "label": "H0" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "range",
      "id": "radius",
      "label": "Card corner radius (px)",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between reviews (px)",
      "min": 8,
      "max": 48,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "avatar_size",
      "label": "Avatar size (px)",
      "min": 48,
      "max": 140,
      "step": 4,
      "default": 96
    },
    { "type": "checkbox", "id": "show_dividers", "label": "Subtle vertical lines on wide screens", "default": false },
    { "type": "color", "id": "divider_color", "label": "Divider color", "default": "#000000" },
    { "type": "header", "content": "Section padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Avatar" },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote / Description",
          "default": "Tierra de monte logró que nuestra producción se salvara de la peor plaga que podíamos imaginar en esta temporada."
        },
        { "type": "text", "id": "name", "label": "Name", "default": "Silverio Pliego D." },
        { "type": "text", "id": "company", "label": "Company", "default": "Huerta Cuauhtémoc" },
        { "type": "range", "id": "rating", "label": "Stars", "info": "0 hides the stars.", "min": 0, "max": 5, "step": 1, "default": 0 }
      ]
    }
  ],
  "presets": [{ "name": "Reviews", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
