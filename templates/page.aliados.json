    "collapsible_content_wp3zF8": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_GDzrXr": {
          "type": "collapsible_row",
          "settings": {
            "heading": "¿Los $5,000 son cuota de inscripción?",
            "icon": "none",
            "row_content": "<p>No. Son $5,000 en producto que te llega a tu bodega. No cobramos por entrar.</p>",
            "page": ""
          }
        },
        "collapsible_row_AKwAGA": {
          "type": "collapsible_row",
          "settings": {
            "heading": "¿Tengo que dejar de vender lo que ya vendo?",
            "icon": "none",
            "row_content": "<p>No. Sigues con tus marcas y le sumas la nuestra. Nadie te pide que cambies tu negocio.</p>",
            "page": ""
          }
        },
        "collapsible_row_bdnEWF": {
          "type": "collapsible_row",
          "settings": {
            "heading": "¿Y si un bimestre no llego al mínimo?",
            "icon": "none",
            "row_content": "<p>No pasa nada, sigues siendo Aliado. Ese bimestre operas con los beneficios del nivel que sí alcanzaste y luego vuelves a subir.</p>",
            "page": ""
          }
        },
        "collapsible_row_9nErwx": {
          "type": "collapsible_row",
          "settings": {
            "heading": "¿Cómo funciona lo de mis clientes?",
            "icon": "none",
            "row_content": "<p>No le vendemos a tus clientes ni los buscamos por nuestra cuenta. Si alguno nos escribe, lo mandamos contigo.</p>",
            "page": ""
          }
        },
        "collapsible_row_BpRhfh": {
          "type": "collapsible_row",
          "settings": {
            "heading": "¿Para qué quieren mi identificación?",
            "icon": "none",
            "row_content": "<p>Para saber con quién estamos trabajando. Es lo que nos permite proteger a tus clientes a tu nombre y que nadie más de la red te los toque.</p>",
            "page": ""
          }
        },
        "collapsible_row_MnDPgR": {
          "type": "collapsible_row",
          "settings": {
            "heading": "¿Tengo que haber usado sus productos antes?",
            "icon": "none",
            "row_content": "<p>No. Muchos Aliados llegan porque ya los probaron en su tierra, y es el mejor camino. Pero si vienes recomendado o ya tienes clientes que confían en ti, también entras.</p>",
            "page": ""
          }
        }
      },
