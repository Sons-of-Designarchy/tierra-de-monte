          "type": "collapsible_row",
          "settings": {
            "heading": "¿Los $5,000 son cuota de inscripción?",
            "icon": "check_mark",
            "row_content": "<p>No. Son $5,000 en producto que te llega a tu bodega. No cobramos por entrar.</p>",
            "page": ""
          }
        },
        "collapsible_row_AKwAGA": {
          "type": "collapsible_row",
          "settings": {
            "heading": "¿Tengo que dejar de vender lo que ya vendo?",
            "icon": "check_mark",
            "row_content": "<p>No. Sigues con tus marcas y le sumas la nuestra. Nadie te pide que cambies tu negocio.</p>",
            "page": ""
          }
        },
        "collapsible_row_bdnEWF": {
          "type": "collapsible_row",
          "settings": {
            "heading": "¿Y si un bimestre no llego al mínimo?",
            "icon": "check_mark",
            "row_content": "<p>No pasa nada, sigues siendo aliado. Ese bimestre operas con los beneficios del nivel que sí alcanzaste y luego vuelves a subir.</p>",
            "page": ""
          }
        },
        "collapsible_row_HEgaXb": {
