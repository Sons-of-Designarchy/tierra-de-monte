        },
        "collapsible_row_9nErwx": {
          "type": "collapsible_row",
          "settings": {
            "heading": "¿Cómo funciona lo de mis clientes?",
            "icon": "check_mark",
            "row_content": "<p>No le vendemos a tus clientes ni los buscamos por nuestra cuenta. Si alguno nos escribe, lo mandamos contigo.</p>",
            "page": ""
          }
        },
        "collapsible_row_BpRhfh": {
          "type": "collapsible_row",
          "settings": {
            "heading": "¿Para qué quieren mi identificación?",
            "icon": "check_mark",
            "row_content": "<p>Para saber con quién estamos trabajando. Es lo que nos permite proteger a tus clientes a tu nombre y que nadie más de la red te los toque.</p>",
            "page": ""
          }
        },
        "collapsible_row_MnDPgR": {
          "type": "collapsible_row",
          "settings": {
            "heading": "¿Tengo que haber usado sus productos antes?",
