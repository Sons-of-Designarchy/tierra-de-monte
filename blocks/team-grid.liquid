{%- comment -%}
  Team grid — eyebrow + a grid of team-member blocks.
  Replaces the generated ai_gen_block_8f6d7f6 block (50 hardcoded member slots).
  Styles: assets/block-tdm-team.css
{%- endcomment -%}

{{ 'block-tdm-team.css' | asset_url | stylesheet_tag }}
{% render 'section-padding', id: block.id, top: block.settings.padding_top, bottom: block.settings.padding_bottom %}

<div
  class="tdm-team color-{{ block.settings.color_scheme }} gradient tdm-team--align-{{ block.settings.text_alignment | default: 'left' }}"
  style="--tdm-rule: {{ block.settings.rule_color | default: 'currentColor' }}; --cols-mobile: {{ block.settings.columns_mobile | default: 2 }}; --cols-desktop: {{ block.settings.columns_desktop | default: 5 }}; --team-gap: {{ block.settings.gap | default: 10 }}px;"
  {{ block.shopify_attributes }}
>
  <div class="page-width section-{{ block.id }}-padding">
    {%- if block.settings.pretitle != blank -%}
      <div class="tdm-eyebrow">
        {{ block.settings.pretitle }}
        {%- if block.settings.show_rule -%}
          <div class="tdm-eyebrow__rule" aria-hidden="true"></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="tdm-team__grid">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Team grid",
  "tag": "div",
  "blocks": [{ "type": "team-member" }],
  "settings": [
    { "type": "inline_richtext", "id": "pretitle", "label": "Eyebrow", "default": "Conoce a nuestro equipo" },
    { "type": "checkbox", "id": "show_rule", "label": "Show rule under eyebrow", "default": true },
    { "type": "color", "id": "rule_color", "label": "Rule color", "default": "#294E3F" },

    { "type": "header", "content": "Grid" },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2",
      "label": "Columns on mobile"
    },
    { "type": "range", "id": "gap", "min": 4, "max": 48, "step": 2, "unit": "px", "default": 10, "label": "Gap" },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },

    { "type": "header", "content": "Section" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Team grid",
      "blocks": [{ "type": "team-member" }, { "type": "team-member" }, { "type": "team-member" }, { "type": "team-member" }]
    }
  ]
}
{% endschema %}
